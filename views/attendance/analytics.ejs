<%- include('../partials/header') %>

<div class="dashboard-container">
    <%- include('../partials/sidebar') %>
    <main class="main-content attendance-analytics-page attendance-analytics">
        <header class="analytics-heading">
            <div>
                <a href="/attendance" class="analytics-back"><i class="bi bi-arrow-left"></i> Attendance</a>
                <h1>Attendance Analytics</h1>
                <p>Review attendance performance, compare classes, and identify students who may need follow-up.</p>
            </div>
        </header>

        <% if (error) { %>
        <div class="alert alert-warning" role="alert"><%= error %></div>
        <% } %>

        <section class="card analytics-panel" aria-labelledby="analytics-filters-title">
            <h2 id="analytics-filters-title" class="h5">Report filters</h2>
            <p class="analytics-section-note">Choose an academic section, session, term, and optionally one class. The report refreshes when a selection changes.</p>
            <% if (sections && sections.length && periods && periods.length) { %>
            <form action="/attendance/analytics" method="GET" class="analytics-filter-grid">
                <div class="form-group">
                    <label for="analytics-section">Section</label>
                    <select id="analytics-section" name="section_id" class="form-control" required onchange="this.form.class_id.value='';this.form.session.value='';this.form.term.value='';this.form.submit()">
                        <% sections.forEach(section => { %>
                        <option value="<%= section.id %>" <%= String(filters.section_id) === String(section.id) ? 'selected' : '' %>><%= section.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="analytics-session">Session</label>
                    <select id="analytics-session" name="session" class="form-control" required onchange="this.form.term.value='';this.form.submit()">
                        <% Array.from(new Set(periods.map(period => period.session))).forEach(session => { %>
                        <option value="<%= session %>" <%= filters.session === session ? 'selected' : '' %>><%= session %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="analytics-term">Term</label>
                    <select id="analytics-term" name="term" class="form-control" required onchange="this.form.submit()">
                        <% periods.filter(period => period.session === filters.session).forEach(period => { %>
                        <option value="<%= period.term %>" <%= filters.term === period.term ? 'selected' : '' %>><%= period.term %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="analytics-class">Class</label>
                    <select id="analytics-class" name="class_id" class="form-control" onchange="this.form.submit()">
                        <option value="">All accessible classes</option>
                        <% classes.forEach(clazz => { %>
                        <option value="<%= clazz.id %>" <%= String(filters.class_id) === String(clazz.id) ? 'selected' : '' %>><%= clazz.name %></option>
                        <% }); %>
                    </select>
                </div>
            </form>
            <% } else { %>
            <p class="analytics-empty">There is no academic period available for this section yet, so attendance analytics cannot be displayed.</p>
            <% } %>
        </section>

        <% if (dashboard) { %>
        <div class="analytics-context" aria-label="Current report context">
            <span class="analytics-context-item"><i class="bi bi-building"></i> <%= sections.find(section => String(section.id) === String(filters.section_id))?.name || 'Selected section' %></span>
            <span class="analytics-context-item"><i class="bi bi-calendar3"></i> <%= filters.session %> · <%= filters.term %></span>
            <span class="analytics-context-item"><i class="bi bi-calendar-range"></i> <%= dashboard.filters.startDate && dashboard.filters.endDate ? dashboard.filters.startDate + ' to ' + dashboard.filters.endDate : 'Academic period dates unavailable' %></span>
            <span class="analytics-context-item"><i class="bi bi-people"></i> <%= filters.class_id ? (classes.find(clazz => String(clazz.id) === String(filters.class_id))?.name || 'Selected class') : 'All accessible classes' %></span>
        </div>

        <%
            const overview = dashboard.overview;
            const markedStudentDays = Number(overview.totalStudentDays) || 0;
            const presentWidth = markedStudentDays ? (Number(overview.presentDays) / markedStudentDays) * 100 : 0;
            const lateWidth = markedStudentDays ? (Number(overview.lateArrivals) / markedStudentDays) * 100 : 0;
            const absentWidth = markedStudentDays ? (Number(overview.absences) / markedStudentDays) * 100 : 0;
            const leaveWidth = markedStudentDays ? (Number(overview.leaveDays) / markedStudentDays) * 100 : 0;
        %>
        <section class="analytics-summary" aria-label="Attendance overview">
            <div class="card analytics-metric">
                <div class="analytics-metric-label">Attendance rate</div>
                <div class="analytics-metric-value"><%= overview.attendanceRate === null ? '—' : overview.attendanceRate + '%' %></div>
                <div class="analytics-metric-note">Based on <%= overview.totalStudentDays %> marked student-days</div>
                <div class="analytics-rate-track" role="img" aria-label="Attendance rate <%= overview.attendanceRate === null ? 'not available' : overview.attendanceRate + ' percent' %>">
                    <div class="analytics-rate-fill" style="width:<%= overview.attendanceRate === null ? 0 : overview.attendanceRate %>%;"></div>
                </div>
            </div>
            <div class="card analytics-metric">
                <div class="analytics-metric-label">Students tracked</div>
                <div class="analytics-metric-value"><%= overview.studentsTracked %></div>
                <div class="analytics-metric-note">Students with attendance records in this selection</div>
            </div>
            <div class="card analytics-metric">
                <div class="analytics-metric-label">Low-attendance students</div>
                <div class="analytics-metric-value"><%= overview.lowAttendanceCount %></div>
                <div class="analytics-metric-note">Below their configured class threshold</div>
            </div>
            <div class="card analytics-metric">
                <div class="analytics-metric-label">Late arrivals</div>
                <div class="analytics-metric-value"><%= overview.lateArrivals %></div>
                <div class="analytics-metric-note">Late marks in this period</div>
            </div>
            <div class="card analytics-metric">
                <div class="analytics-metric-label">Absences</div>
                <div class="analytics-metric-value"><%= overview.absences %></div>
                <div class="analytics-metric-note">Recorded absent student-days</div>
            </div>
            <div class="card analytics-metric">
                <div class="analytics-metric-label">Leave days</div>
                <div class="analytics-metric-value"><%= overview.leaveDays %></div>
                <div class="analytics-metric-note">Recorded leave student-days</div>
            </div>
        </section>

        <section class="card analytics-panel" aria-labelledby="analytics-breakdown-title">
            <h2 id="analytics-breakdown-title" class="h5">Attendance record breakdown</h2>
            <p class="analytics-section-note">Present, Late, and Leave count as attended. Absent does not. This rate uses recorded student-days only; it is not a measure of expected registers.</p>
            <% if (markedStudentDays > 0) { %>
            <div class="analytics-breakdown-bar" role="img" aria-label="Recorded attendance statuses: <%= overview.presentDays %> present, <%= overview.lateArrivals %> late, <%= overview.absences %> absent, <%= overview.leaveDays %> leave.">
                <% if (presentWidth > 0) { %><span class="analytics-breakdown-segment analytics-breakdown-present" style="width:<%= presentWidth %>%;"></span><% } %>
                <% if (lateWidth > 0) { %><span class="analytics-breakdown-segment analytics-breakdown-late" style="width:<%= lateWidth %>%;"></span><% } %>
                <% if (absentWidth > 0) { %><span class="analytics-breakdown-segment analytics-breakdown-absent" style="width:<%= absentWidth %>%;"></span><% } %>
                <% if (leaveWidth > 0) { %><span class="analytics-breakdown-segment analytics-breakdown-leave" style="width:<%= leaveWidth %>%;"></span><% } %>
            </div>
            <div class="analytics-legend">
                <span class="analytics-legend-item"><span class="analytics-legend-dot analytics-breakdown-present"></span>Present <strong><%= overview.presentDays %></strong></span>
                <span class="analytics-legend-item"><span class="analytics-legend-dot analytics-breakdown-late"></span>Late <strong><%= overview.lateArrivals %></strong></span>
                <span class="analytics-legend-item"><span class="analytics-legend-dot analytics-breakdown-absent"></span>Absent <strong><%= overview.absences %></strong></span>
                <span class="analytics-legend-item"><span class="analytics-legend-dot analytics-breakdown-leave"></span>Leave <strong><%= overview.leaveDays %></strong></span>
            </div>
            <% } else { %>
            <p class="analytics-empty">No attendance records have been recorded for this academic period and selection.</p>
            <% } %>
        </section>

        <section class="card analytics-panel" aria-labelledby="analytics-class-title">
            <h2 id="analytics-class-title" class="h5">Class comparison</h2>
            <p class="analytics-section-note">Compare attendance rates and low-attendance counts across the selected section.</p>
            <% if (dashboard.classComparison.length) { %>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Class</th><th>Attendance rate</th><th>Students tracked</th><th>Student-days</th><th>Low attendance</th><th>Threshold</th></tr></thead>
                    <tbody>
                    <% dashboard.classComparison.forEach(item => { %>
                        <tr>
                            <td><strong><%= item.className %></strong></td>
                            <td class="analytics-table-rate">
                                <strong><%= item.attendanceRate === null ? '—' : item.attendanceRate + '%' %></strong>
                                <div class="analytics-rate-track" role="img" aria-label="Class attendance rate <%= item.attendanceRate === null ? 'not available' : item.attendanceRate + ' percent' %>">
                                    <div class="analytics-rate-fill" style="width:<%= item.attendanceRate === null ? 0 : item.attendanceRate %>%;"></div>
                                </div>
                            </td>
                            <td><%= item.studentsTracked %></td>
                            <td><%= item.totalStudentDays %></td>
                            <td><%= item.lowAttendanceCount %></td>
                            <td><%= item.threshold === null ? 'Not configured' : item.threshold + '%' %></td>
                        </tr>
                    <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %><p class="analytics-empty">No class data is available for this selection.</p><% } %>
        </section>

        <section class="card analytics-panel" aria-labelledby="analytics-daily-title">
            <h2 id="analytics-daily-title" class="h5">Daily attendance trend</h2>
            <p class="analytics-section-note">Only dates with saved attendance records appear here.</p>
            <% if (dashboard.dailySummary.length) { %>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Date</th><th>Attendance rate</th><th>Student-days</th><th>Present</th><th>Late</th><th>Absent</th><th>Leave</th></tr></thead>
                    <tbody>
                    <% dashboard.dailySummary.forEach(day => { %>
                        <tr>
                            <td><strong><%= day.date %></strong></td>
                            <td class="analytics-table-rate">
                                <strong><%= day.attendanceRate === null ? '—' : day.attendanceRate + '%' %></strong>
                                <div class="analytics-rate-track" role="img" aria-label="Daily attendance rate <%= day.attendanceRate === null ? 'not available' : day.attendanceRate + ' percent' %>">
                                    <div class="analytics-rate-fill" style="width:<%= day.attendanceRate === null ? 0 : day.attendanceRate %>%;"></div>
                                </div>
                            </td>
                            <td><%= day.totalStudentDays %></td>
                            <td><%= day.present %></td>
                            <td><%= day.late %></td>
                            <td><%= day.absent %></td>
                            <td><%= day.leave %></td>
                        </tr>
                    <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %><p class="analytics-empty">No attendance records have been recorded for this academic period and selection.</p><% } %>
        </section>

        <section class="card analytics-panel" aria-labelledby="analytics-low-title">
            <h2 id="analytics-low-title" class="h5">Students below attendance threshold</h2>
            <p class="analytics-section-note">These students are below the configured threshold for their class. Review their records and follow up where necessary.</p>
            <% if (dashboard.lowAttendanceStudents.length) { %>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Student</th><th>Class</th><th>Attendance</th><th>Threshold</th><th>Attended days</th><th>Absent</th><th>Late</th></tr></thead>
                    <tbody>
                    <% dashboard.lowAttendanceStudents.forEach(student => { %>
                        <tr>
                            <td><strong><%= student.studentName %></strong></td>
                            <td><%= student.className %></td>
                            <td><span class="analytics-low-rate"><%= student.attendanceRate %>%</span></td>
                            <td><%= student.threshold %>%</td>
                            <td><%= student.attendedDays %> / <%= student.totalDays %></td>
                            <td><%= student.absent %></td>
                            <td><%= student.late %></td>
                        </tr>
                    <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %><p class="analytics-empty">No students are below their configured class threshold in this selection.</p><% } %>
        </section>

        <section class="card analytics-panel" aria-labelledby="analytics-late-title">
            <h2 id="analytics-late-title" class="h5">Students with most late arrivals</h2>
            <p class="analytics-section-note">Top students by number of late marks in the selected academic period.</p>
            <% if (dashboard.topLateStudents.length) { %>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Student</th><th>Class</th><th>Late marks</th></tr></thead>
                    <tbody>
                    <% dashboard.topLateStudents.forEach(student => { %>
                        <tr><td><strong><%= student.studentName %></strong></td><td><%= student.className %></td><td><strong><%= student.late %></strong></td></tr>
                    <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %><p class="analytics-empty">No late marks were recorded in this academic period.</p><% } %>
        </section>
        <% } %>
    </main>
</div>
<%- include('../partials/footer') %>
