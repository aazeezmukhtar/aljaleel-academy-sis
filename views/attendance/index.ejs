<%- include('../partials/header') %>

    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>

            <main class="main-content">
                <header class="content-header" style="margin-bottom: 30px;">
                    <div>
                        <h1>Attendance Management</h1>
                        <p>Track daily student attendance and regularity.</p>
                    </div>
                    <a href="/attendance/report" class="btn btn-outline">View Reports</a>
                </header>

                <section class="grid-2" style="margin-bottom: 25px;">
                    <div class="card">
                        <h3>Take Student Attendance</h3>
                        <p style="margin-bottom: 20px; color: var(--text-muted);">Select a class and date to start
                            marking attendance.</p>

                        <form action="/attendance/take" method="GET" class="enroll-form">
                            <div class="form-group">
                                <label>Select Class</label>
                                <% if (typeof classes !== 'undefined' && classes && classes.length > 0) { %>
                                <select name="class_id" required class="form-control">
                                    <option value="">-- Choose Class --</option>
                                    <% classes.forEach(c=> { %>
                                        <option value="<%= c.id %>">
                                            <%= c.name %>
                                        </option>
                                        <% }); %>
                                </select>
                                <% } else { %>
                                <div class="emp-state" style="padding: 10px; border: 1px dashed #ef4444; color: #ef4444; border-radius: 8px;">
                                    <i class="bi bi-exclamation-triangle"></i> No classes assigned to you.
                                </div>
                                <% } %>
                            </div>
                            <div class="form-group">
                                <label>Date</label>
                                <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>"
                                    required class="form-control">
                            </div>
                            <button type="submit" class="btn" style="width: 100%; margin-top: 10px;">Start
                                Marking</button>
                        </form>
                    </div>

                    <div class="card" style="background: linear-gradient(135deg, #4f46e5, #4338ca); color: white;">
                        <h3>Staff Attendance</h3>
                        <p style="margin-top: 10px; opacity: 0.9;">Manage attendance for teachers and staff members.</p>
                        <div style="margin-top: 40px;">
                            <a href="/attendance/staff" class="btn"
                                style="background: white; color: var(--primary); width: 100%;">
                                <i class="bi bi-calendar2-check-fill"></i> Go to Staff Attendance
                            </a>
                        </div>
                        <div style="margin-top: 20px; text-align: center; font-size: 0.85rem; opacity: 0.8;">
                            Includes Present, Absent, Late, and Leave statuses.
                        </div>
                    </div>
                </section>

                <!-- Flagged / At-Risk Students Section -->
                <% if (typeof flaggedStudents !== 'undefined' && flaggedStudents && Object.keys(flaggedStudents).length > 0) { %>
                <section class="card" style="border-top: 4px solid #ef4444; margin-top: 10px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                        <div>
                            <h3 style="color: #dc2626; margin: 0; display: flex; align-items: center; gap: 8px;">
                                <i class="bi bi-exclamation-triangle-fill"></i> At-Risk & Flagged Students
                            </h3>
                            <p style="color: var(--text-muted); margin: 4px 0 0 0; font-size: 0.9rem;">
                                Students exceeding term absence limit (<%= termAbsenceLimit || 10 %> days) or consecutive absence limit (<%= consecutiveAbsenceLimit || 3 %> days).
                            </p>
                        </div>
                    </div>

                    <% Object.values(flaggedStudents).forEach(group => { %>
                        <div style="margin-bottom: 20px; background: #fef2f2; border: 1px solid #fee2e2; border-radius: 10px; padding: 15px;">
                            <h4 style="margin: 0 0 10px 0; color: #991b1b; display: flex; align-items: center; gap: 6px;">
                                <i class="bi bi-door-open-fill"></i> <%= group.class.name %>
                            </h4>
                            <div class="table-container mobile-cards">
                                <table class="data-table" style="background: white;">
                                    <thead>
                                        <tr>
                                            <th>Student Name</th>
                                            <th>Parent Contact</th>
                                            <th style="text-align: center;">Total Absences</th>
                                            <th style="text-align: center;">Consecutive Streak</th>
                                            <th>Flag Reason(s)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% group.students.forEach(st => { %>
                                            <tr>
                                                <td data-label="Student Name">
                                                    <strong style="color: #1e293b;"><%= st.first_name %> <%= st.last_name %></strong>
                                                </td>
                                                <td data-label="Parent Contact">
                                                    <% if (st.parent_phone) { %>
                                                        <a href="tel:<%= st.parent_phone %>" style="color: #2563eb; text-decoration: none;">
                                                            <i class="bi bi-telephone-fill"></i> <%= st.parent_phone %>
                                                        </a>
                                                    <% } else { %>
                                                        <span class="text-muted">N/A</span>
                                                    <% } %>
                                                </td>
                                                <td data-label="Total Absences" style="text-align: center;">
                                                    <span style="font-weight: 700; color: #dc2626;"><%= st.total_absent_days %> days</span>
                                                </td>
                                                <td data-label="Consecutive Streak" style="text-align: center;">
                                                    <span style="font-weight: 700; color: #d97706;"><%= st.consecutive_absent_days %> days</span>
                                                </td>
                                                <td data-label="Flag Reason(s)">
                                                    <% st.flag_reason.forEach(reason => { %>
                                                        <span class="badge" style="background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; font-size: 0.75rem; margin-right: 4px;">
                                                            <%= reason %>
                                                        </span>
                                                    <% }); %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <% }); %>
                </section>
                <% } %>
            </main>
    </div>

    <%- include('../partials/footer') %>