<%- include('../partials/header') %>

    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>

            <main class="main-content">
                <header class="content-header attendance-page-header">
                    <div>
                        <h1>Attendance Management</h1>
                        <p>Track daily student attendance and regularity.</p>
                    </div>
                    <% if (typeof user !== 'undefined' && user && user.role === 'Admin') { %>
                    <a href="/attendance/tracking" class="btn btn-primary"><i class="bi bi-clipboard2-check"></i> Daily Tracking</a>
                    <% } %>
                    <a href="/attendance/analytics" class="btn btn-outline"><i class="bi bi-graph-up"></i> Attendance Analytics</a>
                    <a href="/attendance/report" class="btn btn-outline">View Reports</a>
                </header>

                <section class="attendance-launch-grid <%= (typeof user !== 'undefined' && user && user.role === 'Admin') ? 'grid-2' : '' %>">
                    <div class="card attendance-launch-card">
                        <h3>Take Student Attendance</h3>
                        <p class="attendance-launch-description">Choose the class and date you want to record.</p>

                        <form id="attendance-selection-form" action="/attendance/take" method="GET" class="enroll-form attendance-launch-form">
                            <div class="form-group">
                                <label>Select Class</label>
                                <% if (typeof classes !== 'undefined' && classes && classes.length > 0) { %>
                                <select name="class_id" required class="form-control">
                                    <option value="">-- Choose Class --</option>
                                    <% classes.forEach(c=> { %>
                                        <option value="<%= c.id %>">
                                            <%= c.name %>
                                        </option>
                                        <% }); %>
                                </select>
                                <% } else { %>
                                <div class="emp-state" style="padding: 10px; border: 1px dashed #ef4444; color: #ef4444; border-radius: 8px;">
                                    <i class="bi bi-exclamation-triangle"></i> No classes assigned to you.
                                </div>
                                <% } %>
                            </div>
                            <div class="form-group">
                                <label>Date</label>
                                <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>"
                                    required class="form-control">
                            </div>
                            <button type="submit" class="btn attendance-start-button">Start Marking</button>
                            <button type="button" class="btn btn-outline attendance-previous-button" onclick="viewPreviousAttendance()">
                                <i class="bi bi-clock-history"></i> View Previous Day's Attendance
                            </button>
                            <p class="text-muted attendance-previous-help">
                                Opens yesterday's attendance for the selected class.
                            </p>
                        </form>
                        <p id="attendance-offline-prep-status" class="attendance-offline-status" role="status" aria-live="polite">Offline attendance preparation will be checked while you are online.</p>
                    </div>

                    <% if (typeof user !== 'undefined' && user && user.role === 'Admin') { %>
                    <div class="card attendance-staff-card">
                        <h3>Staff Attendance</h3>
                        <p class="attendance-staff-description">Manage attendance for teachers and staff members.</p>
                        <div class="attendance-staff-action">
                            <a href="/attendance/staff" class="btn attendance-staff-link">
                                <i class="bi bi-calendar2-check-fill"></i> Go to Staff Attendance
                            </a>
                        </div>
                        <div class="attendance-staff-note">
                            Includes Present, Absent, Late, and Leave statuses.
                        </div>
                    </div>
                    <% } %>
                </section>

                <!-- Flagged / At-Risk Students Section -->
                <% if (typeof attendanceGroups !== 'undefined' && attendanceGroups && attendanceGroups.length > 0) { %>
                <%
                    const flaggedGroups = attendanceGroups;
                    const flaggedTotal = flaggedGroups.reduce((total, group) => total + group.students.length, 0);
                    const affectedClassCount = flaggedGroups.filter(group => group.students.length > 0).length;
                %>
                <section class="card attendance-risk-section">
                    <div class="attendance-risk-heading">
                        <div>
                            <h3><i class="bi bi-exclamation-triangle-fill"></i> Attendance alerts</h3>
                            <p>Students who have reached an attendance warning threshold.</p>
                        </div>
                        <span class="attendance-risk-total"><%= flaggedTotal %> flagged</span>
                    </div>

                    <div class="attendance-risk-overview">
                        <div class="attendance-risk-stat">
                            <strong><%= flaggedTotal %></strong>
                            <span>Flagged students</span>
                        </div>
                        <div class="attendance-risk-stat">
                            <strong><%= affectedClassCount %></strong>
                            <span>Classes with alerts</span>
                        </div>
                    </div>

                    <p class="attendance-risk-guidance">
                        Alerts are based on <strong><%= termAbsenceLimit || 10 %> total absences</strong>
                        or <strong><%= consecutiveAbsenceLimit || 3 %> consecutive absences</strong>.
                        A student may meet both conditions.
                    </p>

                    <div class="attendance-risk-filter" role="group" aria-label="Filter attendance alerts by section">
                        <button type="button" class="attendance-risk-filter-button active" data-section-filter="all" aria-pressed="true">All sections</button>
                        <% attendanceSections.forEach(sectionName => { %>
                        <button type="button" class="attendance-risk-filter-button" data-section-filter="<%= sectionName %>" aria-pressed="false"><%= sectionName %></button>
                        <% }); %>
                    </div>
                    <p class="attendance-risk-filter-empty" hidden>No flagged classes in this section.</p>
                    <div class="attendance-risk-groups">
                        <% flaggedGroups.forEach((group, groupIndex) => { %>
                        <details class="attendance-risk-class" data-section-name="<%= group.section_name %>" <%= groupIndex === 0 ? 'open' : '' %>>
                            <summary>
                                <span class="attendance-risk-class-name">
                                    <i class="bi bi-door-open-fill"></i>
                                    <span><%= group.class.name %><small style="display:block;font-weight:500;color:var(--text-muted);font-size:.75rem;"><%= group.section_name %></small></span>
                                </span>
                                <span class="attendance-risk-class-meta">
                                    <span class="attendance-risk-class-count"><%= group.students.length %> flagged</span>
                                    <i class="bi bi-chevron-down attendance-risk-chevron"></i>
                                </span>
                            </summary>

                            <% if (!group.hasAcademicContext) { %>
                            <p class="attendance-risk-guidance" style="padding:12px;margin:0;">Attendance alerts cannot be calculated because this class's section has no complete current session and term configured.</p>
                            <% } else if (group.students.length === 0) { %>
                            <p class="attendance-risk-guidance" style="padding:12px;margin:0;">No students in this class currently meet the attendance warning thresholds.</p>
                            <% } else { %>
                            <!-- Desktop: retain the detailed table -->
                            <div class="attendance-risk-desktop">
                                <div class="table-container">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>Student Name</th>
                                                <th>Parent Contact</th>
                                                <th style="text-align:center;">Total Absences</th>
                                                <th style="text-align:center;">Consecutive Streak</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% group.students.forEach(st => { %>
                                            <tr>
                                                <td><strong><%= st.first_name %> <%= st.last_name %></strong></td>
                                                <td>
                                                    <div class="attendance-risk-contact">
                                                        <% if (st.has_valid_whatsapp && st.whatsapp_url) { %>
                                                        <a class="attendance-risk-contact-icon whatsapp" href="<%= st.whatsapp_url %>" target="_blank" rel="noopener noreferrer" aria-label="Message <%= st.first_name %>'s parent on WhatsApp" title="WhatsApp">
                                                            <i class="bi bi-whatsapp"></i>
                                                        </a>
                                                        <% } %>
                                                        <% if (st.parent_phone) { %>
                                                        <a class="attendance-risk-contact-icon phone" href="tel:<%= st.parent_phone %>" aria-label="Call <%= st.first_name %>'s parent" title="Call parent">
                                                            <i class="bi bi-telephone-fill"></i>
                                                        </a>
                                                        <% } else { %>
                                                        <span class="text-muted" title="No parent contact available">No contact</span>
                                                        <% } %>
                                                    </div>
                                                </td>
                                                <td style="text-align:center;"><strong class="attendance-risk-absence"><%= st.total_absent_days %> days</strong></td>
                                                <td style="text-align:center;">
                                                    <% if (st.current_consecutive_absent_days === 0) { %>
                                                    <span class="attendance-risk-broken">0 days · Broken</span>
                                                    <% } else { %>
                                                    <strong class="attendance-risk-streak"><%= st.current_consecutive_absent_days %> days</strong>
                                                    <% } %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Mobile: purpose-built student cards -->
                            <div class="attendance-risk-mobile">
                                <% group.students.forEach(st => { %>
                                <article class="attendance-risk-student">
                                    <div class="attendance-risk-student-top">
                                        <strong class="attendance-risk-student-name"><%= st.first_name %> <%= st.last_name %></strong>
                                        <div class="attendance-risk-contact">
                                            <% if (st.has_valid_whatsapp && st.whatsapp_url) { %>
                                            <a class="attendance-risk-contact-icon whatsapp" href="<%= st.whatsapp_url %>" target="_blank" rel="noopener noreferrer" aria-label="Message <%= st.first_name %>'s parent on WhatsApp" title="WhatsApp">
                                                <i class="bi bi-whatsapp"></i>
                                            </a>
                                            <% } %>
                                            <% if (st.parent_phone) { %>
                                            <a class="attendance-risk-contact-icon phone" href="tel:<%= st.parent_phone %>" aria-label="Call <%= st.first_name %>'s parent" title="Call parent">
                                                <i class="bi bi-telephone-fill"></i>
                                            </a>
                                            <% } else { %>
                                            <span class="attendance-risk-no-contact" title="No parent contact available"><i class="bi bi-telephone-x"></i></span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="attendance-risk-metrics">
                                        <div>
                                            <span>Total absences</span>
                                            <strong class="attendance-risk-absence"><%= st.total_absent_days %> days</strong>
                                        </div>
                                        <div>
                                            <span>Current streak</span>
                                            <% if (st.current_consecutive_absent_days === 0) { %>
                                            <strong class="attendance-risk-broken">0 days · Broken</strong>
                                            <% } else { %>
                                            <strong class="attendance-risk-streak"><%= st.current_consecutive_absent_days %> days</strong>
                                            <% } %>
                                        </div>
                                    </div>

                                </article>
                                <% }); %>
                            </div>
                            <% } %>
                        </details>
                        <% }); %>
                    </div>
                </section>

                <style>
                    .attendance-risk-filter { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 14px; }
                    .attendance-risk-filter-button { border:1px solid var(--border-subtle); border-radius:999px; padding:8px 14px; background:var(--bg-subtle,#f8fafc); color:var(--text-primary,#1e293b); font:inherit; font-size:.84rem; cursor:pointer; }
                    .attendance-risk-filter-button.active { background:var(--primary,#001c2c); border-color:var(--primary,#001c2c); color:#fff; }
                    .attendance-risk-filter-empty { margin:0 0 12px; padding:12px; border:1px dashed var(--border-subtle); border-radius:10px; color:var(--text-muted); font-size:.85rem; }
                    .attendance-risk-section { border-top: 4px solid #dc2626; margin-top: 10px; }
                    .attendance-risk-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:16px; }
                    .attendance-risk-heading h3 { color:#b91c1c; margin:0; display:flex; align-items:center; gap:8px; }
                    .attendance-risk-heading p { color:var(--text-muted); margin:5px 0 0; font-size:.9rem; }
                    .attendance-risk-total { flex-shrink:0; border-radius:999px; background:#fee2e2; color:#991b1b; padding:6px 12px; font-size:.82rem; font-weight:700; }
                    .attendance-risk-overview { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; margin-bottom:12px; }
                    .attendance-risk-stat { display:flex; flex-direction:column; gap:2px; background:var(--bg-subtle,#f8fafc); border:1px solid var(--border-subtle); border-radius:12px; padding:12px 14px; }
                    .attendance-risk-stat strong { font-size:1.45rem; line-height:1.2; color:var(--text-primary,#1e293b); }
                    .attendance-risk-stat span { font-size:.78rem; color:var(--text-muted); }
                    .attendance-risk-guidance { color:var(--text-muted); font-size:.82rem; margin:0 0 16px; line-height:1.5; }
                    .attendance-risk-groups { display:grid; gap:10px; }
                    .attendance-risk-class { border:1px solid var(--border-subtle); border-radius:12px; overflow:hidden; background:#fff; }
                    .attendance-risk-class > summary { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px; cursor:pointer; list-style:none; background:#fff7f7; }
                    .attendance-risk-class > summary::-webkit-details-marker { display:none; }
                    .attendance-risk-class-name,.attendance-risk-class-meta { display:flex; align-items:center; gap:9px; min-width:0; }
                    .attendance-risk-class-name { color:#7f1d1d; font-weight:700; }
                    .attendance-risk-class-name span { overflow-wrap:anywhere; }
                    .attendance-risk-class-count { color:#991b1b; background:#fee2e2; border-radius:999px; padding:4px 9px; white-space:nowrap; font-size:.75rem; font-weight:700; }
                    .attendance-risk-chevron { color:#991b1b; transition:transform .2s ease; }
                    .attendance-risk-class[open] .attendance-risk-chevron { transform:rotate(180deg); }
                    .attendance-risk-desktop { padding:0 12px 12px; }
                    .attendance-risk-desktop .table-container { overflow-x:auto; }
                    .attendance-risk-desktop .data-table { min-width:680px; }
                    .attendance-risk-desktop .data-table td { vertical-align:middle; }
                    .attendance-risk-contact { display:flex; align-items:center; gap:8px; }
                    .attendance-risk-contact-icon { display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; border-radius:10px; text-decoration:none; font-size:1rem; transition:transform .15s ease,background .15s ease; }
                    .attendance-risk-contact-icon:active { transform:scale(.94); }
                    .attendance-risk-contact-icon.whatsapp { color:#15803d; background:#dcfce7; }
                    .attendance-risk-contact-icon.phone { color:#1d4ed8; background:#dbeafe; }
                    .attendance-risk-absence { color:#b91c1c; }
                    .attendance-risk-streak { color:#b45309; }
                    .attendance-risk-broken { color:#047857; font-size:.82rem; }
                    .attendance-risk-mobile { display:none; }
                    @media (max-width:768px) {
                        .attendance-risk-section { padding:14px; }
                        .attendance-risk-heading { align-items:center; }
                        .attendance-risk-heading h3 { font-size:1.05rem; }
                        .attendance-risk-heading p { font-size:.8rem; }
                        .attendance-risk-overview { gap:8px; }
                        .attendance-risk-stat { padding:10px 12px; }
                        .attendance-risk-stat strong { font-size:1.3rem; }
                        .attendance-risk-class > summary { padding:12px; }
                        .attendance-risk-desktop { display:none; }
                        .attendance-risk-mobile { display:grid; gap:9px; padding:10px; }
                        .attendance-risk-student { min-width:0; border:1px solid #e2e8f0; border-radius:11px; padding:12px; background:#fff; }
                        .attendance-risk-student-top { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; }
                        .attendance-risk-student-name { min-width:0; color:#1e293b; font-size:.9rem; line-height:1.3; overflow-wrap:anywhere; }
                        .attendance-risk-contact { flex-shrink:0; }
                        .attendance-risk-contact-icon { width:34px; height:34px; }
                        .attendance-risk-metrics { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; margin:12px 0 10px; }
                        .attendance-risk-metrics > div { display:flex; flex-direction:column; gap:3px; min-width:0; background:#f8fafc; border-radius:8px; padding:8px; }
                        .attendance-risk-metrics span { color:var(--text-muted); font-size:.7rem; }
                        .attendance-risk-metrics strong { font-size:.84rem; overflow-wrap:anywhere; }
                    }
                    @media (min-width:769px) {
                        .attendance-risk-class > summary { padding:13px 16px; }
                        .attendance-risk-desktop .data-table { margin:0; }
                    }

                    .attendance-page-header { margin-bottom: 22px; align-items: center; }
                    .attendance-launch-grid { margin-bottom: 24px; gap: 18px; align-items: stretch; }
                    .attendance-launch-card { display: flex; flex-direction: column; }
                    .attendance-launch-card h3, .attendance-staff-card h3 { margin: 0; }
                    .attendance-launch-description { margin: 8px 0 20px; color: var(--text-muted); line-height: 1.5; }
                    .attendance-launch-form { display: grid; gap: 14px; }
                    .attendance-launch-form .form-group { margin: 0; }
                    .attendance-launch-form .form-group label { display: block; margin-bottom: 7px; font-weight: 600; }
                    .attendance-launch-form .form-control { min-height: 46px; }
                    .attendance-start-button, .attendance-previous-button { width: 100%; min-height: 44px; margin: 0; }
                    .attendance-previous-button { margin-top: -4px; }
                    .attendance-previous-help { font-size: .78rem; margin: -8px 0 0; text-align: center; }
                    .attendance-offline-status { margin: 14px 0 0; font-size: .82rem; line-height: 1.45; color: var(--text-muted); }
                    .attendance-staff-card { display: flex; flex-direction: column; background: var(--bg-subtle, #f8fafc); color: var(--text-primary, #1e293b); border: 1px solid var(--border-subtle); }
                    .attendance-staff-description { margin: 8px 0 0; color: var(--text-muted); line-height: 1.5; }
                    .attendance-staff-action { margin-top: auto; padding-top: 28px; }
                    .attendance-staff-link { display: flex; justify-content: center; align-items: center; gap: 8px; width: 100%; min-height: 44px; background: var(--primary, #001c2c); color: #fff; }
                    .attendance-staff-note { margin-top: 14px; text-align: center; color: var(--text-muted); font-size: .82rem; }
                    .attendance-launch-form .form-control:focus-visible,
                    .attendance-start-button:focus-visible,
                    .attendance-previous-button:focus-visible,
                    .attendance-staff-link:focus-visible { outline: 3px solid var(--focus-ring, #fbbf24); outline-offset: 2px; }
                    @media (max-width: 768px) {
                        .attendance-page-header { gap: 10px; margin-bottom: 16px; }
                        .attendance-page-header > div { min-width: 100%; }
                        .attendance-launch-grid { gap: 12px; margin-bottom: 18px; }
                        .attendance-launch-card, .attendance-staff-card { padding: 16px; }
                        .attendance-launch-description { margin-bottom: 16px; }
                        .attendance-staff-action { padding-top: 20px; }
                    }

                </style>
                <% } %>
            </main>
    </div>


<script>
    (() => {
        const filters = document.querySelectorAll('[data-section-filter]');
        const groups = document.querySelectorAll('.attendance-risk-class[data-section-name]');
        const emptyState = document.querySelector('.attendance-risk-filter-empty');
        if (!filters.length || !groups.length) return;

        filters.forEach(button => {
            button.addEventListener('click', () => {
                const selected = button.dataset.sectionFilter;
                let visible = 0;
                groups.forEach(group => {
                    const show = selected === 'all' || group.dataset.sectionName === selected;
                    group.hidden = !show;
                    if (show) visible += 1;
                });
                filters.forEach(item => {
                    const active = item === button;
                    item.classList.toggle('active', active);
                    item.setAttribute('aria-pressed', String(active));
                });
                if (emptyState) emptyState.hidden = visible > 0;
            });
        });
    })();
</script>

<script>
    function viewPreviousAttendance() {
        const form = document.getElementById('attendance-selection-form');
        const classField = form && form.querySelector('[name="class_id"]');
        if (!classField || !classField.value) {
            alert('Please select a class first.');
            return;
        }
        // The server calculates yesterday using the Africa/Lagos calendar date.
        window.location.href = '/attendance/yesterday?class_id=' +
            encodeURIComponent(classField.value);
    }
</script>

<script>
    // Prepare a rolling seven-calendar-day window, plus the chosen date when it falls outside that window.
    function buildAttendancePreparationDates(today, selectedDate) {
        const start = new Date(today.getTime());
        start.setHours(12, 0, 0, 0);
        const dates = [];

        for (let offset = 0; offset < 7; offset++) {
            const day = new Date(start.getTime());
            day.setDate(start.getDate() + offset);
            dates.push(
                day.getFullYear() + '-' +
                String(day.getMonth() + 1).padStart(2, '0') + '-' +
                String(day.getDate()).padStart(2, '0')
            );
        }

        if (selectedDate && !dates.includes(selectedDate)) dates.push(selectedDate);
        return dates.sort();
    }

    (() => {
        const status = document.getElementById('attendance-offline-prep-status');
        const setStatus = (message, error = false) => {
            if (!status) return;
            status.textContent = message;
            status.style.color = error ? '#b91c1c' : 'var(--text-muted)';
        };

        if (!navigator.onLine || !('serviceWorker' in navigator) || !('caches' in window)) {
            setStatus('Offline preparation requires internet and browser offline storage. Reconnect before preparing class lists.', true);
            return;
        }

        const classes = <%- JSON.stringify((classes || []).map(c => ({ id: c.id, name: c.name }))) %>;
        const dateInput = document.querySelector('input[name="date"]');
        if (!dateInput || !classes.length) {
            setStatus('No assigned classes are available to prepare.', true);
            return;
        }

        const formatLocalDate = (date) => {
            return date.getFullYear() + '-' +
                String(date.getMonth() + 1).padStart(2, '0') + '-' +
                String(date.getDate()).padStart(2, '0');
        };
        const serverRenderedDefault = <%- JSON.stringify(new Date().toISOString().split('T')[0]) %>;
        const localToday = formatLocalDate(new Date());
        if (dateInput.value === serverRenderedDefault) dateInput.value = localToday;

        let runId = 0;
        const preparedSheets = new Set(); // UI progress for this run only; IndexedDB is the durable registry.
        const stalePreparedSheets = new Set();
        const sheetKey = (classId, date) => 'attendance:' + String(classId) + ':' + date;
        const sheetUrl = (classId, date) => '/attendance/take?class_id=' + encodeURIComponent(classId) + '&date=' + encodeURIComponent(date);

        async function hasUsablePreparedSheet(classId, date) {
            const offline = window.AcadMeOffline || window.NexusOffline;
            if (!offline || typeof offline.getPreparedDatasetStatus !== 'function') return false;
            try {
                const status = await offline.getPreparedDatasetStatus(sheetKey(classId, date), sheetUrl(classId, date));
                if (status.status === 'fresh' || status.status === 'stale') {
                    if (status.status === 'stale') stalePreparedSheets.add(sheetKey(classId, date));
                    return true;
                }
                return false;
            } catch (error) {
                console.warn('[AcadMe] Could not verify saved attendance preparation:', error);
                return false;
            }
        }

        const prepare = async () => {
            const thisRun = ++runId;
            const selectedDate = dateInput.value;
            if (!selectedDate) {
                setStatus('Choose an attendance date before preparing offline class lists.', true);
                return;
            }
            if (!navigator.onLine) {
                setStatus('You are offline. Only previously prepared class/date sheets are available. Reconnect to prepare more dates.', true);
                return;
            }
            if (!navigator.serviceWorker.controller) {
                setStatus('Offline support is not active on this page yet. Refresh Attendance while online, then wait for preparation to finish.', true);
                return;
            }

            const dates = buildAttendancePreparationDates(new Date(), selectedDate);
            const totalSheets = dates.length * classes.length;
            const failures = [];

            const readyDates = () => dates.filter(date =>
                classes.every(c => preparedSheets.has(sheetKey(c.id, date)))
            );
            const readySheetCount = () => dates.reduce((count, date) =>
                count + classes.filter(c => preparedSheets.has(sheetKey(c.id, date))).length, 0
            );

            setStatus('Checking saved offline attendance for ' + totalSheets + ' class/date sheets…');
            for (const date of dates) {
                if (thisRun !== runId) return;
                for (let i = 0; i < classes.length; i += 3) {
                    if (thisRun !== runId) return;
                    const candidates = classes.slice(i, i + 3).filter(c => !preparedSheets.has(sheetKey(c.id, date)));
                    const batch = [];
                    for (const candidate of candidates) {
                        if (await hasUsablePreparedSheet(candidate.id, date)) {
                            preparedSheets.add(sheetKey(candidate.id, date));
                        } else {
                            batch.push(candidate);
                        }
                    }
                    if (!batch.length) continue;

                    setStatus('Preparing offline attendance: ' + readySheetCount() + ' of ' + totalSheets +
                        ' sheets already verified. Preparing ' + batch.length + ' missing class/date sheets…');
                    const results = await Promise.allSettled(batch.map(async c => {
                        const url = sheetUrl(c.id, date);
                        const response = await fetch(url, {
                            credentials: 'same-origin',
                            headers: { 'X-AcadMe-Offline-Prepare': '1' },
                            cache: 'no-store'
                        });
                        if (!response.ok || response.redirected || !(response.headers.get('content-type') || '').toLowerCase().includes('text/html')) {
                            throw new Error('Attendance page request failed or redirected to login.');
                        }
                        if (response.headers.get('X-AcadMe-Offline-Cached') !== '1') {
                            throw new Error('The active service worker did not confirm that this class sheet was cached.');
                        }
                        const offline = window.AcadMeOffline || window.NexusOffline;
                        if (!offline || typeof offline.recordPreparedDataset !== 'function') {
                            throw new Error('Offline preparation registry is unavailable; the sheet cannot be marked ready.');
                        }
                        await offline.recordPreparedDataset(sheetKey(c.id, date), 'attendance', sheetUrl(c.id, date));
                        return c;
                    }));

                    results.forEach((result, index) => {
                        if (result.status === 'fulfilled') {
                            preparedSheets.add(sheetKey(result.value.id, date));
                        } else {
                            const className = batch[index].name || ('Class ' + batch[index].id);
                            failures.push(date + ' — ' + className);
                        }
                    });
                }

                const ready = readyDates();
                setStatus('Checking saved offline attendance: ' + readySheetCount() + ' of ' + totalSheets +
                    ' class/date sheets verified so far.');
            }

            if (thisRun !== runId) return;
            const ready = readyDates();
            if (failures.length) {
                const shownFailures = failures.slice(0, 5).join('; ');
                const moreFailures = failures.length > 5 ? ' (and ' + (failures.length - 5) + ' more)' : '';
                setStatus('Offline preparation incomplete. Ready dates: ' + (ready.join(', ') || 'none') +
                    '. Failed sheets: ' + shownFailures + moreFailures +
                    '. Keep internet connected and retry before working offline.', true);
            } else {
                const staleCount = stalePreparedSheets.size;
                setStatus('Verified: offline attendance is ready for ' + ready.length + ' dates: ' + ready.join(', ') +
                    '. ' + (staleCount ? staleCount + ' saved sheet(s) are older than 24 hours but remain available within the 7-day retention period; refresh them online when practical. ' : '') +
                    'The selected date is included even when outside the rolling 7-day window.', false);
            }
        };

        prepare().catch(err => {
            console.warn('[AcadMe] Offline attendance preparation failed', err);
            setStatus('Offline preparation failed. Stay online and refresh before testing offline.', true);
        });
        dateInput.addEventListener('change', () => {
            prepare().catch(err => {
                console.warn('[AcadMe] Offline attendance preparation failed', err);
                setStatus('Offline preparation failed. Stay online and refresh before testing offline.', true);
            });
        });
    })();
</script>

