<%- include('../partials/header') %>
<div class="dashboard-container">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <header style="margin-bottom:24px;">
            <a href="/attendance" style="color:var(--primary);text-decoration:none;font-weight:600;">&larr; Back to Attendance</a>
            <h1 style="margin-top:10px;">Attendance Report</h1>
            <p>Calculated from expected class days and formally submitted registers.</p>
        </header>

        <section class="card" style="margin-bottom:24px;">
            <form action="/attendance/report" method="GET" class="grid-2" style="gap:15px;align-items:end;">
                <div class="form-group">
                    <label>Class</label>
                    <select name="class_id" required class="form-control">
                        <option value="">-- Select class --</option>
                        <% (classes || []).forEach(c => { %>
                            <option value="<%= c.id %>" <%= String(filters.class_id || '') === String(c.id) ? 'selected' : '' %>><%= c.name %><%= c.section_name ? ' — ' + c.section_name : '' %></option>
                        <% }); %>
                    </select>
                    <% if (!classes || !classes.length) { %><small>No classes are available to you. Teacher access is limited to your current form-master assignment.</small><% } %>
                </div>
                <div class="form-group">
                    <label>Start date</label>
                    <input type="date" name="start_date" value="<%= filters.start_date || '' %>" required class="form-control">
                </div>
                <div class="form-group">
                    <label>End date</label>
                    <input type="date" name="end_date" value="<%= filters.end_date || '' %>" required class="form-control">
                </div>
                <div class="form-group">
                    <label>Low-attendance threshold (%)</label>
                    <input type="number" name="threshold" min="0" max="100" step="0.1" value="<%= filters.threshold %>" required class="form-control">
                </div>
                <button type="submit" class="btn" style="width:100%;">Generate report</button>
            </form>
        </section>

        <% if (reportError) { %>
            <div class="card" role="alert" style="border-left:4px solid #dc2626;margin-bottom:20px;">
                <strong>Report could not be generated</strong>
                <p style="margin:6px 0 0;"><%= reportError %></p>
            </div>
        <% } %>

        <% if (reportData) { %>
            <section class="card">
                <div style="margin-bottom:18px;">
                    <h2 style="margin:0;"><%= reportContext.class_name %></h2>
                    <p class="text-muted" style="margin:5px 0;"><%= reportContext.section_name || 'Section' %> · <%= reportContext.session %> · <%= reportContext.term %></p>
                    <p class="text-muted" style="margin:0;"><%= filters.start_date %> to <%= filters.end_date %> · Low-attendance threshold: <%= reportContext.threshold %>%</p>
                </div>
                <div class="table-container mobile-cards">
                    <table class="data-table">
                        <thead><tr>
                            <th>Student</th><th>Expected</th><th>Recorded</th><th>Present</th><th>Late</th><th>Leave</th><th>Absent</th><th>Attendance %</th><th>Missing / Draft</th>
                        </tr></thead>
                        <tbody>
                        <% reportData.forEach(row => { %>
                            <tr>
                                <td data-label="Student"><strong><%= row.first_name %> <%= row.last_name %></strong><small style="display:block;color:var(--text-muted);"><%= row.admission_number || '' %></small></td>
                                <td data-label="Expected"><%= row.expected %></td>
                                <td data-label="Recorded"><%= row.recorded %></td>
                                <td data-label="Present"><%= row.present %></td>
                                <td data-label="Late"><%= row.late %></td>
                                <td data-label="Leave"><%= row.leave %></td>
                                <td data-label="Absent"><%= row.absent %></td>
                                <td data-label="Attendance %">
                                    <% if (row.attendance_rate === null) { %><span>Not available</span><% } else { %>
                                        <strong><%= row.attendance_rate.toFixed(1) %>%</strong>
                                        <% if (row.low_attendance) { %><span class="badge badge-danger">Below threshold</span><% } %>
                                    <% } %>
                                </td>
                                <td data-label="Missing / Draft"><%= row.missing_register %> missing · <%= row.draft_register %> draft · <%= row.missing_student_record %> incomplete</td>
                            </tr>
                        <% }); %>
                        </tbody>
                    </table>
                </div>
                <% if (!reportData.length) { %><p class="text-muted" style="text-align:center;padding:24px;">No students have confirmed enrollment records overlapping this date range. Historical enrollment dates are not inferred.</p><% } %>
                <p class="text-muted" style="margin-top:14px;font-size:.85rem;">Attendance rate uses submitted registers with a recognized student attendance row. Present, Late and approved Leave receive full credit; Absent receives zero. Missing or draft registers are shown separately and never counted as absences.</p>
            </section>
        <% } %>
    </main>
</div>
<%- include('../partials/footer') %>
