<%- include('../partials/header') %>
<div class="dashboard-container">
    <%- include('../partials/sidebar') %>
    <main class="main-content attendance-setup-page">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
            <div>
                <a href="/attendance" class="text-decoration-none">← Attendance</a>
                <h1 class="h3 mt-2 mb-1">Attendance setup</h1>
                <p class="text-muted mb-0">Configure section academic periods, inherited opening-day schedules, class overrides, responsible teachers and attendance rules.</p>
            </div>
        </div>
        <% if (error) { %><div class="alert alert-warning" role="alert"><%= error %></div><% } %>
        <% if (setup) { %>
        <% const attendanceTodayParts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Lagos', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date()).reduce((result, part) => { if (part.type !== 'literal') result[part.type] = part.value; return result; }, {}); const attendanceTodayKey = attendanceTodayParts.year + '-' + attendanceTodayParts.month + '-' + attendanceTodayParts.day; %>
        <div id="setup-feedback" class="alert d-none" role="status" aria-live="polite"></div>
        <section class="card p-3 mb-3" aria-labelledby="readiness-heading">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h2 class="h5 mb-1" id="readiness-heading">Setup readiness</h2>
                    <p class="text-muted small mb-0">Current configuration as of <%= setup.readinessSummary.checkedDate %>. A class is ready when it has an active section academic period, a resolved section default or class override, class attendance settings and a primary teacher.</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge text-bg-success"><%= setup.readinessSummary.ready %> ready</span>
                    <span class="badge text-bg-warning"><%= setup.readinessSummary.incomplete %> need attention</span>
                    <span class="badge text-bg-secondary"><%= setup.readinessSummary.total %> classes</span>
                </div>
            </div>
            <% if (!setup.readiness.length) { %>
                <p class="text-muted mb-0 mt-3">No classes are available for setup.</p>
            <% } else { %>
            <div class="table-responsive mt-3">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>Section / class</th><th>Academic period</th><th>Resolved opening days</th><th>Settings</th><th>Primary teacher</th><th>Readiness</th></tr></thead>
                    <tbody>
                    <% setup.readiness.forEach(item => { %>
                        <tr>
                            <td><strong><%= item.section_name %></strong><div><%= item.class_name %></div></td>
                            <td><%= item.period ? 'Configured' : 'Missing' %></td>
                            <td><% if (item.schedule) { %><div><%= item.schedule_source === 'class_override' ? 'Class override' : 'Section default' %></div><span class="small text-muted"><%= (item.schedule_weekdays || []).map(day => ['', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][Number(day)]).join(', ') %></span><% } else { %><span class="text-danger"><%= item.schedule_issue === 'SCHEDULE_CONFLICT' ? 'Conflict' : item.schedule_issue === 'schedule_foundation_unavailable' ? 'Migration required' : 'Missing' %></span><% if (item.schedule_error) { %><div class="small text-muted"><%= item.schedule_error %></div><% } %><% } %></td>
                            <td><%= item.settings ? 'Configured' : 'Missing' %></td>
                            <td><%= item.primary_teacher ? 'Assigned' : 'Missing' %></td>
                            <td>
                                <% if (item.ready) { %><span class="badge text-bg-success">Ready</span>
                                <% } else { %><span class="badge text-bg-warning">Incomplete</span><div class="small text-muted"><%= item.missing.join(' · ') %></div><% } %>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </section>
        <section class="card p-3 mb-3">
            <h2 class="h5">1. Section academic periods</h2>
            <p class="text-muted small">Each section needs exactly one period covering an attendance date. Periods in the same section cannot overlap.</p>
            <form class="row g-2 setup-form" data-action="academic_period">
                <div class="col-md-3"><label class="form-label">Section</label><select class="form-select" name="sectionId" required><option value="">Select section</option><% setup.sections.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div>
                <div class="col-md-2"><label class="form-label">Session</label><input class="form-control" name="session" placeholder="2026/2027" maxlength="40" required></div>
                <div class="col-md-2"><label class="form-label">Term</label><select class="form-select" name="term" required><option value="">Select term</option><option>1st Term</option><option>2nd Term</option><option>3rd Term</option></select></div>
                <div class="col-md-2"><label class="form-label">Start date</label><input class="form-control" type="date" name="startDate" required></div>
                <div class="col-md-2"><label class="form-label">End date</label><input class="form-control" type="date" name="endDate" required></div>
                <div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100">Add</button></div>
            </form>
            <div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>Section</th><th>Session / term</th><th>Dates</th><th>Status</th><th></th></tr></thead><tbody>
            <% setup.periods.forEach(p => { %><tr><td><%= p.section_name %></td><td><%= p.session %> · <%= p.term %></td><td><%= String(p.start_date).slice(0,10) %> – <%= String(p.end_date).slice(0,10) %></td><td><%= p.status %></td><td><% if (p.status === 'active' && String(p.end_date).slice(0,10) > attendanceTodayKey) { %><button class="btn btn-sm btn-outline-secondary" data-end="academic_period" data-id="<%= p.id %>" data-start="<%= String(p.start_date).slice(0,10) %>">Shorten period</button><% } %></td></tr><% }) %>
            <% if (!setup.periods.length) { %><tr><td colspan="5" class="text-muted">No academic periods configured.</td></tr><% } %>
            </tbody></table></div>
        </section>

        <section class="card p-3 mb-3">
            <h2 class="h5">2. Weekly opening-day schedules</h2>
            <p class="text-muted small">Set opening days once for each section. Classes inherit that schedule unless a complete class override is active. An override replaces the section days; it never adds to them. Changes are effective-dated and historical sets are retained.</p>
            <% if (!setup.scheduleFoundationAvailable) { %>
                <div class="alert alert-warning mb-3" role="alert">The schedule-set database migration has not been installed. The new schedule editor is safely disabled; no legacy opening-day rows will be changed. Schedule readiness remains incomplete until the separately approved migration is installed.</div>
            <% } %>
            <div class="border rounded p-3 mb-3">
                <h3 class="h6">Section default schedule</h3>
                <form class="row g-3 setup-form" data-action="section_schedule">
                    <div class="col-md-4"><label class="form-label">Section</label><select class="form-select" name="sectionId" required><option value="">Select section</option><% setup.sections.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div>
                    <div class="col-md-4"><label class="form-label">Effective from</label><input class="form-control" type="date" name="effectiveFrom" required></div>
                    <div class="col-md-4"><label class="form-label">Effective to (optional)</label><input class="form-control" type="date" name="effectiveTo"></div>
                    <div class="col-12"><span class="form-label d-block">Opening weekdays</span><div class="d-flex flex-wrap gap-3">
                        <% [['1','Monday'],['2','Tuesday'],['3','Wednesday'],['4','Thursday'],['5','Friday'],['6','Saturday'],['7','Sunday']].forEach(day => { %>
                            <label class="form-check"><input class="form-check-input" type="checkbox" name="weekdays" value="<%= day[0] %>"> <span class="form-check-label"><%= day[1] %></span></label>
                        <% }) %>
                    </div></div>
                    <div class="col-12"><button class="btn btn-primary" <%= setup.scheduleFoundationAvailable ? '' : 'disabled' %>>Save section default</button></div>
                </form>
            </div>
            <div class="border rounded p-3 mb-3">
                <h3 class="h6">Class-specific override</h3>
                <p class="small text-muted">Use only when a class follows a different complete weekly schedule from its section.</p>
                <form class="row g-3 setup-form" data-action="class_schedule">
                    <div class="col-md-4"><label class="form-label">Section</label><select class="form-select section-filter" name="sectionId" required><option value="">Select section</option><% setup.sections.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div>
                    <div class="col-md-4"><label class="form-label">Class</label><select class="form-select class-filter" name="classId" required><option value="">Select class</option><% setup.classes.forEach(c => { %><option value="<%= c.id %>" data-section="<%= c.section_id %>"><%= c.name %></option><% }) %></select></div>
                    <div class="col-md-2"><label class="form-label">Effective from</label><input class="form-control" type="date" name="effectiveFrom" required></div>
                    <div class="col-md-2"><label class="form-label">Effective to (optional)</label><input class="form-control" type="date" name="effectiveTo"></div>
                    <div class="col-12"><span class="form-label d-block">Complete opening weekdays</span><div class="d-flex flex-wrap gap-3">
                        <% [['1','Monday'],['2','Tuesday'],['3','Wednesday'],['4','Thursday'],['5','Friday'],['6','Saturday'],['7','Sunday']].forEach(day => { %>
                            <label class="form-check"><input class="form-check-input" type="checkbox" name="weekdays" value="<%= day[0] %>"> <span class="form-check-label"><%= day[1] %></span></label>
                        <% }) %>
                    </div></div>
                    <div class="col-12"><button class="btn btn-primary" <%= setup.scheduleFoundationAvailable ? '' : 'disabled' %>>Save full class override</button></div>
                </form>
            </div>
            <h3 class="h6 mt-3">Schedule history</h3>
            <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Section / class</th><th>Scope</th><th>Opening days</th><th>Effective dates</th><th></th></tr></thead><tbody>
                <% const weekdays = ['','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday']; setup.scheduleSets.forEach(item => { %>
                    <tr><td><strong><%= item.section_name %></strong><% if (item.class_name) { %><div><%= item.class_name %></div><% } %></td>
                    <td><%= item.scope_type === 'section' ? 'Section default' : 'Class override' %></td>
                    <td><%= item.weekdays.map(day => weekdays[Number(day)]).join(', ') %></td>
                    <td><%= String(item.effective_from).slice(0,10) %> – <%= item.effective_to ? String(item.effective_to).slice(0,10) : 'Ongoing' %></td>
                    <td><% if (!item.effective_to) { %><button class="btn btn-sm btn-outline-secondary" data-end="schedule-set" data-id="<%= item.id %>" data-start="<%= String(item.effective_from).slice(0,10) %>">End</button><% } %></td></tr>
                <% }) %>
                <% if (!setup.scheduleSets.length) { %><tr><td colspan="5" class="text-muted">No section defaults or class overrides have been configured.</td></tr><% } %>
            </tbody></table></div>
        </section>

        <section class="card p-3 mb-3">
            <h2 class="h5">3. Responsible and substitute teachers</h2>
            <p class="text-muted small">One primary and one substitute assignment may be effective for a class at a time. A substitute takes precedence while active.</p>
            <form class="row g-2 setup-form" data-action="responsibility">
                <div class="col-md-3"><label class="form-label">Section</label><select class="form-select section-filter" name="sectionId" required><option value="">Select section</option><% setup.sections.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div>
                <div class="col-md-3"><label class="form-label">Class</label><select class="form-select class-filter" name="classId" required><option value="">Select class</option><% setup.classes.forEach(c => { %><option value="<%= c.id %>" data-section="<%= c.section_id %>"><%= c.name %></option><% }) %></select></div>
                <div class="col-md-2"><label class="form-label">Assignment</label><select class="form-select" name="responsibilityType" required><option value="primary">Primary</option><option value="substitute">Substitute</option></select></div>
                <div class="col-md-4"><label class="form-label">Staff member</label><select class="form-select" name="staffId" required><option value="">Select staff</option><% setup.staff.forEach(s => { %><option value="<%= s.id %>"><%= s.first_name %> <%= s.last_name %> · <%= s.role %></option><% }) %></select></div>
                <div class="col-md-3"><label class="form-label">Effective from</label><input class="form-control" type="date" name="startDate" required></div>
                <div class="col-md-3"><label class="form-label">Effective to (optional)</label><input class="form-control" type="date" name="endDate"></div>
                <div class="col-12"><button class="btn btn-primary">Assign teacher</button></div>
            </form>
            <div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>Class</th><th>Type</th><th>Staff</th><th>Effective dates</th><th></th></tr></thead><tbody>
            <% setup.responsibilities.forEach(r => { %><tr><td><%= r.section_name %> · <%= r.class_name %></td><td><%= r.responsibility_type %></td><td><%= r.first_name %> <%= r.last_name %></td><td><%= String(r.effective_from).slice(0,10) %> – <%= r.effective_to ? String(r.effective_to).slice(0,10) : 'Ongoing' %></td><td><% if (!r.effective_to) { %><button class="btn btn-sm btn-outline-secondary" data-end="responsibility" data-id="<%= r.id %>" data-start="<%= String(r.effective_from).slice(0,10) %>">End</button><% } %></td></tr><% }) %>
            <% if (!setup.responsibilities.length) { %><tr><td colspan="5" class="text-muted">No teacher responsibilities configured.</td></tr><% } %>
            </tbody></table></div>
        </section>

        <section class="card p-3 mb-4">
            <h2 class="h5">4. Class attendance settings</h2>
            <p class="text-muted small">Settings are effective-dated. Reminder intervals are minutes after the first reminder, entered as comma-separated whole numbers.</p>
            <form class="row g-2 setup-form" data-action="settings">
                <div class="col-md-3"><label class="form-label">Section</label><select class="form-select section-filter" name="sectionId" required><option value="">Select section</option><% setup.sections.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div>
                <div class="col-md-3"><label class="form-label">Class</label><select class="form-select class-filter" name="classId" required><option value="">Select class</option><% setup.classes.forEach(c => { %><option value="<%= c.id %>" data-section="<%= c.section_id %>"><%= c.name %></option><% }) %></select></div>
                <div class="col-md-2"><label class="form-label">Deadline</label><input class="form-control" type="time" name="deadline" value="14:00" required></div>
                <div class="col-md-2"><label class="form-label">First reminder (min)</label><input class="form-control" type="number" name="firstReminderDelayMinutes" min="0" max="10080" value="0" required></div>
                <div class="col-md-2"><label class="form-label">Low attendance (%)</label><input class="form-control" type="number" name="lowAttendanceThreshold" min="0" max="100" step="0.01" value="75" required></div>
                <div class="col-md-3"><label class="form-label">Effective from</label><input class="form-control" type="date" name="startDate" required></div>
                <div class="col-md-3"><label class="form-label">Effective to (optional)</label><input class="form-control" type="date" name="endDate"></div>
                <div class="col-md-6"><label class="form-label">Subsequent reminder intervals (minutes)</label><input class="form-control" name="subsequentReminderIntervals" value="60, 120" placeholder="60, 120"></div>
                <div class="col-12"><button class="btn btn-primary">Save class settings</button></div>
            </form>
            <div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>Class</th><th>Deadline</th><th>First reminder</th><th>Later intervals</th><th>Threshold</th><th>Effective dates</th><th></th></tr></thead><tbody>
            <% setup.settings.forEach(s => { let intervals = s.subsequent_reminder_intervals_minutes; if (typeof intervals === 'string') { try { intervals = JSON.parse(intervals); } catch (_) { intervals = []; } } %><tr><td><%= s.section_name %> · <%= s.class_name %></td><td><%= String(s.submission_deadline_time).slice(0,5) %></td><td><%= s.first_reminder_delay_minutes %> min</td><td><%= Array.isArray(intervals) ? intervals.join(', ') : '' %></td><td><%= s.low_attendance_threshold %>%</td><td><%= String(s.effective_from).slice(0,10) %> – <%= s.effective_to ? String(s.effective_to).slice(0,10) : 'Ongoing' %></td><td><% if (!s.effective_to) { %><button class="btn btn-sm btn-outline-secondary" data-end="settings" data-id="<%= s.id %>" data-start="<%= String(s.effective_from).slice(0,10) %>">End</button><% } %></td></tr><% }) %>
            <% if (!setup.settings.length) { %><tr><td colspan="7" class="text-muted">No class attendance settings configured.</td></tr><% } %>
            </tbody></table></div>
        </section>
        <% } %>
    </main>
</div>
<script>
(() => {
    const feedback = document.getElementById('setup-feedback');
    const show = (message, bad) => {
        if (!feedback) return;
        feedback.textContent = message;
        feedback.classList.remove('d-none', 'alert-success', 'alert-danger');
        feedback.classList.add(bad ? 'alert-danger' : 'alert-success');
        feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };
    document.querySelectorAll('.setup-form').forEach(form => {
        const section = form.querySelector('.section-filter');
        const classSelect = form.querySelector('.class-filter');
        if (section && classSelect) {
            const filter = () => {
                const selected = section.value;
                Array.from(classSelect.options).forEach(option => {
                    if (!option.value) return;
                    option.hidden = Boolean(selected && option.dataset.section !== selected);
                });
                if (classSelect.selectedOptions[0]?.hidden) classSelect.value = '';
            };
            section.addEventListener('change', filter);
            filter();
        }
        form.addEventListener('submit', async event => {
            event.preventDefault();
            const button = form.querySelector('button[type="submit"],button:not([type])');
            if (button) button.disabled = true;
            const formData = new FormData(form);
            const payload = Object.fromEntries(formData.entries());
            if (formData.has('weekdays')) payload.weekdays = formData.getAll('weekdays');
            payload.action = form.dataset.action;
            if (payload.subsequentReminderIntervals !== undefined) {
                const rawIntervals = payload.subsequentReminderIntervals.trim();
                payload.subsequentReminderIntervals = rawIntervals ? rawIntervals.split(',').map(v => Number(v.trim())) : [];
            }
            try {
                const response = await fetch('/attendance/setup/save', {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not save attendance setup.');
                show(result.message + ' Refreshing the configuration list…', false);
                window.location.reload();
            } catch (error) { show(error.message, true); }
            finally { if (button) button.disabled = false; }
        });
    });
    document.querySelectorAll('[data-end]').forEach(button => {
        button.addEventListener('click', async () => {
            const parts = new Intl.DateTimeFormat('en-CA', {
                timeZone: 'Africa/Lagos', year: 'numeric', month: '2-digit', day: '2-digit'
            }).formatToParts(new Date()).reduce((result, part) => {
                if (part.type !== 'literal') result[part.type] = part.value;
                return result;
            }, {});
            const todayKey = parts.year + '-' + parts.month + '-' + parts.day;
            const suggestedEnd = todayKey < button.dataset.start ? button.dataset.start : todayKey;
            const endDate = window.prompt('Enter the last effective date (YYYY-MM-DD):', suggestedEnd);
            if (!endDate) return;
            const reason = window.prompt('Why is this configuration being ended?');
            if (!reason) return;
            button.disabled = true;
            try {
                const endPayload = button.dataset.end === 'schedule-set'
                    ? { action: 'end_schedule_set', scheduleSetId: button.dataset.id, effectiveTo: endDate, reason }
                    : { action: 'end', type: button.dataset.end, recordId: button.dataset.id, endDate, reason };
                const response = await fetch('/attendance/setup/save', {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(endPayload)
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not end configuration.');
                window.location.reload();
            } catch (error) { show(error.message, true); button.disabled = false; }
        });
    });
})();
</script>
<%- include('../partials/footer') %>
