<%- include('../partials/header') %>

<div class="dashboard-container">
    <%- include('../partials/sidebar') %>

    <main class="main-content">
        <!-- Sticky Header for Actions -->
        <div class="sticky-attendance-header">
            <div class="header-main">
                <div class="breadcrumb-container">
                    <a href="/attendance" class="back-link"><i class="bi bi-arrow-left"></i> Directory</a>
                    <h1 style="font-size: 1.25rem; margin: 0;"><%= readOnly ? 'Previous Day Attendance' : 'Mark Attendance' %></h1>
                </div>
                <div class="action-buttons">
                    <% if (readOnly && registerStatus !== 'submitted') { %>
                    <button type="button" id="edit-attendance-btn" class="btn btn-outline" onclick="enableAttendanceEditing()">
                        <i class="bi bi-pencil-square"></i> Edit
                    </button>
                    <% } %>
                    <button type="submit" form="attendance-form" class="btn btn-outline attendance-save-action" data-attendance-operation="draft" <%= (readOnly || registerStatus === 'submitted') ? 'hidden' : '' %>>
                        <i class="bi bi-cloud-check-fill"></i> Save Records
                    </button>
                    <button type="submit" form="attendance-form" data-attendance-operation="submit" class="btn btn-primary attendance-submit-action" <%= (readOnly || registerStatus === 'submitted') ? 'hidden' : '' %>><i class="bi bi-lock-fill"></i> Submit Register</button>
                    <% if (registerStatus === 'submitted' && isAttendanceAdmin) { %><button type="button" id="reopen-register-btn" class="btn btn-outline">Reopen for correction</button><% } %>
                </div>
            </div>
            <div class="header-meta">
                <div style="display: flex; gap: 8px; flex: 1;">
                    <span class="meta-pill"><i class="bi bi-door-open"></i> <%= clazz.name %></span>
                    <span class="meta-pill" id="attendance-date-label"><i class="bi bi-calendar-event"></i> <%= new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                </div>
                <button type="button" class="btn btn-outline btn-xs mark-all-present-action" onclick="markAllPresent()" <%= (readOnly || registerStatus === 'submitted') ? 'hidden' : '' %>>
                    Mark All Present
                </button>
            </div>
        </div>

        <section class="attendance-container" style="margin-top: 15px;">
            <% if (registerStatus === 'submitted') { %><div class="alert alert-success" role="status"><strong>Register submitted and locked</strong><div>Submission version <%= registerVersion %>. Ordinary edits are disabled. <% if (isAttendanceAdmin) { %>An administrator may reopen it with a recorded reason.<% } %></div></div><% } else if (!readOnly) { %><div class="alert alert-info" role="status"><strong>Register is a draft</strong><div>Save Records keeps a draft editable. Submit Register requires an explicit status for every confirmed enrolled student and locks the register.</div></div><% } %>
            <% if (Number(unknownEnrollmentCount || 0) > 0) { %>
                <div class="alert alert-warning" role="alert">
                    <strong>Enrollment dates need review</strong>
                    <div><%= unknownEnrollmentCount %> active class member(s) have missing or review-needed dated enrollment history. They are not assumed to belong to this class on this date. An administrator must resolve the dates before this register can be submitted.</div>
                </div>
            <% } %>
            <% if (readOnly) { %>
                <div class="alert <%= hasRecords ? 'alert-info' : 'alert-warning' %>" role="status">
                    <strong><%= hasRecords ? 'Read-only attendance record' : 'No attendance recorded' %></strong>
                    <div><%= hasRecords ? 'You are viewing the saved attendance for this class and date.' : 'There are no saved attendance records for this class on this date. You can still enter them using Edit.' %></div>
                </div>
            <% } else { %>
                <p class="text-muted" style="margin-bottom: 15px; font-size: 0.85rem;"><%= students.length %> Students enrolled in this class.</p>
            <% } %>

            <div id="attendance-status-summary" class="attendance-status-summary" role="status" aria-live="polite" aria-atomic="true"></div>

            <form id="attendance-form" class="attendance-form">
                <input type="hidden" name="class_id" value="<%= class_id %>">
                <input type="hidden" name="date" value="<%= date %>">
                <input type="hidden" name="session" value="<%= locals.currentSession || '' %>">
                <input type="hidden" name="term" value="<%= locals.currentTerm || '' %>">

                <div class="student-grid">
                    <% students.forEach((student, index) => { 
                        const currentStatus = student.status || 'Not recorded';
                    %>
                        <div class="student-row-card" data-student-id="<%= student.id %>">
                            <input type="hidden" class="status-input" name="attendance[<%= student.id %>]" value="<%= currentStatus === 'Not recorded' ? '' : currentStatus %>">
                            
                            <div class="row-info">
                                <div style="width: 46px; height: 54px; flex-shrink: 0; background: #f3f4f6; border-radius: 6px; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 1px solid #cbd5e1;">
                                    <% if (student.passport_photo_path) { %>
                                        <img src="<%= student.passport_photo_path %>" alt="Photo" style="width: 100%; height: 100%; object-fit: cover;">
                                    <% } else { %>
                                        <i class="bi bi-person-fill" style="color: #9ca3af; font-size: 1.5rem;"></i>
                                    <% } %>
                                </div>
                                <div class="row-bio">
                                    <strong class="row-name"><%= student.first_name %> <%= student.last_name %></strong>
                                    <div style="display: flex; gap: 10px; align-items: center; margin-top: 2px;">
                                        <small class="row-index">SN : <%= index + 1 %></small>
                                    </div>
                                </div>
                            </div>

                            <div class="row-action">
                                <button type="button" 
                                        class="cycle-btn <%= currentStatus === 'Not recorded' ? 'btn-status-unrecorded' : 'btn-status-' + currentStatus.toLowerCase() %>" 
                                        data-state="<%= currentStatus %>"
                                        aria-label="Attendance status for <%= student.first_name %> <%= student.last_name %>: <%= currentStatus %>. Activate to change status."
                                        title="Tap to change attendance status"
                                        <%= (readOnly || registerStatus === 'submitted') ? 'disabled' : '' %>
                                        onclick="cycleStatus('<%= student.id %>')">
                                    <i class="bi <%= currentStatus === 'Present' ? 'bi-check-circle-fill' : currentStatus === 'Late' ? 'bi-clock-fill' : currentStatus === 'Leave' ? 'bi-journal-text' : currentStatus === 'Not recorded' ? 'bi-dash-circle' : 'bi-x-circle-fill' %>"></i>
                                    <span class="status-label"><%= currentStatus %></span>
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </form>
        </section>
        <div class="attendance-bottom-spacer" aria-hidden="true"></div>

        <!-- Feedback Modal -->
        <div id="feedbackModal" class="modal-overlay" style="display: none;">
            <div class="modal-content">
                <div class="success-icon"><i class="bi bi-check-lg"></i></div>
                <h2>Success!</h2>
                <p>Attendance records have been updated successfully.</p>
                <button class="btn btn-primary btn-block" onclick="window.location.href='/attendance'">Back to Dashboard</button>
            </div>
        </div>

        <!-- Sticky Save Bar (mobile only) -->
        <div class="sticky-save-bar attendance-mobile-save" <%= (readOnly || registerStatus === 'submitted') ? 'hidden' : '' %>>
            <a href="/attendance" class="btn btn-outline" style="flex:0; padding: 12px 16px;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <button type="submit" form="attendance-form" data-attendance-operation="draft" class="btn btn-outline">
                <i class="bi bi-cloud-check-fill"></i> Save Records
            </button>
            <button type="submit" form="attendance-form" data-attendance-operation="submit" class="btn btn-primary attendance-submit-action">Submit Register</button>
        </div>
    </main>
</div>

<style>
    /* New Sticky Header */
    .sticky-attendance-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 12px 0;
        border-bottom: 1px solid #e2e8f0;
        margin: -15px 0 15px;
    }

    .header-main {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .back-link { font-size: 0.75rem; text-decoration: none; color: var(--school-primary); font-weight: 700; display: block; margin-bottom: 2px; }

    .header-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .meta-pill {
        background: #f8fafc;
        color: #64748b;
        padding: 4px 10px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 5px;
        border: 1px solid #e2e8f0;
    }

    .meta-pill i { color: var(--school-primary); }

    .attendance-status-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0 0 14px;
    }

    .attendance-status-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #334155;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .attendance-status-chip strong {
        font-variant-numeric: tabular-nums;
    }

    /* Student Grid */
    .student-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
        margin-bottom: 60px;
    }

    .student-row-card {
        background: white;
        padding: 10px 15px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: 0.2s;
        min-width: 0; /* Fix flex child overflow */
        gap: 10px;
    }

    .row-info { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
    .row-index { font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase; }
    .row-bio { display: flex; flex-direction: column; min-width: 0; justify-content: center; flex: 1; }
    .row-name { display: block; width: 100%; font-size: 0.88rem; color: #1e293b; font-weight: 700; line-height: 1.2; white-space: normal; overflow: visible; overflow-wrap: anywhere; text-align: left; text-transform: uppercase; }
    .row-id { font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase; }

    /* Cycle Button */
    .cycle-btn {
        width: 75px;
        padding: 6px 4px;
        border-radius: 8px;
        border: 2px solid transparent;
        font-weight: 800;
        font-size: 0.65rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        cursor: pointer;
        transition: all 0.2s;
        text-transform: uppercase;
    }

    .btn-status-absent { background: #fef2f2; color: #ef4444; border-color: #fee2e2; }
    .btn-status-present { background: #f0fdf4; color: #10b981; border-color: #dcfce7; }
    .btn-status-leave { background: #eef2ff; color: #6366f1; border-color: #e0e7ff; }
    .btn-status-late { background: #fffbeb; color: #f59e0b; border-color: #fef3c7; }
    .btn-status-unrecorded { background: #f8fafc; color: #64748b; border-color: #e2e8f0; }

    .cycle-btn i { font-size: 1.2rem; line-height: 1; }

    .btn-xs { padding: 4px 10px; font-size: 0.7rem; border-radius: 6px; font-weight: 700; }

    @media (max-width: 991px) {
        .student-row-card { padding: 8px 10px; }
        .row-info, .row-bio { text-align: left; align-items: flex-start; }
        .row-name { font-size: 0.82rem; line-height: 1.2; }
        .cycle-btn { width: 65px; padding: 5px 2px; font-size: 0.6rem; }
        .cycle-btn i { font-size: 1.1rem; }
        .sticky-attendance-header { margin: -10px -10px 15px; padding: 10px 15px; }
    }

    @media (max-width: 991px) {
        .attendance-bottom-spacer {
            height: calc(132px + env(safe-area-inset-bottom, 0px));
        }
        .sticky-save-bar {
            bottom: calc(60px + env(safe-area-inset-bottom, 0px));
            padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px));
        }
    }

    [hidden] { display: none !important; }

    /* Modal */
    .modal-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(8px);
        display: flex; align-items: center; justify-content: center; z-index: 9999;
    }
    .modal-content {
        background: white; border-radius: 24px; padding: 30px;
        text-align: center; max-width: 350px; width: 90%;
    }
    .success-icon {
        width: 50px; height: 50px; background: #f0fdf4; color: #10b981;
        border-radius: 50%; display: flex; align-items: center; justify-content: center;
        font-size: 1.8rem; margin: 0 auto 15px;
    }
</style>

<script>
    const STATUS_CYCLE = ['Present', 'Absent', 'Leave', 'Late', 'Not recorded'];
    const STATUS_ICONS = {
        'Absent': 'bi-x-circle-fill',
        'Present': 'bi-check-circle-fill',
        'Leave': 'bi-journal-text',
        'Late': 'bi-clock-fill',
        'Not recorded': 'bi-dash-circle'
    };

    function enableAttendanceEditing() {
        document.querySelectorAll('.student-row-card .cycle-btn').forEach(btn => {
            btn.disabled = false;
        });

        document.getElementById('edit-attendance-btn').hidden = true;
        document.querySelectorAll(' .attendance-save-action, .attendance-submit-action, .attendance-mobile-save, .mark-all-present-action')
            .forEach(element => { element.hidden = false; });

        const notice = document.querySelector('.attendance-container .alert');
        if (notice) {
            notice.className = 'alert alert-info';
            notice.querySelector('strong').textContent = 'Editing yesterday’s attendance';
            notice.querySelector('div').textContent = 'Changes will be saved against yesterday’s date.';
        }

        updateAttendanceSummary();
    }

    function cycleStatus(studentId) {
        const card = document.querySelector(`.student-row-card[data-student-id="${studentId}"]`);
        const btn = card.querySelector('.cycle-btn');
        const input = card.querySelector('.status-input');
        
        const currentState = btn.dataset.state;
        const nextIndex = (STATUS_CYCLE.indexOf(currentState) + 1) % STATUS_CYCLE.length;
        const nextState = STATUS_CYCLE[nextIndex];

        // Update data attributes and input
        btn.dataset.state = nextState;
        input.value = nextState;

        // Update UI
        btn.className = `cycle-btn btn-status-${nextState.toLowerCase()}`;
        btn.querySelector('i').className = `bi ${STATUS_ICONS[nextState]}`;
        btn.querySelector('.status-label').textContent = nextState;
        btn.setAttribute('aria-label', 'Attendance status for ' + card.querySelector('.row-name').textContent.trim() + ': ' + nextState + '. Activate to change status.');
        updateAttendanceSummary();
    }

    function updateAttendanceSummary() {
        const counts = { Present: 0, Absent: 0, Late: 0, Leave: 0, 'Not recorded': 0 };
        document.querySelectorAll('.student-row-card .cycle-btn').forEach(btn => {
            const state = btn.dataset.state;
            if (Object.prototype.hasOwnProperty.call(counts, state)) counts[state] += 1;
        });

        const summary = document.getElementById('attendance-status-summary');
        if (!summary) return;
        summary.innerHTML = Object.entries(counts).map(([label, count]) =>
            '<span class="attendance-status-chip"><strong>' + count + '</strong> ' + label + '</span>'
        ).join('');
    }

    function markAllPresent() {
        const cards = document.querySelectorAll('.student-row-card');
        const needsChange = Array.from(cards).some(card => card.querySelector('.cycle-btn').dataset.state !== 'Present');
        if (needsChange && !window.confirm('Mark all ' + cards.length + ' students as Present? This will replace their current statuses.')) return;

        cards.forEach(card => {
            const btn = card.querySelector('.cycle-btn');
            const input = card.querySelector('.status-input');
            const nextState = 'Present';
            btn.dataset.state = nextState;
            input.value = nextState;
            btn.className = `cycle-btn btn-status-${nextState.toLowerCase()}`;
            btn.querySelector('i').className = `bi ${STATUS_ICONS[nextState]}`;
            btn.querySelector('.status-label').textContent = nextState;
            btn.setAttribute('aria-label', 'Attendance status for ' + card.querySelector('.row-name').textContent.trim() + ': Present. Activate to change status.');
        });
        updateAttendanceSummary();
    }

    updateAttendanceSummary();

    const reopenButton = document.getElementById('reopen-register-btn');
    if (reopenButton) reopenButton.addEventListener('click', async () => {
        const reason = window.prompt('Explain why this submitted register must be corrected:');
        if (!reason || !reason.trim()) return;
        reopenButton.disabled = true;
        try {
            const form = document.getElementById('attendance-form');
            const payload = Object.fromEntries(new FormData(form).entries());
            payload.reason = reason.trim();
            const response = await fetch('/attendance/reopen', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(payload) });
            const result = await response.json();
            if (!response.ok || !result.success) throw new Error(result.message || 'Could not reopen register.');
            window.location.reload();
        } catch (error) { alert(error.message); reopenButton.disabled = false; }
    });

    document.getElementById('attendance-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const operation = e.submitter && e.submitter.dataset.attendanceOperation === 'submit' ? 'submit' : 'draft';
        const submitBtns = document.querySelectorAll('button[form="attendance-form"]');
        const originalTexts = Array.from(submitBtns).map(btn => btn.innerHTML);

        submitBtns.forEach(btn => { btn.disabled = true; });
        if (e.submitter) e.submitter.innerHTML = operation === 'submit' ? 'Submitting...' : 'Saving...';

        const formData = new FormData(e.target);
        const data = {
            class_id: formData.get('class_id'),
            date: formData.get('date'),
            session: formData.get('session'),
            term: formData.get('term'),
            operation,
            attendance: {},
            reasons: {},
            custom_reasons: {}
        };

        for (let [key, value] of formData.entries()) {
            const match = key.match(/^(attendance|reasons|custom_reasons)\[(\d+)\]$/);
            if (match) data[match[1]][match[2]] = value;
        }

        try {
            const endpoint = operation === 'submit' ? '/attendance/submit' : '/attendance/save';
            const res = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(data)
            });
            
            // Check if we were redirected to login (session expired)
            if (res.url.includes('/auth/login')) {
                alert('Session expired. Please log in again.');
                window.location.href = '/auth/login';
                return;
            }

            const text = await res.text();
            let result;
            try {
                result = JSON.parse(text);
            } catch (e) {
                console.error('Invalid JSON response:', text);
                alert('System Error: Server returned invalid format.\n\nResponse preview: ' + text.substring(0, 200));
                return;
            }

            if (result.success) {
                if (operation === 'submit') { alert('Attendance register submitted successfully and is now locked.'); window.location.reload(); return; }
                document.getElementById('feedbackModal').style.display = 'flex';
            } else {
                alert('Server Error: ' + (result.message || 'Unknown error occurred'));
            }
        } catch (err) {
            console.warn('[AcadMe Offline] Attendance save request failed; queueing locally.', err);
            try {
                const offline = window.AcadMeOffline || window.NexusOffline;
                if (!offline || typeof offline.saveAttendanceOffline !== 'function') {
                    throw new Error('Offline storage is unavailable. Reconnect before leaving this page.');
                }
                await offline.saveAttendanceOffline(data);
                alert(operation === 'submit' ? 'Submission request saved on this device. It remains pending and is NOT submitted until the server confirms it.' : 'Attendance draft saved on this device. It is pending sync and has not yet been saved to the school database.');
            } catch (queueError) {
                alert('Could not save attendance offline: ' + queueError.message + '. Keep this page open and reconnect before leaving.');
            }
        } finally {
            submitBtns.forEach((btn, index) => { btn.disabled = false; btn.innerHTML = originalTexts[index]; });
        }
    });
</script>


<script>
    // Reuse a prepared class sheet for the selected date while offline.
    (() => {
        const requestedDate = new URLSearchParams(window.location.search).get('date');
        const dateInput = document.querySelector('#attendance-form [name="date"]');
        if (requestedDate && dateInput && /^\d{4}-\d{2}-\d{2}$/.test(requestedDate)) {
            dateInput.value = requestedDate;
            const label = document.getElementById('attendance-date-label');
            if (label) {
                const d = new Date(requestedDate + 'T12:00:00');
                label.innerHTML = '<i class="bi bi-calendar-event"></i> ' + d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            }
        }
    })();
</script>

<%- include('../partials/footer') %>