<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title><%= title %></title>
<link rel="stylesheet" href="/css/acadme-tokens.css"><link rel="stylesheet" href="/css/portal-login.css"><link rel="stylesheet" href="/css/role-login-refresh.css?v=7"><link rel="stylesheet" href="/css/acadme-indigo-amber-theme.css?v=1.0">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="manifest" href="/manifest.json"><meta name="theme-color" content="#4338ca"><link rel="apple-touch-icon" href="/img/logo-512.png">
<link rel="stylesheet" href="/css/pwa-prompt.css"><script src="/js/pwa-installer.js" defer></script>
<link rel="stylesheet" href="/css/acadme-bidi.css?v=1.0">\n<script src="/js/acadme-bidi.js?v=1.0" defer></script>\n</head>
<body>
<main class="acm-login-page acm-role-login-page" role="main">
<% const configuredLoginLogo = (typeof school !== 'undefined' && school && school.school_logo) ? String(school.school_logo).trim() : ''; const loginLogoSrc = configuredLoginLogo ? ((configuredLoginLogo.startsWith('/') || configuredLoginLogo.startsWith('http')) ? configuredLoginLogo : '/uploads/' + configuredLoginLogo) : ''; %>
<header class="acm-login-hero"><div class="acm-login-mark" aria-label="<%= school && school.school_name ? school.school_name : 'School' %> logo"><% if (loginLogoSrc) { %><img src="<%= loginLogoSrc %>" alt="<%= school && school.school_name ? school.school_name : 'School' %> logo" class="acm-login-school-logo"><% } else { %><i class="bi bi-mortarboard" aria-hidden="true"></i><% } %></div><p class="acm-portal-label">Staff Portal</p><h1 class="acm-school-name"><%= (typeof school !== 'undefined' && school && school.school_name) ? school.school_name : 'AcadMe' %></h1></header>
<section class="acm-login-card" aria-label="Staff login form">
<nav class="acm-role-switch" aria-label="Choose portal"><a href="/auth/student-login">Student</a><a class="is-active" href="/auth/login" aria-current="page">Staff</a></nav>
<div class="acm-welcome"><h2 class="acm-welcome-heading">Welcome back</h2><p class="acm-welcome-sub">Enter your credentials to access the system.</p></div>
<% if (error) { %><div class="acm-alert acm-alert--error" role="alert" aria-live="polite"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i><span><%= error %></span></div><% } %>
<form action="/auth/login" method="POST" class="acm-staff-login-form" autocomplete="on">
<div class="acm-form-group"><label class="acm-label" for="staff_id">Staff ID</label><div class="acm-input-wrap"><i class="bi bi-person-badge acm-field-icon" aria-hidden="true"></i><input class="acm-input acm-input--with-leading-icon" type="text" id="staff_id" name="staff_id" placeholder="e.g. admin" required autocomplete="username" autocapitalize="none" spellcheck="false"></div></div>
<div class="acm-form-group"><label class="acm-label" for="password">Password</label><div class="acm-input-wrap"><i class="bi bi-key acm-field-icon" aria-hidden="true"></i><input class="acm-input acm-input--password acm-input--with-leading-icon" type="password" id="password" name="password" placeholder="Enter your password" required autocomplete="current-password"><button type="button" class="acm-toggle-pwd" id="toggle-pwd-btn" aria-label="Show password" aria-controls="password" aria-pressed="false"><i class="bi bi-eye" id="toggle-pwd-icon" aria-hidden="true"></i></button></div></div>
<button type="submit" class="acm-btn acm-btn--primary acm-login-submit" id="login-btn"><span class="acm-spinner" id="login-spinner" aria-hidden="true"></span><span id="login-btn-text">Log in</span><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
</form>
</section><p class="acm-page-footer">Powered by <strong>AcadMe</strong></p>
</main>
<script>
(function(){var input=document.getElementById('password'),button=document.getElementById('toggle-pwd-btn'),icon=document.getElementById('toggle-pwd-icon');button.addEventListener('click',function(){var show=input.type==='password';input.type=show?'text':'password';icon.className=show?'bi bi-eye-slash':'bi bi-eye';button.setAttribute('aria-label',show?'Hide password':'Show password');button.setAttribute('aria-pressed',String(show));});}());
</script>
</body></html>