<%- include('../partials/header') %>

    <div class="login-page acadme-staff-login-page">
        <div class="login-card">
            <div class="login-header">
                <div class="login-logo">
                    <% if (typeof school !== 'undefined' && school && school.school_logo && school.school_logo !== '/img/logo.png') { %>
                        <img src="<%= school.school_logo %>" alt="School Logo" class="acadme-login-school-logo">
                    <% } else { %>
                        <i class="bi bi-shield-lock-fill"></i>
                    <% } %>
                </div>
                <h1>Staff Portal</h1>
                <p>Enter your credentials to access the system</p>
            </div>

            <% if (error) { %>
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <%= error %>
                </div>
            <% } %>

            <form action="/auth/login" method="POST" class="enroll-form">
                <div class="form-group">
                    <label for="staff_id">Staff ID</label>
                    <div class="input-with-icon">
                        <i class="bi bi-person-badge"></i>
                        <input type="text" id="staff_id" name="staff_id" placeholder="e.g. admin" required
                            autocomplete="username" autocapitalize="none" spellcheck="false" class="form-control">
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="input-with-icon">
                        <i class="bi bi-key-fill"></i>
                        <input type="password" id="password" name="password" placeholder="••••••••" required
                            autocomplete="current-password" class="form-control">
                        <button type="button" class="toggle-pwd-btn" onclick="togglePwd()" aria-label="Toggle password">
                            <i class="bi bi-eye" id="pwd-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-block"
                    class="btn btn-primary btn-block acadme-login-submit">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In to Portal
                </button>
            </form>

            <div class="login-footer">
                <p>Student? <a href="/auth/student-login">Access Student Portal →</a></p>
            </div>
        </div>
    </div>


    <script>
        function togglePwd() {
            const input = document.getElementById('password');
            const icon  = document.getElementById('pwd-eye');
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            icon.className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
        }
    </script>

    <%- include('../partials/footer') %>