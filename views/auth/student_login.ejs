<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= title %></title>

    <!-- AcadMe Design Tokens (must load first) -->
    <link rel="stylesheet" href="/css/acadme-tokens.css">
    <!-- Login page styles -->
    <link rel="stylesheet" href="/css/portal-login.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts — Plus Jakarta Sans (Latin + extended; Arabic via system fallback) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#001C2C">

    <%
        /*
         * School branding override
         * The settingsMiddleware injects res.locals.school globally.
         * Primary / secondary colours from the settings table
         * override the default AcadMe accent tokens at runtime.
         * Core neutrals (navy, bg, surface, text, borders) remain fixed
         * to preserve contrast and accessibility.
         */
        const schoolPrimary   = (typeof school !== 'undefined' && school && school.primary_color)   ? school.primary_color   : '#001C2C';
        const schoolSecondary = (typeof school !== 'undefined' && school && school.secondary_color) ? school.secondary_color : '#FBBA00';
    %>
    <style>
        :root {
            /* School accent overrides — keep in sync with branding system */
            --school-primary:   <%= schoolPrimary %>;
            --school-secondary: <%= schoolSecondary %>;
        }
        /* Use school primary for the login button if it has sufficient contrast */
        .acm-btn--primary {
            background-color: var(--school-primary, #001C2C);
        }
        .acm-btn--primary:hover:not(:disabled) {
            filter: brightness(1.08);
        }
    </style>
</head>
<body>

<main class="acm-login-page" role="main">

    <div class="acm-login-card" aria-label="Student login form">

        <!-- ======================================================
             BRAND BLOCK
             School logo → School name → "Student Portal" label
             ====================================================== -->
        <div class="acm-brand">
            <%
                const hasLogo = typeof school !== 'undefined'
                    && school
                    && school.school_logo
                    && school.school_logo.trim() !== ''
                    && school.school_logo !== '/img/logo.png';

                const schoolName = (typeof school !== 'undefined' && school && school.school_name)
                    ? school.school_name
                    : 'AcadMe';

                /* First letter of school name for fallback avatar */
                const logoInitial = schoolName.trim().charAt(0).toUpperCase();
            %>

            <% if (hasLogo) { %>
                <div class="acm-school-logo" aria-hidden="true">
                    <img
                        src="<%= school.school_logo %>"
                        alt="<%= schoolName %> logo"
                        loading="eager"
                        onerror="this.parentElement.style.display='none'; document.getElementById('logo-fallback').style.display='flex';"
                    >
                </div>
                <!-- Hidden fallback in case image fails to load -->
                <div class="acm-school-logo-fallback" id="logo-fallback" aria-hidden="true" style="display:none;">
                    <%= logoInitial %>
                </div>
            <% } else { %>
                <div class="acm-school-logo-fallback" aria-hidden="true">
                    <%= logoInitial %>
                </div>
            <% } %>

            <p class="acm-portal-label">Student Portal</p>
            <h1 class="acm-school-name"><%= schoolName %></h1>
        </div>

        <!-- ======================================================
             WELCOME HEADING
             ====================================================== -->
        <div class="acm-welcome">
            <h2 class="acm-welcome-heading">Welcome back</h2>
            <p class="acm-welcome-sub">Sign in to continue.</p>
        </div>

        <!-- ======================================================
             SERVER-SIDE FLASH MESSAGES
             ====================================================== -->
        <% if (error) { %>
            <div class="acm-alert acm-alert--error" role="alert" aria-live="polite">
                <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="acm-alert acm-alert--success" role="status" aria-live="polite">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <span><%= success %></span>
            </div>
        <% } %>

        <!-- ======================================================
             LOGIN FORM
             Field name "admission_number" preserved for backend
             compatibility. Users see it as "Student ID".
             ====================================================== -->
        <form
            id="student-login-form"
            action="/auth/student-login"
            method="POST"
            novalidate
            autocomplete="on"
        >
            <!-- Student ID -->
            <div class="acm-form-group">
                <label class="acm-label" for="admission_number">
                    Student ID
                </label>
                <div class="acm-input-wrap">
                    <input
                        class="acm-input"
                        type="text"
                        id="admission_number"
                        name="admission_number"
                        inputmode="numeric"
                        pattern="[0-9]*"
                        placeholder="e.g. 836572"
                        autocomplete="username"
                        autocorrect="off"
                        autocapitalize="off"
                        spellcheck="false"
                        aria-describedby="admission-error"
                        aria-required="true"
                        autofocus
                    >
                </div>
                <!-- Client-side validation error -->
                <p class="acm-input-error" id="admission-error" role="alert" aria-live="polite">
                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                    <span id="admission-error-text">Please enter your Student ID.</span>
                </p>
            </div>

            <!-- Password -->
            <div class="acm-form-group">
                <label class="acm-label" for="password">
                    Password
                </label>
                <div class="acm-input-wrap">
                    <input
                        class="acm-input acm-input--password"
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        aria-describedby="password-error"
                        aria-required="true"
                    >
                    <button
                        type="button"
                        class="acm-toggle-pwd"
                        id="toggle-pwd-btn"
                        aria-label="Show password"
                        aria-controls="password"
                        aria-pressed="false"
                        tabindex="0"
                    >
                        <i class="bi bi-eye" aria-hidden="true" id="toggle-pwd-icon"></i>
                    </button>
                </div>
                <!-- Client-side validation error -->
                <p class="acm-input-error" id="password-error" role="alert" aria-live="polite">
                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                    <span id="password-error-text">Please enter your password.</span>
                </p>
            </div>

            <!-- Submit button -->
            <button
                type="submit"
                class="acm-btn acm-btn--primary"
                id="login-btn"
            >
                <span class="acm-spinner" id="login-spinner" aria-hidden="true"></span>
                <span id="login-btn-text">Log in</span>
            </button>
        </form>

        <!-- ======================================================
             FORGOT PASSWORD
             ====================================================== -->
        <p class="acm-forgot">
            Forgot password? Contact your class teacher for a password reset.
        </p>

    </div><!-- /.acm-login-card -->

    <!-- ======================================================
         PAGE FOOTER — AcadMe product identity
         Subordinate to school branding above.
         ====================================================== -->
    <p class="acm-page-footer">
        Powered by <strong>AcadMe</strong>
    </p>

</main><!-- /.acm-login-page -->

<!-- ======================================================
     CLIENT-SIDE SCRIPTS
     ====================================================== -->
<script>
(function () {
    'use strict';

    /* --------------------------------------------------------
       DOM REFERENCES
       -------------------------------------------------------- */
    var form         = document.getElementById('student-login-form');
    var idInput      = document.getElementById('admission_number');
    var pwdInput     = document.getElementById('password');
    var loginBtn     = document.getElementById('login-btn');
    var loginSpinner = document.getElementById('login-spinner');
    var loginBtnText = document.getElementById('login-btn-text');
    var toggleBtn    = document.getElementById('toggle-pwd-btn');
    var toggleIcon   = document.getElementById('toggle-pwd-icon');

    var admissionError     = document.getElementById('admission-error');
    var admissionErrorText = document.getElementById('admission-error-text');
    var passwordError      = document.getElementById('password-error');

    /* --------------------------------------------------------
       PASSWORD SHOW / HIDE
       Accessible: aria-label and aria-pressed update on toggle.
       -------------------------------------------------------- */
    toggleBtn.addEventListener('click', function () {
        var isHidden = pwdInput.type === 'password';
        pwdInput.type = isHidden ? 'text' : 'password';
        toggleIcon.className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
        toggleBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
        toggleBtn.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
    });

    /* --------------------------------------------------------
       CLEAR VALIDATION STATE ON INPUT
       -------------------------------------------------------- */
    function clearError(input, errorEl) {
        input.classList.remove('is-error');
        errorEl.classList.remove('is-visible');
    }

    idInput.addEventListener('input', function () {
        clearError(idInput, admissionError);
    });

    pwdInput.addEventListener('input', function () {
        clearError(pwdInput, passwordError);
    });

    /* --------------------------------------------------------
       CLIENT-SIDE VALIDATION
       -------------------------------------------------------- */
    function validateStudentId(value) {
        var trimmed = value.trim();
        if (trimmed === '') {
            return { valid: false, message: 'Please enter your Student ID.' };
        }
        /* A Student ID is numeric. Warn if it contains non-numeric chars
           but don't block — the server validates authoritative data. */
        if (!/^\d+$/.test(trimmed)) {
            return { valid: false, message: 'Invalid Student ID. Please enter a numeric ID.' };
        }
        return { valid: true };
    }

    function validatePassword(value) {
        if (value === '') {
            return { valid: false, message: 'Please enter your password.' };
        }
        return { valid: true };
    }

    function showError(input, errorEl, errorTextEl, message) {
        input.classList.add('is-error');
        errorTextEl.textContent = message;
        errorEl.classList.add('is-visible');
        input.focus();
    }

    /* --------------------------------------------------------
       LOADING STATE HELPERS
       -------------------------------------------------------- */
    var isSubmitting = false;

    function setLoading(loading) {
        isSubmitting = loading;
        loginBtn.disabled = loading;
        loginBtn.classList.toggle('acm-btn--loading', loading);
        loginSpinner.style.display = loading ? 'inline-block' : 'none';
        loginBtnText.textContent = loading ? 'Signing in\u2026' : 'Log in';
    }

    /* --------------------------------------------------------
       FORM SUBMIT HANDLER
       -------------------------------------------------------- */
    form.addEventListener('submit', function (e) {
        /* Prevent duplicate submissions */
        if (isSubmitting) {
            e.preventDefault();
            return;
        }

        var idVal  = idInput.value;
        var pwdVal = pwdInput.value;

        /* Validate Student ID */
        var idCheck = validateStudentId(idVal);
        if (!idCheck.valid) {
            e.preventDefault();
            showError(idInput, admissionError, admissionErrorText, idCheck.message);
            return;
        }

        /* Validate Password */
        var pwdCheck = validatePassword(pwdVal);
        if (!pwdCheck.valid) {
            e.preventDefault();
            showError(pwdInput, passwordError, document.getElementById('password-error-text'), pwdCheck.message);
            return;
        }

        /* All good — show loading state and submit */
        setLoading(true);

        /* Network error detection — reset UI if server never responds */
        var networkTimeout = setTimeout(function () {
            if (isSubmitting) {
                setLoading(false);
                /* Inject a network error alert above the form */
                var existing = document.getElementById('network-alert');
                if (!existing) {
                    var alert = document.createElement('div');
                    alert.id = 'network-alert';
                    alert.className = 'acm-alert acm-alert--error';
                    alert.setAttribute('role', 'alert');
                    alert.innerHTML =
                        '<i class="bi bi-wifi-off" aria-hidden="true"></i>' +
                        '<span>Unable to connect. Please check your internet connection and try again.</span>';
                    form.insertAdjacentElement('beforebegin', alert);
                }
            }
        }, 15000); /* 15 s timeout */

        /* Clear timeout when the page actually navigates (server responded) */
        window.addEventListener('pagehide', function () {
            clearTimeout(networkTimeout);
        });
    });

})();
</script>

</body>
</html>
