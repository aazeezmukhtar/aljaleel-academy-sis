<%- include('partials/header') %>
<%
    const attendanceAvailable = stats.attendance !== 'N/A' && stats.attendance !== 'Pending';
    const attendanceValue = attendanceAvailable ? Math.min(100, Math.max(0, Number.parseFloat(stats.attendance) || 0)) : 0;
    const revenueValue = Math.min(100, Math.max(0, Number(stats.revenuePercentage) || 0));
    const maleCount = Number(stats.genderSummary.Male) || 0;
    const femaleCount = Number(stats.genderSummary.Female) || 0;
    const genderTotal = maleCount + femaleCount;
    const maleShare = genderTotal ? (maleCount / genderTotal) * 100 : 0;
%>
<div class="dashboard-container admin-dashboard">
    <%- include('partials/sidebar') %>
    <main class="main-content admin-dashboard-main">
        <header class="admin-welcome-header">
            <div class="admin-welcome-copy">
                <span class="admin-eyebrow">ADMIN</span>
                <h1>Welcome back, Admin</h1>
                <p><%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            </div>
            <div class="admin-dashboard-tools">
                <div class="notification-bell-container" role="button" tabindex="0" aria-label="Open notifications" aria-haspopup="true" aria-expanded="false" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleNotificationDropdown(event); }" onclick="toggleNotificationDropdown(event)">
                    <i class="bi bi-bell-fill" aria-hidden="true"></i>
                    <span class="notification-badge">0</span>
                    <div class="notification-dropdown">
                        <div class="notification-header"><strong>Notifications</strong><span class="text-muted">Recent Updates</span></div>
                        <div class="notification-list"></div>
                    </div>
                </div>
            </div>
        </header>

        <section class="admin-attendance-hero" aria-label="Today's attendance">
            <div class="admin-attendance-copy">
                <span>Attendance today</span>
                <strong><%= attendanceAvailable ? stats.attendance : '—' %></strong>
                <a href="/attendance">View attendance</a>
            </div>
            <div class="admin-attendance-ring" role="img" aria-label="<%= attendanceAvailable ? stats.attendance + ' attendance' : 'Attendance not available' %>" style="--attendance-progress: <%= attendanceValue %>%;">
                <span><%= attendanceAvailable ? Math.round(attendanceValue) + '%' : '—' %></span>
            </div>
        </section>

        <section class="admin-overview-grid" aria-label="School overview">
            <article class="admin-overview-card">
                <span class="admin-overview-icon admin-icon-amber"><i class="bi bi-people" aria-hidden="true"></i></span>
                <strong><%= stats.totalStudents %></strong>
                <span>Total students</span>
            </article>
            <article class="admin-overview-card">
                <span class="admin-overview-icon admin-icon-green"><i class="bi bi-person-vcard" aria-hidden="true"></i></span>
                <strong><%= stats.activeStaff %></strong>
                <span>Active staff</span>
            </article>
            <article class="admin-overview-card">
                <span class="admin-overview-icon admin-icon-violet"><i class="bi bi-book" aria-hidden="true"></i></span>
                <strong><%= stats.totalSubjects %></strong>
                <span>Active subjects</span>
            </article>
            <article class="admin-overview-card admin-revenue-card">
                <div class="admin-revenue-heading">
                    <span class="admin-overview-icon admin-icon-green"><i class="bi bi-credit-card" aria-hidden="true"></i></span>
                    <small>Collected</small>
                </div>
                <strong><%= revenueValue %>%</strong>
                <div class="admin-revenue-track" role="progressbar" aria-label="Revenue collection" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= revenueValue %>">
                    <span style="width: <%= revenueValue %>%"></span>
                </div>
                <span>Revenue collection</span>
            </article>
        </section>

        <section class="admin-gender-card" aria-label="Students by gender">
            <div class="admin-gender-heading"><span>Students by gender</span><span><%= stats.totalStudents %> total</span></div>
            <div class="admin-gender-counts">
                <strong class="admin-male-count"><%= maleCount %> M</strong>
                <strong class="admin-female-count"><%= femaleCount %> F</strong>
            </div>
            <div class="admin-gender-track" role="img" aria-label="<%= maleCount %> male and <%= femaleCount %> female students">
                <span class="admin-gender-male" style="width: <%= maleShare %>%"></span>
                <span class="admin-gender-female" style="width: <%= 100 - maleShare %>%"></span>
            </div>
        </section>

        <section class="admin-quick-actions" aria-labelledby="adminQuickActionsHeading">
            <h2 id="adminQuickActionsHeading">Quick actions</h2>
            <div class="admin-actions-grid">
                <a href="/attendance" class="admin-action-card">
                    <span class="admin-action-icon admin-action-blue"><i class="bi bi-calendar2-check" aria-hidden="true"></i></span>
                    <strong>Mark attendance</strong><small>Daily presence tracking</small>
                </a>
                <a href="/fees/manager" class="admin-action-card">
                    <span class="admin-action-icon admin-action-amber"><i class="bi bi-credit-card" aria-hidden="true"></i></span>
                    <strong>Record fees</strong><small>Manage student payments</small>
                </a>
                <a href="/students/enroll" class="admin-action-card">
                    <span class="admin-action-icon admin-action-green"><i class="bi bi-person-plus" aria-hidden="true"></i></span>
                    <strong>New admission</strong><small>Enroll new students</small>
                </a>
                <a href="/results" class="admin-action-card">
                    <span class="admin-action-icon admin-action-red"><i class="bi bi-bar-chart" aria-hidden="true"></i></span>
                    <strong>Result entry</strong><small>Input student scores</small>
                </a>
            </div>
        </section>

        <div class="admin-dashboard-lower-grid">
            <section class="admin-dashboard-panel admin-enrollments-panel">
                <div class="admin-panel-heading"><h2>Recent enrollments</h2><a href="/students">View all</a></div>
                <div class="admin-enrollment-list">
                    <% if (recentEnrollments && recentEnrollments.length > 0) { %>
                        <% recentEnrollments.forEach(enrollment => { %>
                            <div class="admin-enrollment-row">
                                <span class="admin-enrollment-avatar"><%= (enrollment.first_name || '?').charAt(0).toUpperCase() %><%= (enrollment.last_name || '').charAt(0).toUpperCase() %></span>
                                <span class="admin-enrollment-details">
                                    <strong><%= enrollment.first_name %> <%= enrollment.last_name %></strong>
                                    <small><%= enrollment.class_name || 'Unassigned' %> · <%= enrollment.admission_date ? new Date(enrollment.admission_date).toLocaleDateString() : 'Date unavailable' %></small>
                                </span>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="admin-empty-message"><i class="bi bi-inbox" aria-hidden="true"></i>No recent enrollments found.</p>
                    <% } %>
                </div>
            </section>

            <div class="admin-dashboard-side-panels">
                <section class="admin-dashboard-panel">
                    <div class="admin-panel-heading"><h2>Finance &amp; fees</h2><a href="/fees/setup">Setup</a></div>
                    <p class="admin-panel-description">Manage fee structures, payments and outstanding balances.</p>
                    <a class="admin-panel-link" href="/fees/manager"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> View balances</a>
                </section>
                <section class="admin-dashboard-panel">
                    <div class="admin-panel-heading"><h2>School activity</h2><a href="/announcements">Manage</a></div>
                    <div class="admin-activity-list" id="adminActivityFeed">
                        <% if (announcements && announcements.length > 0) { %>
                            <% announcements.forEach((post, index) => { %>
                                <a href="/announcements/view/<%= post.id %>" class="admin-activity-item announcement-card <%= index >= 3 ? 'hidden' : '' %>" data-id="<%= post.id %>">
                                    <span class="admin-activity-meta"><%= new Date(post.created_at).toLocaleDateString() %> · <%= post.type === 'Event' ? 'EVENT' : 'UPDATE' %></span>
                                    <strong class="post-title"><%= post.title %></strong>
                                    <span class="post-content"><%= post.content %></span>
                                </a>
                            <% }); %>
                            <% if (announcements.length > 3) { %>
                                <button type="button" class="btn-view-more" aria-expanded="false" aria-controls="adminActivityFeed" onclick="toggleViewMore('adminActivityFeed', this)">View more updates</button>
                            <% } %>
                        <% } else { %>
                            <p class="admin-empty-message">No recent activities.</p>
                        <% } %>
                    </div>
                </section>
                <section class="admin-dashboard-panel">
                    <div class="admin-panel-heading"><h2>Term calendar</h2><a href="/calendar">View all</a></div>
                    <% if (locals.upcomingEvents && upcomingEvents.length > 0) { %>
                        <% upcomingEvents.forEach(event => { %>
                            <div class="admin-calendar-row">
                                <span class="admin-calendar-date"><small><%= new Date(event.event_date).toLocaleDateString('en-US', { month: 'short' }) %></small><strong><%= new Date(event.event_date).getDate() %></strong></span>
                                <span><strong><%= event.title %></strong><small><%= event.type || 'Event' %></small></span>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="admin-empty-message">No upcoming events scheduled.</p>
                    <% } %>
                </section>
            </div>
        </div>
    </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    let readPosts = [];
    try {
        const stored = JSON.parse(localStorage.getItem('read_announcements') || '[]');
        if (Array.isArray(stored)) readPosts = stored.map(String);
    } catch (error) {
        // The activity feed remains available when browser storage is unavailable.
    }
    document.querySelectorAll('.announcement-card').forEach(card => {
        const postId = String(card.dataset.id || '');
        if (readPosts.includes(postId)) card.classList.add('read');
        card.addEventListener('click', () => {
            if (!postId || readPosts.includes(postId)) return;
            readPosts.push(postId);
            try { localStorage.setItem('read_announcements', JSON.stringify(readPosts)); } catch (error) { /* optional enhancement */ }
        });
    });
});
</script>
<%- include('partials/footer') %>
