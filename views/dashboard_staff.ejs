<%- include('partials/header') %>
<%
    const attendanceText = stats.attendanceToday === 'Pending' || stats.attendanceToday === 'N/A'
        ? '—' : stats.attendanceToday;
%>
<div class="dashboard-container staff-dashboard">
    <%- include('partials/sidebar') %>
    <main class="main-content staff-dashboard-main">
        <header class="staff-welcome-header">
            <div class="staff-welcome-copy">
                <span class="staff-eyebrow"><%= user.role || 'STAFF' %></span>
                <h1>Welcome, <%= user.first_name %></h1>
                <p><%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            </div>
            <div class="header-actions">
                <div class="notification-bell-container" role="button" tabindex="0" aria-label="Open notifications" aria-haspopup="true" aria-expanded="false" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleNotificationDropdown(event); }" onclick="toggleNotificationDropdown(event)">
                    <i class="bi bi-bell-fill" aria-hidden="true"></i>
                    <span class="notification-badge">0</span>
                    <div class="notification-dropdown">
                        <div class="notification-header"><strong>Notifications</strong><span class="text-muted">Recent Updates</span></div>
                        <div class="notification-list"></div>
                    </div>
                </div>
            </div>
        </header>

        <section class="staff-overview-grid" aria-label="My teaching overview">
            <article class="staff-overview-card">
                <span class="staff-overview-icon staff-icon-violet"><i class="bi bi-door-open" aria-hidden="true"></i></span>
                <strong><%= stats.assignedClasses %></strong><span>Assigned classes</span>
            </article>
            <article class="staff-overview-card">
                <span class="staff-overview-icon staff-icon-green"><i class="bi bi-book" aria-hidden="true"></i></span>
                <strong><%= stats.assignedSubjects %></strong><span>Assigned subjects</span>
            </article>
            <article class="staff-overview-card">
                <span class="staff-overview-icon staff-icon-amber"><i class="bi bi-people" aria-hidden="true"></i></span>
                <strong><%= stats.myStudents %></strong><span>Total students</span>
            </article>
            <article class="staff-overview-card">
                <span class="staff-overview-icon staff-icon-pink"><i class="bi bi-calendar-check" aria-hidden="true"></i></span>
                <strong><%= attendanceText %></strong><span>Attendance today</span>
            </article>
        </section>

        <section class="staff-dashboard-panel staff-classes-panel" aria-labelledby="staffClassesHeading">
            <div class="staff-panel-heading">
                <h2 id="staffClassesHeading">My classes</h2>
                <a class="staff-panel-action" href="/attendance">Take attendance</a>
            </div>
            <div class="staff-class-list">
                <% if (assignedClasses && assignedClasses.length > 0) { %>
                    <% assignedClasses.forEach(cls => { %>
                        <a class="staff-class-row" href="/students?class_id=<%= cls.id %>">
                            <span class="staff-class-avatar"><%= (cls.name || '?').split(/\s+/).map(part => part.charAt(0)).join('').slice(0, 3).toUpperCase() %></span>
                            <span class="staff-row-copy"><strong><%= cls.name %></strong><small>Class teacher</small></span>
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    <% }); %>
                <% } else { %>
                    <p class="staff-empty-state">No classes assigned yet.</p>
                <% } %>
            </div>
        </section>

        <section class="staff-dashboard-panel staff-subjects-panel" aria-labelledby="staffSubjectsHeading">
            <div class="staff-panel-heading">
                <h2 id="staffSubjectsHeading">My subjects</h2>
                <a class="staff-panel-action" href="/results">Enter results</a>
            </div>
            <div class="staff-subject-list">
                <% if (assignedSubjects && assignedSubjects.length > 0) { %>
                    <% assignedSubjects.forEach(sub => { %>
                        <a class="staff-subject-row" href="/results">
                            <span class="staff-row-copy"><strong><%= sub.name %></strong><small><%= sub.class_name %></small></span>
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    <% }); %>
                <% } else { %>
                    <p class="staff-empty-state">No subjects assigned yet.</p>
                <% } %>
            </div>
            <% if (assignedSubjects && assignedSubjects.length > 6) { %>
                <a class="staff-view-all" href="/results">View all <%= assignedSubjects.length %> subjects</a>
            <% } %>
        </section>

        <section class="staff-dashboard-panel staff-announcements-panel" aria-labelledby="staffAnnouncementsHeading">
            <div class="staff-panel-heading"><h2 id="staffAnnouncementsHeading">Announcements</h2></div>
            <% if (announcements && announcements.length > 0) { %>
                <div class="staff-announcement-list">
                    <% announcements.slice(0, 3).forEach(post => { %>
                        <article class="staff-announcement-card announcement-card" data-id="<%= post.id %>">
                            <div class="staff-announcement-meta">
                                <time datetime="<%= post.created_at %>"><%= new Date(post.created_at).toLocaleDateString() %></time>
                                <span class="staff-announcement-tag"><%= post.type === 'Event' ? 'EVENT' : 'UPDATE' %></span>
                            </div>
                            <h3 class="post-title"><%= post.title %></h3>
                            <p class="post-content"><%= post.content %></p>
                            <a href="/announcements/view/<%= post.id %>">Read more</a>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <p class="staff-empty-state">No recent announcements.</p>
            <% } %>
        </section>
    </main>
</div>
<script>
document.addEventListener('DOMContentLoaded', () => {
    let readPosts = [];
    try {
        const stored = JSON.parse(localStorage.getItem('read_announcements') || '[]');
        if (Array.isArray(stored)) readPosts = stored.map(String);
    } catch (error) { /* Announcements remain available without browser storage. */ }
    document.querySelectorAll('.announcement-card[data-id]').forEach(card => {
        if (readPosts.includes(String(card.dataset.id))) card.classList.add('read');
    });
});
</script>
<%- include('partials/footer') %>