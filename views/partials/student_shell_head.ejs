<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title><%= title %> - AcadMe</title>

<!-- AcadMe Design Tokens -->
<link rel="stylesheet" href="/css/acadme-tokens.css">
<!-- Student Portal Shell CSS -->
<link rel="stylesheet" href="/css/student-portal.css">
<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- PWA -->
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#001C2C">

<% 
    const schoolPrimary   = (typeof school !== 'undefined' && school && school.primary_color)   ? school.primary_color   : '#001C2C';
    const schoolSecondary = (typeof school !== 'undefined' && school && school.secondary_color) ? school.secondary_color : '#FBBA00';
%>
<style>
    :root {
        --school-primary:   <%= schoolPrimary %>;
        --school-secondary: <%= schoolSecondary %>;
    }
</style>