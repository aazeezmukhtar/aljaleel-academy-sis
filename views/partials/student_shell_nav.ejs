<% const currentPath = typeof path !== 'undefined' ? path : '/portal'; %>

<!-- Mobile Bottom Navigation -->
<nav class="acm-bottom-nav" aria-label="Bottom navigation">
    <a href="/portal" class="acm-nav-item <%= currentPath === '/portal' ? 'is-active' : '' %>">
        <i class="bi <%= currentPath === '/portal' ? 'bi-house-door-fill' : 'bi-house-door' %>" aria-hidden="true"></i>
        <span>Home</span>
    </a>
    <a href="/portal/academics" class="acm-nav-item <%= currentPath.startsWith('/portal/academics') ? 'is-active' : '' %>">
        <i class="bi <%= currentPath.startsWith('/portal/academics') ? 'bi-journal-bookmark-fill' : 'bi-journal-bookmark' %>" aria-hidden="true"></i>
        <span>Academics</span>
    </a>
    <a href="/portal/attendance" class="acm-nav-item <%= currentPath.startsWith('/portal/attendance') ? 'is-active' : '' %>">
        <i class="bi <%= currentPath.startsWith('/portal/attendance') ? 'bi-calendar-check-fill' : 'bi-calendar-check' %>" aria-hidden="true"></i>
        <span>Attendance</span>
    </a>
    <a href="/portal/notifications" class="acm-nav-item <%= currentPath.startsWith('/portal/notifications') ? 'is-active' : '' %>">
        <i class="bi <%= currentPath.startsWith('/portal/notifications') ? 'bi-bell-fill' : 'bi-bell' %>" aria-hidden="true"></i>
        <span>Notices</span>
        <% if (typeof individualMessagesCount !== 'undefined' && individualMessagesCount > 0) { %>
            <span class="acm-badge"><%= individualMessagesCount > 9 ? '9+' : individualMessagesCount %></span>
        <% } %>
    </a>
    <a href="/portal/profile" class="acm-nav-item <%= currentPath.startsWith('/portal/profile') ? 'is-active' : '' %>">
        <i class="bi <%= currentPath.startsWith('/portal/profile') ? 'bi-person-fill' : 'bi-person' %>" aria-hidden="true"></i>
        <span>Profile</span>
    </a>
</nav>

<!-- Desktop Sidebar Navigation -->
<aside class="acm-sidebar" aria-label="Sidebar navigation">
    <div class="acm-sidebar-header">
        <% 
            const schoolName = (typeof school !== 'undefined' && school && school.school_name) ? school.school_name : 'AcadMe';
            const hasLogo = typeof school !== 'undefined' && school && school.school_logo && school.school_logo.trim() !== '' && school.school_logo !== '/img/logo.png';
        %>
        <% if (hasLogo) { %>
            <img src="<%= school.school_logo %>" alt="<%= schoolName %> logo" class="acm-sidebar-logo">
        <% } %>
        <span class="acm-sidebar-brand"><%= schoolName %></span>
    </div>

    <nav class="acm-sidebar-nav">
        <a href="/portal" class="acm-sidebar-item <%= currentPath === '/portal' ? 'is-active' : '' %>">
            <i class="bi <%= currentPath === '/portal' ? 'bi-house-door-fill' : 'bi-house-door' %>" aria-hidden="true"></i>
            <span>Home</span>
        </a>
        <a href="/portal/academics" class="acm-sidebar-item <%= currentPath.startsWith('/portal/academics') ? 'is-active' : '' %>">
            <i class="bi <%= currentPath.startsWith('/portal/academics') ? 'bi-journal-bookmark-fill' : 'bi-journal-bookmark' %>" aria-hidden="true"></i>
            <span>Academics</span>
        </a>
        <a href="/portal/attendance" class="acm-sidebar-item <%= currentPath.startsWith('/portal/attendance') ? 'is-active' : '' %>">
            <i class="bi <%= currentPath.startsWith('/portal/attendance') ? 'bi-calendar-check-fill' : 'bi-calendar-check' %>" aria-hidden="true"></i>
            <span>Attendance</span>
        </a>
        <a href="/portal/notifications" class="acm-sidebar-item <%= currentPath.startsWith('/portal/notifications') ? 'is-active' : '' %>">
            <i class="bi <%= currentPath.startsWith('/portal/notifications') ? 'bi-bell-fill' : 'bi-bell' %>" aria-hidden="true"></i>
            <span>Notifications</span>
            <% if (typeof individualMessagesCount !== 'undefined' && individualMessagesCount > 0) { %>
                <span class="acm-badge" style="position: static; margin-inline-start: auto; border: none;"><%= individualMessagesCount > 9 ? '9+' : individualMessagesCount %></span>
            <% } %>
        </a>
    </nav>

    <div class="acm-sidebar-footer">
        <a href="/portal/profile" class="acm-sidebar-item <%= currentPath.startsWith('/portal/profile') ? 'is-active' : '' %>">
            <i class="bi <%= currentPath.startsWith('/portal/profile') ? 'bi-person-fill' : 'bi-person' %>" aria-hidden="true"></i>
            <span>Profile</span>
        </a>
        <a href="/auth/student-logout" class="acm-sidebar-item" style="color: var(--acm-error);">
            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
            <span>Log out</span>
        </a>
    </div>
</aside>