<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <%- include('../partials/student_shell_head') %>
    <link rel="stylesheet" href="/css/notifications.css">
</head>
<body>
<div class="acm-portal-shell">
    <%- include('../partials/student_shell_nav') %>
    <main class="acm-main-content">
        <%- include('../partials/student_shell_header') %>

        <div class="acm-desktop-header">
            <div class="acm-header-greeting">
                <h1 class="acm-greeting-title">School Announcement</h1>
                <p class="acm-greeting-meta"><%= currentTerm %> &middot; <%= currentSession %></p>
            </div>
            <div class="acm-header-actions">
                <a href="/portal/notifications" class="acm-icon-btn" aria-label="Notifications">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                    <% if (individualMessagesCount > 0) { %>
                        <span class="acm-badge"><%= individualMessagesCount > 9 ? '9+' : individualMessagesCount %></span>
                    <% } %>
                </a>
            </div>
        </div>

        <a href="/portal/notifications" class="acm-detail-back-link">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Notifications
        </a>

        <article class="acm-detail-shell">
            <div style="display:flex; gap:var(--acm-sp-8); margin-bottom:var(--acm-sp-12); flex-wrap:wrap;">
                <span class="acm-status-chip acm-status-chip--general">
                    <i class="bi bi-megaphone" aria-hidden="true"></i> <%= (announcement.type || 'Announcement').toUpperCase() %>
                </span>
                <% if (announcement.priority === 'High' || announcement.priority === 'Urgent') { %>
                    <span class="acm-status-chip acm-status-chip--overdue">IMPORTANT</span>
                <% } %>
            </div>

            <h1 class="acm-detail-title"><%= announcement.title %></h1>
            
            <div class="acm-detail-meta">
                <span><i class="bi bi-calendar3" aria-hidden="true"></i> Published on <%= new Date(announcement.created_at).toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                <% if (announcement.target_role) { %>
                    <span><i class="bi bi-people" aria-hidden="true"></i> Audience: <%= announcement.target_role %></span>
                <% } %>
            </div>

            <% if (announcement.image_path) { %>
                <img src="/uploads/<%= announcement.image_path %>" alt="Announcement Media" class="acm-detail-img">
            <% } %>

            <div class="acm-detail-body">
                <%- announcement.content ? announcement.content.replace(/\n/g, '<br>') : '' %>
            </div>
        </article>

    </main>
</div>
<%- include('../partials/student_shell_footer') %>
</body>
</html>
