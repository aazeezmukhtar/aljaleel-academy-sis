<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <%- include('../partials/student_shell_head') %>
    <link rel="stylesheet" href="/css/notifications.css">
</head>
<body>
<div class="acm-portal-shell">
    <%- include('../partials/student_shell_nav') %>
    <main class="acm-main-content">
        <%- include('../partials/student_shell_header') %>

        <div class="acm-desktop-header">
            <div class="acm-header-greeting">
                <h1 class="acm-greeting-title">Class Post &middot; <%= post.subject_name || 'General' %></h1>
                <p class="acm-greeting-meta"><%= currentTerm %> &middot; <%= currentSession %></p>
            </div>
            <div class="acm-header-actions">
                <a href="/portal/notifications" class="acm-icon-btn" aria-label="Notifications">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                    <% if (individualMessagesCount > 0) { %>
                        <span class="acm-badge"><%= individualMessagesCount > 9 ? '9+' : individualMessagesCount %></span>
                    <% } %>
                </a>
            </div>
        </div>

        <a href="/portal/academics/class-board" class="acm-detail-back-link">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Class Board
        </a>

        <% 
            const now = new Date();
            const isAssignment = post.post_type === 'Assignment';
            const isOverdue = isAssignment && post.due_date && new Date(post.due_date) < now;
        %>

        <article class="acm-detail-shell">
            <div style="display:flex; gap:var(--acm-sp-8); margin-bottom:var(--acm-sp-12); flex-wrap:wrap;">
                <% if (post.subject_name) { %>
                    <span class="acm-status-chip acm-status-chip--general">
                        <i class="bi bi-book" aria-hidden="true"></i> <%= post.subject_name %>
                    </span>
                <% } %>
                <% if (isAssignment) { %>
                    <% if (isOverdue) { %>
                        <span class="acm-status-chip acm-status-chip--overdue"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Overdue</span>
                    <% } else { %>
                        <span class="acm-status-chip acm-status-chip--pending"><i class="bi bi-clock" aria-hidden="true"></i> Assignment</span>
                    <% } %>
                <% } %>
            </div>

            <h1 class="acm-detail-title"><%= post.title %></h1>
            
            <div class="acm-detail-meta">
                <span><i class="bi bi-person" aria-hidden="true"></i> Posted by <%= post.first_name %> <%= post.last_name %></span>
                <span><i class="bi bi-calendar3" aria-hidden="true"></i> <%= new Date(post.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                <% if (post.due_date) { %>
                    <span style="font-weight:var(--acm-fw-semibold); color:<%= isOverdue ? 'var(--acm-error)' : 'inherit' %>;">
                        <i class="bi bi-flag" aria-hidden="true"></i> Due: <%= new Date(post.due_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </span>
                <% } %>
            </div>

            <div class="acm-detail-body">
                <%- post.content ? post.content.replace(/\n/g, '<br>') : '' %>
            </div>

            <% if (post.attachment_path) { %>
                <a href="/uploads/<%= post.attachment_path %>" target="_blank" download class="acm-attachment-card">
                    <div style="display:flex; align-items:center; gap:var(--acm-sp-10);">
                        <i class="bi bi-paperclip" style="font-size:1.25rem; color:var(--school-primary, var(--acm-navy));" aria-hidden="true"></i>
                        <div>
                            <div style="font-weight:var(--acm-fw-semibold); font-size:var(--acm-text-sm);">Download Attachment</div>
                            <div style="font-size:var(--acm-text-xs); color:var(--acm-text-muted);">Click to open / download resource</div>
                        </div>
                    </div>
                    <i class="bi bi-download" aria-hidden="true"></i>
                </a>
            <% } %>
        </article>

    </main>
</div>
<%- include('../partials/student_shell_footer') %>
</body>
</html>
