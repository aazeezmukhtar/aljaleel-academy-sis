<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <%- include('../partials/student_shell_head') %>
    <link rel="stylesheet" href="/css/academics.css">
    <link rel="stylesheet" href="/css/attendance.css">
</head>
<body>
<div class="acm-portal-shell">
    <%- include('../partials/student_shell_nav') %>
    <main class="acm-main-content">
        <%- include('../partials/student_shell_header') %>

        <div class="acm-desktop-header">
            <div class="acm-header-greeting">
                <h1 class="acm-greeting-title">Attendance</h1>
                <p class="acm-greeting-meta"><%= student.class_name %><% if (selectedSection) { %> · <%= selectedSection.section_name %><% } %></p>
            </div>
            <div class="acm-header-actions">
                <a href="/portal/notifications" class="acm-icon-btn" aria-label="Notifications">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                    <% if (individualMessagesCount > 0) { %><span class="acm-badge"><%= individualMessagesCount > 9 ? '9+' : individualMessagesCount %></span><% } %>
                </a>
            </div>
        </div>

        <% if (sectionOptions.length > 0) { %>
        <form method="GET" action="/portal/attendance" class="acm-academic-ctx" style="display:flex; flex-wrap:wrap; align-items:end; gap:12px;">
            <% if (sectionOptions.length > 1) { %>
            <label>
                <span>Section</span>
                <select name="section_id" onchange="this.form.submit()">
                    <% sectionOptions.forEach(section => { %>
                    <option value="<%= section.section_id %>" <%= Number(section.section_id) === selectedSectionId ? 'selected' : '' %>><%= section.section_name %></option>
                    <% }) %>
                </select>
            </label>
            <% } else { %>
            <input type="hidden" name="section_id" value="<%= selectedSectionId %>">
            <% } %>
            <% if (selectedSession && selectedTerm) { %>
            <input type="hidden" name="session" value="<%= selectedSession %>">
            <input type="hidden" name="term" value="<%= selectedTerm %>">
            <% } %>
            <% if (classOptions.length > 1) { %>
            <label>
                <span>Class</span>
                <select name="class_id" onchange="this.form.submit()">
                    <% classOptions.forEach(item => { %>
                    <option value="<%= item.class_id %>" <%= Number(item.class_id) === selectedClassId ? 'selected' : '' %>><%= item.class_name %></option>
                    <% }) %>
                </select>
            </label>
            <% } %>
            <noscript><button type="submit">Apply</button></noscript>
        </form>

        <% if (periods.length > 1) { %>
        <div class="acm-term-selector" role="group" aria-label="Select academic term">
            <% periods.forEach(period => { const active = period.session === selectedSession && period.term === selectedTerm; %>
            <a href="?section_id=<%= selectedSectionId %>&session=<%= encodeURIComponent(period.session) %>&term=<%= encodeURIComponent(period.term) %>"
               class="acm-term-btn <%= active ? 'is-active' : '' %>" aria-current="<%= active ? 'true' : 'false' %>">
                <%= period.term %> · <%= period.session %>
            </a>
            <% }) %>
        </div>
        <% } %>

        <% if (analytics) { %>
        <div class="acm-academic-ctx">
            <strong><%= selectedSession %></strong><span class="acm-dot">·</span>
            <span><%= selectedTerm %></span><span class="acm-dot">·</span>
            <strong><%= student.class_name %></strong>
        </div>

        <div class="acm-att-hero-card">
            <div class="acm-att-rate-row">
                <div>
                    <div class="acm-att-rate-number"><%= attendanceRate !== null ? attendanceRate + '%' : '—' %></div>
                    <div class="acm-att-rate-sub">Attendance Rate · <%= selectedTerm %></div>
                </div>
                <div class="acm-att-rate-total">
                    <div class="acm-att-rate-count"><%= presentCount + lateCount + leaveCount %> of <%= totalDays %></div>
                    <div class="acm-att-rate-days">Attendance credits / recorded days</div>
                </div>
            </div>
        </div>

        <div class="acm-perf-summary" style="margin-bottom:var(--acm-sp-20);">
            <div class="acm-metric"><span class="acm-metric-value" style="color:var(--acm-success);"><%= presentCount %></span><span class="acm-metric-label">Present</span></div>
            <div class="acm-metric"><span class="acm-metric-value" style="color:#d97706;"><%= lateCount %></span><span class="acm-metric-label">Late</span></div>
            <div class="acm-metric"><span class="acm-metric-value" style="color:var(--acm-error);"><%= absentCount %></span><span class="acm-metric-label">Absent</span></div>
            <div class="acm-metric"><span class="acm-metric-value" style="color:#0284c7;"><%= leaveCount %></span><span class="acm-metric-label">Approved Leave</span></div>
        </div>

        <% if (counts.missingRegister || counts.draftRegister || counts.missingStudentRecord || counts.unknownAttendanceStatus || analytics.warnings.length) { %>
        <div class="acm-attention-block acm-attention-block--info" style="margin-bottom:var(--acm-sp-20);">
            <div class="acm-attention-content">
                <strong>Some attendance days need attention</strong>
                <p class="acm-attention-text">
                    Missing registers: <%= counts.missingRegister || 0 %> ·
                    Draft registers: <%= counts.draftRegister || 0 %> ·
                    Incomplete student records: <%= counts.missingStudentRecord || 0 %> ·
                    Unrecognized statuses: <%= counts.unknownAttendanceStatus || 0 %>
                </p>
                <% analytics.warnings.forEach(warning => { %><p class="acm-attention-text"><%= warning %></p><% }) %>
            </div>
        </div>
        <% } %>

        <% if (recentAbsence || recentLate) { %>
        <div style="display:flex;flex-direction:column;gap:var(--acm-sp-8);margin-bottom:var(--acm-sp-24);">
            <% if (recentAbsence) { %><div class="acm-attention-block acm-attention-block--warning"><div class="acm-attention-content"><p class="acm-attention-text">Most recent absence: <strong><%= new Date(recentAbsence.date + 'T00:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) %></strong>.</p></div></div><% } %>
            <% if (recentLate) { %><div class="acm-attention-block acm-attention-block--info"><div class="acm-attention-content"><p class="acm-attention-text">Most recent late arrival: <strong><%= new Date(recentLate.date + 'T00:00:00').toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) %></strong>.</p></div></div><% } %>
        </div>
        <% } %>

        <section class="acm-section">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--acm-sp-12);margin-bottom:var(--acm-sp-16);">
                <h2 class="acm-section-title" style="margin:0;">Attendance Records</h2>
                <div class="acm-board-filters" style="margin:0;" role="tablist" aria-label="Attendance view">
                    <a href="?section_id=<%= selectedSectionId %>&session=<%= encodeURIComponent(selectedSession) %>&term=<%= encodeURIComponent(selectedTerm) %>&class_id=<%= selectedClassId %>&view=history" class="acm-filter-btn <%= activeView === 'history' ? 'is-active' : '' %>" role="tab">History</a>
                    <a href="?section_id=<%= selectedSectionId %>&session=<%= encodeURIComponent(selectedSession) %>&term=<%= encodeURIComponent(selectedTerm) %>&class_id=<%= selectedClassId %>&view=calendar&month=<%= calendar.monthStr %>" class="acm-filter-btn <%= activeView === 'calendar' ? 'is-active' : '' %>" role="tab">Calendar</a>
                </div>
            </div>

            <% if (activeView === 'history') { %>
            <div class="acm-board-filters" style="margin-bottom:var(--acm-sp-16);" role="group" aria-label="Filter attendance status">
                <% ['all','present','late','absent','leave'].forEach(status => { %>
                <a href="?section_id=<%= selectedSectionId %>&session=<%= encodeURIComponent(selectedSession) %>&term=<%= encodeURIComponent(selectedTerm) %>&class_id=<%= selectedClassId %>&view=history&status=<%= status %>"
                   class="acm-filter-btn <%= selectedFilter === status ? 'is-active' : '' %>"><%= status.charAt(0).toUpperCase() + status.slice(1) %></a>
                <% }) %>
            </div>
            <% if (filteredRecords.length) { %>
            <div class="acm-att-history-list" role="list">
                <% filteredRecords.forEach(record => { const lower = record.status.toLowerCase(); const d = new Date(record.date + 'T00:00:00'); %>
                <div class="acm-att-history-row" role="listitem">
                    <div class="acm-att-date-group">
                        <span class="acm-att-date-title"><%= d.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}) %></span>
                        <span class="acm-att-date-sub"><%= d.toLocaleDateString('en-US',{weekday:'long'}) %></span>
                        <% if (record.reason) { %><span class="acm-att-reason-text">Reason: <%= record.reason %></span><% } %>
                    </div>
                    <span class="acm-att-badge acm-att-badge--<%= lower %>"><%= record.status %></span>
                </div>
                <% }) %>
            </div>
            <% } else { %><div class="acm-empty"><p class="acm-empty-title">No recorded attendance</p><p class="acm-empty-desc">There are no submitted attendance records matching this filter.</p></div><% } %>
            <% } else { %>
            <div class="acm-cal-wrapper">
                <div class="acm-cal-top">
                    <h3 class="acm-cal-heading"><%= calendar.monthName %></h3>
                    <div class="acm-cal-actions">
                        <a href="?section_id=<%= selectedSectionId %>&session=<%= encodeURIComponent(selectedSession) %>&term=<%= encodeURIComponent(selectedTerm) %>&class_id=<%= selectedClassId %>&view=calendar&month=<%= calendar.prevMonthStr %>" class="acm-cal-btn" aria-label="Previous month">‹</a>
                        <a href="?section_id=<%= selectedSectionId %>&session=<%= encodeURIComponent(selectedSession) %>&term=<%= encodeURIComponent(selectedTerm) %>&class_id=<%= selectedClassId %>&view=calendar&month=<%= calendar.nextMonthStr %>" class="acm-cal-btn" aria-label="Next month">›</a>
                    </div>
                </div>
                <div class="acm-cal-table-grid">
                    <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(day => { %><div class="acm-cal-day-label"><%= day %></div><% }) %>
                    <% for (let i=0;i<calendar.startDayOfWeek;i++) { %><div class="acm-cal-cell acm-cal-cell--empty"></div><% } %>
                    <% for (let day=1;day<=calendar.daysInMonth;day++) { const key = calendar.monthStr + '-' + String(day).padStart(2,'0'); const record = calendar.recordsByDate[key]; const status = record ? record.status : ''; %>
                    <div class="acm-cal-cell <%= status ? 'acm-cal-cell--' + status.replace(/_/g,'-') : '' %>" title="<%= record ? record.status.replace(/_/g,' ') : 'No classified day' %>"><span><%= day %></span></div>
                    <% } %>
                </div>
                <p class="acm-attention-text" style="margin-top:12px;">Calendar days distinguish recorded attendance, missing or draft registers, closures, non-opening days and dates with unknown information. An unrecorded day is never labelled absent.</p>
            </div>
            <% } %>
        </section>
        <% } else if (periods.length === 0) { %>
        <div class="acm-empty"><p class="acm-empty-title">Attendance calendar not available</p><p class="acm-empty-desc">No dated academic period and enrollment history are available for this section yet.</p></div>
        <% } else if (!selectedClassId) { %>
        <div class="acm-empty"><p class="acm-empty-title">Class enrollment not found</p><p class="acm-empty-desc">There is no dated class enrollment for the selected academic period.</p></div>
        <% } else { %>
        <div class="acm-empty"><p class="acm-empty-title">No attendance summary available</p><p class="acm-empty-desc">Attendance analytics could not be calculated for this selection.</p></div>
        <% } %>
        <% } else { %>
        <div class="acm-empty"><p class="acm-empty-title">No section enrollment found</p><p class="acm-empty-desc">Your attendance will appear here when your section enrollment and academic dates are available.</p></div>
        <% } %>
    </main>
</div>
<%- include('../partials/student_shell_footer') %>
</body>
</html>
