<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <%- include('../partials/student_shell_head') %>
</head>
<body>
<div class="acm-portal-shell">
    <%- include('../partials/student_shell_nav') %>
    <main class="acm-main-content portal-calendar-page portal-calendar-ui-page">
        <div class="acm-desktop-header">
            <div class="acm-header-greeting">
                <h1 class="acm-greeting-title">School Calendar</h1>
                <p class="acm-greeting-meta">Upcoming school events and activities</p>
            </div>
        </div>
        <div class="acm-profile-card">
            <div class="acm-profile-card-header">
                <h2 class="acm-profile-card-title"><i class="bi bi-calendar3" aria-hidden="true"></i> Events &amp; Activities</h2>
                <span class="acm-profile-card-subtitle"><%= events ? events.length : 0 %> events</span>
            </div>
            <% if (events && events.length > 0) { %>
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr><th>Date</th><th>Event</th><th>Category</th></tr>
                    </thead>
                    <tbody>
                        <% events.forEach(event => { %>
                            <%
                                let dateDisplay = event.event_date;
                                if (event.event_date) {
                                    const parts = event.event_date.toString().split('T')[0].split('-');
                                    if (parts.length === 3) {
                                        const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
                                        dateDisplay = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
                                    }
                                }
                            %>
                            <tr>
                                <td><strong><%= dateDisplay %></strong></td>
                                <td>
                                    <div style="font-weight:700;color:var(--acm-text-primary);margin-bottom:4px;"><%= event.title %></div>
                                    <div style="font-size:var(--acm-text-sm);color:var(--acm-text-secondary);line-height:1.6;"><%= event.description || '' %></div>
                                </td>
                                <td><span class="acm-status-chip acm-status-chip--general"><%= event.type || 'General' %></span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <div class="acm-empty">
                <i class="bi bi-calendar-x acm-empty-icon" aria-hidden="true"></i>
                <p class="acm-empty-title">No upcoming events</p>
                <p class="acm-empty-desc">School events and activities will appear here when they are published.</p>
            </div>
            <% } %>
        </div>
    </main>
</div>
<%- include('../partials/student_shell_footer') %>
</body>
</html>
