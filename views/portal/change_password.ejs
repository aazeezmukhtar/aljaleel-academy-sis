<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <%- include('../partials/student_shell_head') %>
    <link rel="stylesheet" href="/css/profile.css">
</head>
<body>
<div class="acm-portal-shell">
    <%- include('../partials/student_shell_nav') %>
    <main class="acm-main-content">
        <%- include('../partials/student_shell_header') %>

        <div class="acm-desktop-header">
            <div class="acm-header-greeting">
                <h1 class="acm-greeting-title">Change Password</h1>
                <p class="acm-greeting-meta"><%= currentTerm %> &middot; <%= currentSession %></p>
            </div>
            <div class="acm-header-actions">
                <a href="/portal/notifications" class="acm-icon-btn" aria-label="Notifications">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                    <% if (individualMessagesCount > 0) { %>
                        <span class="acm-badge"><%= individualMessagesCount > 9 ? '9+' : individualMessagesCount %></span>
                    <% } %>
                </a>
            </div>
        </div>

        <a href="/portal/profile" class="acm-detail-back-link">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Profile
        </a>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="acm-alert acm-alert--success" role="alert">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <span><%= success %></span>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="acm-alert acm-alert--error" role="alert">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <div class="acm-profile-card" style="max-width: 580px; margin-top: var(--acm-sp-16);">
            <div class="acm-profile-card-header">
                <h2 class="acm-profile-card-title">
                    <i class="bi bi-shield-lock-fill" style="color:var(--school-primary, var(--acm-navy));" aria-hidden="true"></i>
                    Update Credentials
                </h2>
            </div>

            <p style="font-size:var(--acm-text-sm); color:var(--acm-text-secondary); margin-bottom:var(--acm-sp-20);">
                Please choose a strong password with at least 6 characters.
            </p>

            <form action="/portal/change-password" method="POST" id="passwordForm">
                <div class="acm-form-group">
                    <label for="currentPassword" class="acm-form-label">Current Password</label>
                    <div class="acm-password-wrapper">
                        <input type="password" id="currentPassword" name="current_password" class="acm-form-control" required autocomplete="current-password">
                        <button type="button" class="acm-password-toggle-btn" data-target="currentPassword" aria-label="Toggle password visibility">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="acm-form-group">
                    <label for="newPassword" class="acm-form-label">New Password</label>
                    <div class="acm-password-wrapper">
                        <input type="password" id="newPassword" name="new_password" class="acm-form-control" required minlength="6" autocomplete="new-password">
                        <button type="button" class="acm-password-toggle-btn" data-target="newPassword" aria-label="Toggle password visibility">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="acm-form-group">
                    <label for="confirmPassword" class="acm-form-label">Confirm New Password</label>
                    <div class="acm-password-wrapper">
                        <input type="password" id="confirmPassword" name="confirm_password" class="acm-form-control" required minlength="6" autocomplete="new-password">
                        <button type="button" class="acm-password-toggle-btn" data-target="confirmPassword" aria-label="Toggle password visibility">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="acm-form-actions">
                    <a href="/portal/profile" class="acm-btn acm-btn--secondary">Cancel</a>
                    <button type="submit" class="acm-btn acm-btn--primary">
                        <i class="bi bi-check-lg" aria-hidden="true"></i> Update Password
                    </button>
                </div>
            </form>
        </div>

    </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const toggleBtns = document.querySelectorAll('.acm-password-toggle-btn');
    toggleBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-target');
            const input = document.getElementById(targetId);
            const icon = btn.querySelector('i');
            if (input) {
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            }
        });
    });
});
</script>

<%- include('../partials/student_shell_footer') %>
</body>
</html>
