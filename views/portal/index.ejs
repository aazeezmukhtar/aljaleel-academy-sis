<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <%- include('../partials/student_shell_head') %>
</head>
<body>

<div class="acm-portal-shell">
    
    <%- include('../partials/student_shell_nav') %>
    
    <main class="acm-main-content">
        <%- include('../partials/student_shell_header') %>

        <!-- Desktop Header -->
        <% 
            const hour = new Date().getHours();
            let greeting = 'Good evening';
            if (hour < 12) greeting = 'Good morning';
            else if (hour < 18) greeting = 'Good afternoon';
            const studentName = student.first_name || (student.name ? student.name.split(' ')[0] : 'Student');
        %>
        <div class="acm-desktop-header">
            <div class="acm-header-greeting">
                <h1 class="acm-greeting-title"><%= greeting %>, <%= studentName %></h1>
                <p class="acm-greeting-meta">
                    <%= student.class_name %> &middot; <%= currentTerm %> &middot; <%= currentSession %>
                </p>
            </div>
            <div class="acm-header-actions">
                <a href="/portal/notifications" class="acm-icon-btn" aria-label="Notifications<%= individualMessagesCount > 0 ? ', ' + individualMessagesCount + ' unread' : '' %>">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                    <% if (individualMessagesCount > 0) { %>
                        <span class="acm-badge"><%= individualMessagesCount > 9 ? '9+' : individualMessagesCount %></span>
                    <% } %>
                </a>
            </div>
        </div>

        <div class="acm-dashboard-grid">
            
            <!-- Left Column / Primary Content -->
            <div style="display: flex; flex-direction: column; gap: var(--acm-sp-24);">
                
                <!-- Section 1: Report Cards -->
                <section class="acm-section">
                    <h2 class="acm-section-title">Report Cards</h2>
                    <% if (results && results.length > 0) { %>
                        <div class="acm-card" style="gap: var(--acm-sp-18);">
                        <% results.forEach((result, index) => { %>
                            <div style="<% if(index > 0) { %>border-top: 1px solid var(--acm-border); padding-top: var(--acm-sp-18);<% } %>">
                                <div style="margin-bottom: var(--acm-sp-10);">
                                    <strong style="display: block; font-size: var(--acm-text-md); color: var(--acm-text-primary);"><%= result.term %></strong>
                                    <span style="font-size: var(--acm-text-xs); color: var(--acm-text-secondary);"><%= result.session %></span>
                                </div>
                                <div style="display: flex; gap: var(--acm-sp-10); flex-wrap: wrap;">
                                    <% if (student.class_name && student.class_name !== 'Not Enrolled' && student.class_name !== 'Unassigned') { %>
                                        <% student.class_name.split(', ').forEach(className => { %>
                                            <a href="/portal/results/termly?term=<%= encodeURIComponent(result.term) %>&session=<%= encodeURIComponent(result.session) %>&class_name=<%= encodeURIComponent(className) %>" target="_blank" class="acm-btn-pill">
                                                <i class="bi bi-file-text" aria-hidden="true"></i>
                                                <span><%= className %> Termly</span>
                                            </a>
                                        <% }) %>
                                    <% } else { %>
                                        <a href="/portal/results/termly?term=<%= encodeURIComponent(result.term) %>&session=<%= encodeURIComponent(result.session) %>" target="_blank" class="acm-btn-pill">
                                            <i class="bi bi-file-text" aria-hidden="true"></i>
                                            <span>Termly Report</span>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>

                            <div style="margin-top: var(--acm-sp-8); border-top: 1px solid var(--acm-border); padding-top: var(--acm-sp-18);">
                                <h4 style="font-size: var(--acm-text-xs); color: var(--acm-text-muted); margin: 0 0 var(--acm-sp-10) 0; text-transform: uppercase; letter-spacing: var(--acm-ls-wider);">Cumulative Reports</h4>
                                <div style="display: flex; gap: var(--acm-sp-10); flex-wrap: wrap;">
                                    <% if (student.class_name && student.class_name !== 'Not Enrolled' && student.class_name !== 'Unassigned') { %>
                                        <% student.class_name.split(', ').forEach(className => { %>
                                            <a href="/portal/results/cumulative?session=<%= encodeURIComponent(results[0].session) %>&class_name=<%= encodeURIComponent(className) %>" target="_blank" class="acm-btn-pill acm-btn-pill--primary">
                                                <i class="bi bi-bar-chart-fill" aria-hidden="true"></i>
                                                <span><%= className %> Cumulative</span>
                                            </a>
                                        <% }) %>
                                    <% } else { %>
                                        <a href="/portal/results/cumulative?session=<%= encodeURIComponent(results[0].session) %>" target="_blank" class="acm-btn-pill acm-btn-pill--primary">
                                            <i class="bi bi-bar-chart-fill" aria-hidden="true"></i>
                                            <span>Cumulative Report</span>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                    <div class="acm-card">
                        <p class="acm-empty-state">No reports published yet.</p>
                    </div>
                    <% } %>
                </section>

                <!-- Section 2: Quick Status Grid -->
                <section class="acm-section">
                    <h2 class="acm-section-title">Quick Status</h2>
                    <div class="acm-quick-grid">
                        
                        <!-- Attendance -->
                        <a href="/portal/attendance" class="acm-quick-card acm-card-link">
                            <h3 class="acm-quick-title">Attendance</h3>
                            <% if (attendancePercentage !== null) { %>
                                <div class="acm-quick-value"><%= attendancePercentage %>%</div>
                            <% } else { %>
                                <div class="acm-quick-value">--</div>
                            <% } %>
                            <div class="acm-card-action">
                                <span>View summary</span>
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </div>
                        </a>

                        <!-- Results -->
                        <a href="/portal/academics" class="acm-quick-card acm-card-link">
                            <h3 class="acm-quick-title">Academics</h3>
                            <div class="acm-quick-value"><%= results && results.length > 0 ? results[0].subjects_taken + ' Subjects' : '--' %></div>
                            <div class="acm-card-action">
                                <span>View results</span>
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </div>
                        </a>

                        <!-- Class Board -->
                        <a href="/portal/academics/class-board" class="acm-quick-card acm-card-link acm-quick-card--full">
                            <div class="acm-quick-content">
                                <h3 class="acm-quick-title">Class Board</h3>
                                <div class="acm-quick-value"><%= classPosts && classPosts.length > 0 ? classPosts.length + ' recent items' : 'No new items' %></div>
                            </div>
                            <div class="acm-card-action">
                                <span>View board</span>
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </div>
                        </a>
                    </div>
                </section>
                
            </div>

            <!-- Right Column / Secondary Content -->
            <div style="display: flex; flex-direction: column; gap: var(--acm-sp-24);">
                
                <!-- Section 4: Needs Your Attention (Conditional) -->
                <% if ((results && results.length > 0) || (classPosts && classPosts.length > 0)) { %>
                <section class="acm-section">
                    <h2 class="acm-section-title">Needs Your Attention</h2>
                    <div style="display: flex; flex-direction: column; gap: var(--acm-sp-14);">
                        <% if (results && results.length > 0) { 
                            const latestResult = results[0];
                        %>
                        <div class="acm-attention-card">
                            <i class="bi bi-file-earmark-check acm-attention-icon" aria-hidden="true"></i>
                            <div class="acm-attention-content">
                                <p class="acm-attention-text">Your <%= latestResult.term %> report card is available.</p>
                                <a href="/portal/results/termly?session=<%= encodeURIComponent(latestResult.session) %>&term=<%= encodeURIComponent(latestResult.term) %>" target="_blank" class="acm-attention-action">
                                    <span>View Report Card</span>
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                        <% } %>

                        <% if (classPosts && classPosts.length > 0) { %>
                        <div class="acm-attention-card">
                            <i class="bi bi-journal-text acm-attention-icon" aria-hidden="true"></i>
                            <div class="acm-attention-content">
                                <p class="acm-attention-text"><%= classPosts.length %> new class board <%= classPosts.length === 1 ? 'post' : 'posts' %>.</p>
                                <a href="/portal/academics/class-board" class="acm-attention-action">
                                    <span>View Class Board</span>
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </section>
                <% } %>

                <!-- Section 5: Announcements (Conditional) -->
                <% if (announcements && announcements.length > 0) { 
                    const latestAnn = announcements[0];
                    const date = new Date(latestAnn.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
                %>
                <section class="acm-section">
                    <h2 class="acm-section-title">Announcement</h2>
                    <div class="acm-announcement-card">
                        <div class="acm-announcement-meta">
                            <span><i class="bi bi-calendar3"></i> <%= date %></span>
                            <% if (latestAnn.priority === 'High' || latestAnn.priority === 'Urgent') { %>
                                <span>&middot;</span>
                                <span class="acm-status-chip acm-status-chip--overdue" style="padding: 2px 8px;">Important</span>
                            <% } %>
                        </div>
                        <h3 class="acm-announcement-title"><%= latestAnn.title %></h3>
                        <div class="acm-announcement-snippet"><%- latestAnn.content.replace(/<[^>]*>?/gm, '') %></div>
                        <div style="margin-top: var(--acm-sp-14); display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(0,0,0,0.06); padding-top: var(--acm-sp-10);">
                            <a href="/portal/announcement/<%= latestAnn.id %>" style="color: var(--school-primary, var(--acm-navy)); font-weight: var(--acm-fw-bold); font-size: var(--acm-text-sm); text-decoration: none;">Read more &rarr;</a>
                            <a href="/portal/notifications" style="font-size: var(--acm-text-xs); color: var(--acm-text-secondary); text-decoration: none;">All updates &rarr;</a>
                        </div>
                    </div>
                </section>
                <% } %>
                
            </div>
            
        </div>
    </main>
</div>

<%- include('../partials/student_shell_footer') %>

</body>
</html>
