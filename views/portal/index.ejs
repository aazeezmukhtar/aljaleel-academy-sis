<!DOCTYPE html>
<html lang="en" dir="ltr">
<head><%- include('../partials/student_shell_head') %></head>
<body>
<div class="acm-portal-shell">
    <%- include('../partials/student_shell_nav') %>
    <main class="acm-main-content portal-home-page">
        <%- include('../partials/student_shell_header') %>
        <%
            const hour = new Date().getHours();
            const greeting = hour < 12 ? 'Good morning' : (hour < 18 ? 'Good afternoon' : 'Good evening');
            const studentName = student.first_name || (student.name ? student.name.split(' ')[0] : 'Student');
            const studentFullName = student.name || [student.first_name, student.last_name].filter(Boolean).join(' ') || 'Student';
            const sections = Array.isArray(dashboardSectionStats) ? dashboardSectionStats : [];
            const hasDualSections = sections.length === 2 && new Set(sections.map(s => Number(s.sectionId))).size === 2;
            const defaultSection = sections[0] || null;
            const defaultSectionId = defaultSection ? String(defaultSection.sectionId) : '';
            const latestInsight = defaultSection && defaultSection.subjectInsights ? defaultSection.subjectInsights : [];
            const strongerSubjects = latestInsight.filter(s => Number(s.student_average) > Number(s.class_average)).slice(0, 2);
            const weakerSubjects = latestInsight.filter(s => Number(s.student_average) < Number(s.class_average)).slice(-2);
        %>
        <section class="acm-student-welcome">
            <div class="acm-student-avatar" aria-hidden="true"><i class="bi bi-person"></i></div>
            <div class="acm-student-welcome-copy">
                <span class="acm-student-eyebrow">STUDENT</span>
                <h1><%= greeting %>, <%= studentName %></h1>
                <p><%= studentFullName %></p>
                <div class="acm-student-context">
                    <span><i class="bi bi-calendar3"></i><%= defaultSection ? defaultSection.session + ' · ' + defaultSection.term : currentSession + ' · ' + currentTerm %></span>
                </div>
            </div>
        </section>

        <% if (hasDualSections) { %>
        <div class="acm-section-switcher" role="group" aria-label="Choose school section">
            <% sections.forEach((section, index) => { %>
            <button type="button" class="acm-section-switch <%= index === 0 ? 'is-active' : '' %>" data-section-switch="<%= section.sectionId %>" aria-pressed="<%= index === 0 ? 'true' : 'false' %>"><%= section.sectionName %></button>
            <% }); %>
        </div>
        <% } %>

        <div class="acm-student-dashboard" id="studentDashboard" data-default-section="<%= defaultSectionId %>">
            <% sections.forEach((section, index) => {
                const attendance = (attendanceSummaries || []).find(a => Number(a.sectionId) === Number(section.sectionId));
                const sectionResults = (results || []).filter(r => Number(r.section_id) === Number(section.sectionId));
                const latestResult = sectionResults[0] || null;
                const insights = section.subjectInsights || [];
                const stronger = insights.filter(s => Number(s.student_average) > Number(s.class_average)).slice(0, 2);
                const weaker = insights.filter(s => Number(s.student_average) < Number(s.class_average)).slice(-2);
                const analysisParts = [];
                if (stronger.length) analysisParts.push('You are doing well in ' + stronger.map(s => s.subject_name).join(' and '));
                if (weaker.length) analysisParts.push('focus on improving ' + weaker.map(s => s.subject_name).join(' and '));
            %>
            <section class="acm-dashboard-section" data-section-panel="<%= section.sectionId %>" <%= index === 0 ? '' : 'hidden' %>>
                <div class="acm-term-chip"><i class="bi bi-calendar3"></i><%= section.session %> · <%= section.term %></div>

                <a href="/portal/attendance" class="acm-attendance-feature">
                    <div><span>Attendance · <%= section.sectionName %></span>
                        <strong><%= attendance && attendance.attendanceRate !== null ? attendance.attendanceRate + '%' : '--' %></strong>
                        <small>View attendance</small>
                    </div>
                    <div class="acm-attendance-ring" style="--attendance-rate:<%= attendance && attendance.attendanceRate !== null ? attendance.attendanceRate : 0 %>%"><span></span></div>
                </a>

                <div class="acm-student-stat-grid">
                    <a href="/portal/academics" class="acm-student-stat-card">
                        <span class="acm-stat-icon acm-stat-indigo"><i class="bi bi-door-open"></i></span>
                        <strong><%= section.className || '—' %></strong><small>Class · <%= section.sectionName %></small>
                    </a>
                    <a href="/portal/academics/subjects" class="acm-student-stat-card">
                        <span class="acm-stat-icon acm-stat-green"><i class="bi bi-book"></i></span>
                        <strong><%= section.subjectsTaken || (latestResult ? latestResult.subjects_taken : '—') %></strong><small>My subjects</small>
                    </a>
                    <div class="acm-student-stat-card">
                        <span class="acm-stat-icon acm-stat-amber"><i class="bi bi-award"></i></span>
                        <strong><%= section.position ? section.position + (section.position === 1 ? 'st' : section.position === 2 ? 'nd' : section.position === 3 ? 'rd' : 'th') : '—' %></strong><small>Latest class position<%= section.classSize ? ' of ' + section.classSize : '' %></small>
                    </div>
                    <div class="acm-student-stat-card">
                        <span class="acm-stat-icon acm-stat-pink"><i class="bi bi-bar-chart"></i></span>
                        <strong><%= section.studentAverage !== null ? section.studentAverage.toFixed(1) + '%' : '—' %></strong><small>Latest class average</small>
                    </div>
                </div>

                <article class="acm-smart-analysis">
                    <div><span>Smart Analysis</span>
                        <strong><%= analysisParts.length ? analysisParts.join('; ') + '.' : 'Your academic insights will appear when published subject results are available.' %></strong>
                        <% if (section.studentAverage !== null && section.classAverage !== null) { %>
                        <small><%= Math.abs(section.studentAverage - section.classAverage).toFixed(1) %> marks <%= section.studentAverage >= section.classAverage ? 'above' : 'below' %> the class average.</small>
                        <% } %>
                    </div>
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </article>

                <section class="acm-dashboard-results">
                    <div class="acm-dashboard-section-heading"><h2>Results · <%= section.sectionName %></h2><a href="/portal/academics/results">View all</a></div>
                    <% if (sectionResults.length) { %>
                        <% sectionResults.slice(0, 3).forEach(result => { %>
                        <a class="acm-dashboard-result-row" href="/portal/results/termly?term=<%= encodeURIComponent(result.term) %>&session=<%= encodeURIComponent(result.session) %>&class_id=<%= result.class_id %>">
                            <div><strong><%= result.term %></strong><small><%= result.session %> · <%= result.subjects_taken %> subjects</small></div>
                            <b><%= result.average_score !== null && result.average_score !== undefined ? Number(result.average_score).toFixed(1) : '—' %><small>/100</small></b>
                        </a>
                        <% }); %>
                    <% } else { %><p class="acm-dashboard-empty">No results published for this section yet.</p><% } %>
                </section>
            </section>
            <% }); %>
            <% if (!sections.length) { %>
            <section class="acm-dashboard-section">
                <div class="acm-term-chip"><i class="bi bi-calendar3"></i><%= currentSession %> · <%= currentTerm %></div>
                <div class="acm-dashboard-empty-card">Your current class and section performance will appear here when your enrolment and published results are available.</div>
            </section>
            <% } %>
        </div>

        <section class="acm-dashboard-announcements">
            <div class="acm-dashboard-section-heading"><h2>Announcements</h2><a href="/portal/notifications">View all</a></div>
            <% if (announcements && announcements.length) { %>
                <% announcements.slice(0, 3).forEach(post => { %>
                <a class="acm-dashboard-announcement" href="/portal/announcement/<%= post.id %>">
                    <div class="acm-announcement-date"><%= new Date(post.created_at).toLocaleDateString('en-GB') %><% if (post.priority === 'High') { %><span>IMPORTANT</span><% } %></div>
                    <strong><%= post.title %></strong>
                    <p><%= post.content %></p><b>Read more</b>
                </a>
                <% }); %>
            <% } else { %><p class="acm-dashboard-empty">No announcements at the moment.</p><% } %>
        </section>
    </main>
</div>
<%- include('../partials/student_shell_footer') %>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const switches = Array.from(document.querySelectorAll('[data-section-switch]'));
    const panels = Array.from(document.querySelectorAll('[data-section-panel]'));
    switches.forEach(button => button.addEventListener('click', () => {
        const sectionId = button.dataset.sectionSwitch;
        switches.forEach(item => {
            const active = item === button;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-pressed', String(active));
        });
        panels.forEach(panel => { panel.hidden = panel.dataset.sectionPanel !== sectionId; });
    }));
});
</script>
</body>
</html>