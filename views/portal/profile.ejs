<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <%- include('../partials/student_shell_head') %>
    <link rel="stylesheet" href="/css/profile.css">
</head>
<body>
<div class="acm-portal-shell">
    <%- include('../partials/student_shell_nav') %>
    <main class="acm-main-content">
        <%- include('../partials/student_shell_header') %>

        <div class="acm-desktop-header">
            <div class="acm-header-greeting">
                <h1 class="acm-greeting-title">My Profile</h1>
                <p class="acm-greeting-meta"><%= currentTerm %> &middot; <%= currentSession %></p>
            </div>
            <div class="acm-header-actions">
                <a href="/portal/notifications" class="acm-icon-btn" aria-label="Notifications">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                    <% if (individualMessagesCount > 0) { %>
                        <span class="acm-badge"><%= individualMessagesCount > 9 ? '9+' : individualMessagesCount %></span>
                    <% } %>
                </a>
            </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="acm-alert acm-alert--success" role="alert">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <span><%= success %></span>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="acm-alert acm-alert--error" role="alert">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <!-- PROFILE HERO / IDENTITY -->
        <div class="acm-profile-hero">
            <div class="acm-avatar-container">
                <% if (student.passport_photo_path) { %>
                    <img id="avatarPreview" src="<%= student.passport_photo_path %>" alt="<%= student.first_name %> <%= student.last_name %>" class="acm-profile-avatar">
                <% } else { %>
                    <div id="avatarInitials" class="acm-avatar-initials">
                        <%= (student.first_name ? student.first_name[0] : '') + (student.last_name ? student.last_name[0] : '') %>
                    </div>
                    <img id="avatarPreview" src="" alt="Profile Preview" class="acm-profile-avatar" style="display:none;">
                <% } %>
                <form id="avatarForm" action="/portal/profile" method="POST" enctype="multipart/form-data" style="display:none;">
                    <input type="file" id="passportInput" name="passport" accept="image/jpeg,image/png,image/webp">
                </form>
                <label for="passportInput" class="acm-avatar-upload-btn" title="Change photo" aria-label="Change photo">
                    <i class="bi bi-camera-fill" aria-hidden="true"></i>
                </label>
            </div>

            <div class="acm-profile-identity">
                <h2 class="acm-profile-name"><%= student.first_name %> <%= student.other_names ? student.other_names + ' ' : '' %><%= student.last_name %></h2>
                <div class="acm-profile-meta">
                    <span class="acm-profile-id-badge">ID: <%= student.admission_number || student.id %></span>
                    <span>&middot;</span>
                    <span><%= student.class_name || 'Enrolled Scholar' %></span>
                    <span>&middot;</span>
                    <span><%= currentSession %></span>
                </div>
            </div>
        </div>

        <!-- MAIN CONTENT SECTIONS -->
        <div class="acm-profile-sections-grid">
            
            <!-- COLUMN 1: SCHOOL-MANAGED INFORMATION (READ ONLY) -->
            <div class="acm-profile-card">
                <div class="acm-profile-card-header">
                    <h3 class="acm-profile-card-title">
                        <i class="bi bi-shield-lock" style="color:var(--acm-text-muted);" aria-hidden="true"></i>
                        School Information
                    </h3>
                    <span class="acm-profile-card-subtitle">Official Records</span>
                </div>

                <div class="acm-field-list">
                    <div class="acm-field-row">
                        <span class="acm-field-label">Student ID / Admission No.</span>
                        <span class="acm-field-value"><%= student.admission_number || student.id %></span>
                    </div>

                    <div class="acm-field-row">
                        <span class="acm-field-label">Full Name</span>
                        <span class="acm-field-value"><%= student.first_name %> <%= student.other_names ? student.other_names + ' ' : '' %><%= student.last_name %></span>
                    </div>

                    <% if (typeof sectionInfo !== 'undefined' && sectionInfo && sectionInfo.length > 0) { %>
                        <% sectionInfo.forEach((sec, idx) => { %>
                            <div class="acm-field-row" style="<%= idx > 0 ? 'margin-top: var(--acm-sp-8); padding-top: var(--acm-sp-8); border-top: 1px dashed var(--acm-border);' : '' %>">
                                <span class="acm-field-label"><%= sec.section_name ? sec.section_name + ' Class' : 'Class' %></span>
                                <span class="acm-field-value">
                                    <strong><%= sec.class_name %></strong>
                                    <span style="font-size: var(--acm-text-xs); color: var(--acm-text-secondary); display: block; margin-top: 2px;">
                                        <%= sec.current_session %> &middot; <%= sec.current_term %>
                                    </span>
                                </span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="acm-field-row">
                            <span class="acm-field-label">Current Class</span>
                            <span class="acm-field-value"><%= student.class_name || 'Unassigned' %></span>
                        </div>

                        <div class="acm-field-row">
                            <span class="acm-field-label">Academic Session</span>
                            <span class="acm-field-value"><%= currentSession %></span>
                        </div>
                    <% } %>

                    <div class="acm-field-row">
                        <span class="acm-field-label">Gender</span>
                        <span class="acm-field-value"><%= student.gender || 'Not specified' %></span>
                    </div>

                    <div class="acm-field-row">
                        <span class="acm-field-label">Enrollment Status</span>
                        <span class="acm-field-value">
                            <span class="acm-status-chip acm-status-chip--present">Active Student</span>
                        </span>
                    </div>
                </div>

                <p style="font-size: var(--acm-text-xs); color: var(--acm-text-muted); margin-top: var(--acm-sp-16); margin-bottom: 0;">
                    <i class="bi bi-info-circle" aria-hidden="true"></i> School information is managed directly by the administration.
                </p>
            </div>

            <!-- COLUMN 2: STUDENT & PARENT CONTACT INFORMATION -->
            <div class="acm-profile-card">
                
                <!-- VIEW MODE -->
                <div id="contactViewMode">
                    <div class="acm-profile-card-header">
                        <h3 class="acm-profile-card-title">
                            <i class="bi bi-person-lines-fill" style="color:var(--school-primary, var(--acm-navy));" aria-hidden="true"></i>
                            Personal &amp; Contact
                        </h3>
                        <button type="button" id="editBtn" class="acm-btn acm-btn--secondary" style="padding: 4px 12px; font-size: var(--acm-text-xs);">
                            <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                        </button>
                    </div>

                    <div class="acm-field-list">
                        <div class="acm-field-row">
                            <span class="acm-field-label">Date of Birth</span>
                            <span class="acm-field-value <%= !displayDob ? 'acm-field-value--empty' : '' %>">
                                <%= displayDob || 'Not provided' %>
                            </span>
                        </div>

                        <div class="acm-field-row">
                            <span class="acm-field-label">Student Phone</span>
                            <span class="acm-field-value <%= !student.phone ? 'acm-field-value--empty' : '' %>">
                                <%= student.phone || 'Not provided' %>
                            </span>
                        </div>

                        <div class="acm-field-row">
                            <span class="acm-field-label">Student Email</span>
                            <span class="acm-field-value <%= !student.email ? 'acm-field-value--empty' : '' %>">
                                <%= student.email || 'Not provided' %>
                            </span>
                        </div>

                        <div class="acm-field-row">
                            <span class="acm-field-label">Student Address</span>
                            <span class="acm-field-value <%= !student.address ? 'acm-field-value--empty' : '' %>">
                                <%= student.address || 'Not provided' %>
                            </span>
                        </div>

                        <div style="margin-top: var(--acm-sp-8); padding-top: var(--acm-sp-12); border-top: 1px dashed var(--acm-border);">
                            <div class="acm-field-row">
                                <span class="acm-field-label">Parent / Guardian Primary Phone</span>
                                <span class="acm-field-value <%= !student.parent_phone ? 'acm-field-value--empty' : '' %>">
                                    <%= student.parent_phone || 'Not provided' %>
                                </span>
                            </div>

                            <div class="acm-field-row" style="margin-top: var(--acm-sp-8);">
                                <span class="acm-field-label">Parent / Guardian Alternate Phone</span>
                                <span class="acm-field-value <%= !student.parent_phone_alt ? 'acm-field-value--empty' : '' %>">
                                    <%= student.parent_phone_alt || 'Not provided' %>
                                </span>
                            </div>

                            <div class="acm-field-row" style="margin-top: var(--acm-sp-8);">
                                <span class="acm-field-label">Parent / Guardian Email</span>
                                <span class="acm-field-value <%= !student.parent_email ? 'acm-field-value--empty' : '' %>">
                                    <%= student.parent_email || 'Not provided' %>
                                </span>
                            </div>

                            <div class="acm-field-row" style="margin-top: var(--acm-sp-8);">
                                <span class="acm-field-label">Parent / Guardian Address</span>
                                <span class="acm-field-value <%= !student.parent_address ? 'acm-field-value--empty' : '' %>">
                                    <%= student.parent_address || 'Not provided' %>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- EDIT MODE -->
                <div id="contactEditMode" style="display: none;">
                    <div class="acm-profile-card-header">
                        <h3 class="acm-profile-card-title">
                            <i class="bi bi-pencil-square" style="color:var(--school-primary, var(--acm-navy));" aria-hidden="true"></i>
                            Edit Contact Details
                        </h3>
                    </div>

                    <form action="/portal/profile" method="POST" id="profileForm">
                        <div class="acm-form-group">
                            <label for="dobInput" class="acm-form-label">Date of Birth</label>
                            <input type="date" id="dobInput" name="dob" class="acm-form-control" value="<%= rawDob %>">
                        </div>

                        <div class="acm-form-group">
                            <label for="phoneInput" class="acm-form-label">Student Phone</label>
                            <input type="tel" id="phoneInput" name="phone" class="acm-form-control" value="<%= student.phone || '' %>" placeholder="e.g. 08012345678">
                        </div>

                        <div class="acm-form-group">
                            <label for="emailInput" class="acm-form-label">Student Email</label>
                            <input type="email" id="emailInput" name="email" class="acm-form-control" value="<%= student.email || '' %>" placeholder="student@example.com">
                        </div>

                        <div class="acm-form-group">
                            <label for="addressInput" class="acm-form-label">Student Address</label>
                            <textarea id="addressInput" name="address" class="acm-form-control" placeholder="Enter residential address"><%= student.address || '' %></textarea>
                        </div>

                        <div style="margin-top: var(--acm-sp-16); padding-top: var(--acm-sp-12); border-top: 1px solid var(--acm-border);">
                            <h4 style="font-size: var(--acm-text-xs); font-weight: var(--acm-fw-bold); text-transform: uppercase; color: var(--acm-text-muted); margin-bottom: var(--acm-sp-12);">Parent / Guardian Contact</h4>
                            
                            <div class="acm-form-group">
                                <label for="parentPhoneInput" class="acm-form-label">Parent Primary Phone</label>
                                <input type="tel" id="parentPhoneInput" name="parent_phone" class="acm-form-control" value="<%= student.parent_phone || '' %>" placeholder="e.g. 08012345678">
                            </div>

                            <div class="acm-form-group">
                                <label for="parentPhoneAltInput" class="acm-form-label">Parent Alternate Phone</label>
                                <input type="tel" id="parentPhoneAltInput" name="parent_phone_alt" class="acm-form-control" value="<%= student.parent_phone_alt || '' %>" placeholder="e.g. 08012345679">
                            </div>

                            <div class="acm-form-group">
                                <label for="parentEmailInput" class="acm-form-label">Parent Email Address</label>
                                <input type="email" id="parentEmailInput" name="parent_email" class="acm-form-control" value="<%= student.parent_email || '' %>" placeholder="parent@example.com">
                            </div>

                            <div class="acm-form-group">
                                <label for="parentAddressInput" class="acm-form-label">Parent Residential Address</label>
                                <textarea id="parentAddressInput" name="parent_address" class="acm-form-control" placeholder="Enter parent address"><%= student.parent_address || '' %></textarea>
                            </div>
                        </div>

                        <div class="acm-form-actions">
                            <button type="button" id="cancelEditBtn" class="acm-btn acm-btn--secondary">Cancel</button>
                            <button type="submit" class="acm-btn acm-btn--primary">
                                <i class="bi bi-check2" aria-hidden="true"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>

            </div>

        </div>

        <!-- ACCOUNT ACTIONS SECTION -->
        <section class="acm-section">
            <h2 class="acm-section-title">Account Security</h2>
            <div class="acm-account-list">
                <a href="/portal/change-password" class="acm-account-item">
                    <div style="display:flex; align-items:center; gap:var(--acm-sp-12);">
                        <i class="bi bi-key" style="font-size:1.25rem; color:var(--school-primary, var(--acm-navy));" aria-hidden="true"></i>
                        <div>
                            <div style="font-weight:var(--acm-fw-semibold); font-size:var(--acm-text-sm);">Change Password</div>
                            <div style="font-size:var(--acm-text-xs); color:var(--acm-text-muted);">Update your portal access credentials</div>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right" style="color:var(--acm-text-muted);" aria-hidden="true"></i>
                </a>

                <a href="/auth/student-logout" class="acm-account-item acm-account-item--danger">
                    <div style="display:flex; align-items:center; gap:var(--acm-sp-12);">
                        <i class="bi bi-box-arrow-right" style="font-size:1.25rem;" aria-hidden="true"></i>
                        <div>
                            <div style="font-weight:var(--acm-fw-semibold); font-size:var(--acm-text-sm);">Sign Out</div>
                            <div style="font-size:var(--acm-text-xs); color:rgba(239, 68, 68, 0.8);">End your current portal session</div>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
            </div>
        </section>

    </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const editBtn = document.getElementById('editBtn');
    const cancelEditBtn = document.getElementById('cancelEditBtn');
    const viewMode = document.getElementById('contactViewMode');
    const editMode = document.getElementById('contactEditMode');

    if (editBtn && cancelEditBtn && viewMode && editMode) {
        editBtn.addEventListener('click', () => {
            viewMode.style.display = 'none';
            editMode.style.display = 'block';
        });

        cancelEditBtn.addEventListener('click', () => {
            editMode.style.display = 'none';
            viewMode.style.display = 'block';
        });
    }

    // Avatar Instant Upload
    const passportInput = document.getElementById('passportInput');
    const avatarForm = document.getElementById('avatarForm');
    if (passportInput && avatarForm) {
        passportInput.addEventListener('change', () => {
            if (passportInput.files && passportInput.files[0]) {
                avatarForm.submit();
            }
        });
    }
});
</script>

<%- include('../partials/student_shell_footer') %>
</body>
</html>
