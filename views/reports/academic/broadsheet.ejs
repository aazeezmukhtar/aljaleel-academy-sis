<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content academic-report-detail-page academic-broadsheet-report-page">
            <header class="content-header no-print">
                <div class="header-left">
                    <a href="/reports/academic" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
                    <h1>Master Broadsheet</h1>
                </div>
                <div class="header-actions">
                    <button class="btn btn-primary btn-export" data-filename="broadsheet.csv">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                    </button>
                    <button onclick="window.print()" class="btn btn-secondary">
                        <i class="bi bi-printer"></i> Print Sheet
                    </button>
                </div>
            </header>

            <div class="card no-print settings-card">
                <form action="/reports/academic/broadsheet" method="GET" class="filter-form">
                    <div class="form-group">
                        <label>Class</label>
                        <select name="class_id" required>
                            <option value="">Select Class</option>
                            <% if (typeof classes !== 'undefined' && classes && classes.length > 0) { %>
                                <% classes.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= query.class_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Term</label>
                        <select name="term" required>
                            <option value="1st Term" <%=query.term==='1st Term' ? 'selected' : '' %>>1st Term</option>
                            <option value="2nd Term" <%=query.term==='2nd Term' ? 'selected' : '' %>>2nd Term</option>
                            <option value="3rd Term" <%=query.term==='3rd Term' ? 'selected' : '' %>>3rd Term</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Session</label>
                        <select name="session" required>
                            <option value="">Select Session</option>
                            <% 
                            const sessList = (typeof availableSessions !== 'undefined' && availableSessions && availableSessions.length > 0) 
                                ? availableSessions 
                                : ((typeof available_sessions !== 'undefined' && available_sessions && available_sessions.length > 0) 
                                    ? available_sessions 
                                    : ['2024/2025', '2025/2026']);
                            sessList.forEach(s => { 
                            %>
                                <option value="<%= s %>" <%= query.session === s ? 'selected' : '' %>><%= s %></option>
                            <% }); %>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Generate</button>
                </form>
            </div>

            <% if (reportData) { %>
                <div class="report-paper landscape">
                    <div class="report-header">
                        <h2>
                            <%= reportData.class_name %> - Master Broadsheet
                        </h2>
                        <p>
                            <%= reportData.term %>, <%= reportData.session %> Session
                        </p>
                    </div>

                    <div class="table-container">
                        <table class="report-table broadsheet-table">
                            <thead>
                                <tr>
                                    <th class="sticky-col">S/N</th>
                                    <th class="sticky-col name-col">Student Name</th>
                                    <% subjects.forEach(sub=> { %>
                                        <th class="rotate-header">
                                            <div><span>
                                                    <%= sub.name.substring(0, 15) %>
                                                </span></div>
                                        </th>
                                        <% }) %>
                                            <th class="summary-col">Subjects Recorded</th>
                                            <th class="summary-col">Total (Scored)</th>
                                            <th class="summary-col">Avg (Scored)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% reportData.students.forEach((student, index)=> { %>
                                    <tr>
                                        <td class="sticky-col">
                                            <%= index + 1 %>
                                        </td>
                                        <td class="sticky-col name-col">
                                            <%= student.last_name.toUpperCase() %>, <%= student.first_name %>
                                        </td>
                                        <% subjects.forEach(sub=> { %>
                                            <% const result=student.results[sub.id]; %>
                                                <td class="<%= result && result.total !== null && result.total !== undefined ? (Number(result.total) < 40 ? 'fail' : '') : 'empty' %>">
                                                    <% if (result) { %>
                                                        <strong><%= result.total !== null && result.total !== undefined ? result.total : '-' %></strong>
                                                        <small class="broadsheet-result-status" style="display:block;font-size:0.65rem;opacity:.72;text-transform:capitalize;"><%= result.status || 'draft' %></small>
                                                    <% } else { %>
                                                        -
                                                    <% } %>
                                                </td>
                                                <% }) %>
                                                    <td class="summary-col"><strong>
                                                            <%= student.subjects_sat %> / <%= subjects.length %>
                                                        </strong></td>
                                                    <td class="summary-col"><strong>
                                                            <%= student.total_score %>
                                                        </strong></td>
                                                    <td class="summary-col"><strong>
                                                            <%= student.average %>
                                                        </strong></td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <% } %>
        </main>



        <%- include('../../partials/footer') %>