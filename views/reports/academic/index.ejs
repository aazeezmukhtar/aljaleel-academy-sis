<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content reports-academic-page academic-reports-index-page">
            <header class="content-header">
                <a href="/reports" class="back-link"><i class="bi bi-arrow-left"></i> Back to Report Center</a>
                <h1>Academic Reports</h1>
                <p>Results, Analysis, and Performance Metrics.</p>
            </header>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon academic-stat-results">
                        <i class="bi bi-file-earmark-bar-graph"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.total_results %>
                        </h3>
                        <p>Total Results Logged</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon academic-stat-subjects">
                        <i class="bi bi-book"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.subjects %>
                        </h3>
                        <p>Subjects</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon academic-stat-classes">
                        <i class="bi bi-building"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.classes %>
                        </h3>
                        <p>Classes</p>
                    </div>
                </div>
            </div>

            <div class="report-dashboard-grid">
                <a href="/reports/academic/broadsheet" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-table"></i>
                    </div>
                    <div class="report-info">
                        <h3>Master Broadsheet</h3>
                        <p>Comprehensive class results grid (All Subjects vs Students).</p>
                    </div>
                </a>

                <a href="/reports/academic/analysis" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-graph-up"></i>
                    </div>
                    <div class="report-info">
                        <h3>Subject Analysis</h3>
                        <p>Pass/Fail rates, averages, and performance distribution.</p>
                    </div>
                </a>

                <a href="/reports/academic/top" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                    <div class="report-info">
                        <h3>Top Performers</h3>
                        <p>Identify best performing students by class or subject.</p>
                    </div>
                </a>

                <a href="/results/bulk" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-card-checklist"></i>
                    </div>
                    <div class="report-info">
                        <h3>Student Report Cards</h3>
                        <p>Print termly report cards for entire classes.</p>
                    </div>
                </a>
            </div>
        </main>



        <%- include('../../partials/footer') %>