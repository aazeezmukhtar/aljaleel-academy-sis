<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content academic-report-detail-page academic-top-report-page">
            <header class="content-header no-print">
                <div class="header-left">
                    <a href="/reports/academic" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
                    <h1>Top Performers</h1>
                </div>
                <div class="header-actions">
                    <button class="btn btn-primary btn-export" data-filename="top_performers.csv">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                    </button>
                    <button onclick="window.print()" class="btn btn-secondary">
                        <i class="bi bi-printer"></i> Print List
                    </button>
                </div>
            </header>

            <div class="card no-print settings-card">
                <form action="/reports/academic/top" method="GET" class="filter-form">
                    <div class="form-group">
                        <label>Class</label>
                        <select name="class_id" required>
                            <option value="">Select Class</option>
                            <% if (typeof classes !== 'undefined' && classes && classes.length > 0) { %>
                                <% classes.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= query.class_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Term</label>
                        <select name="term" required>
                            <option value="1st Term" <%=query.term==='1st Term' ? 'selected' : '' %>>1st Term</option>
                            <option value="2nd Term" <%=query.term==='2nd Term' ? 'selected' : '' %>>2nd Term</option>
                            <option value="3rd Term" <%=query.term==='3rd Term' ? 'selected' : '' %>>3rd Term</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Session</label>
                        <select name="session" required>
                            <option value="">Select Session</option>
                            <% 
                            const sessList = (typeof availableSessions !== 'undefined' && availableSessions && availableSessions.length > 0) 
                                ? availableSessions 
                                : ((typeof available_sessions !== 'undefined' && available_sessions && available_sessions.length > 0) 
                                    ? available_sessions 
                                    : ['2024/2025', '2025/2026']);
                            sessList.forEach(s => { 
                            %>
                                <option value="<%= s %>" <%= query.session === s ? 'selected' : '' %>><%= s %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Limit</label>
                        <select name="limit">
                            <option value="3" <%=query.limit==3 ? 'selected' : '' %>>Top 3</option>
                            <option value="5" <%=query.limit==5 ? 'selected' : '' %>>Top 5</option>
                            <option value="10" <%=query.limit==10 ? 'selected' : '' %>>Top 10</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Reveal</button>
                </form>
            </div>

            <% if (topStudents.length> 0) { %>
                <div class="report-paper">
                    <div class="report-header">
                        <h2>Top <%= query.limit %> Academic Performers</h2>
                        <p>
                            <%= topStudents[0].class_name %> - <%= query.term %>, <%= query.session %>
                        </p>
                    </div>

                    <table class="report-table">
                        <thead>
                            <tr>
                                <th class="academic-rank-column">Rank</th>
                                <th>Student Name</th>
                                <th>Student ID.</th>
                                <th>Subjects Sat</th>
                                <th>Total Score</th>
                                <th>Average</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% topStudents.forEach((student, index)=> { %>
                                <tr class="<%= index < 3 ? 'top-rank rank-' + (index+1) : '' %>">
                                    <td>
                                        <div class="rank-badge">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td class="academic-student-name">
                                        <%= student.last_name.toUpperCase() %>, <%= student.first_name %>
                                    </td>
                                    <td>
                                        <%= student.admission_number %>
                                    </td>
                                    <td>
                                        <%= student.subjects_sat %>
                                    </td>
                                    <td>
                                        <%= student.total_score %>
                                    </td>
                                    <td><strong>
                                            <%= student.average_score.toFixed(2) %>%
                                        </strong></td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else if (query.class_id) { %>
                    <div class="empty-state">
                        <i class="bi bi-trophy"></i>
                        <p>No results available for this criteria.</p>
                    </div>
                    <% } %>
        </main>



        <%- include('../../partials/footer') %>