<%- include('../../partials/header') %>
<div class="dashboard-container">
    <%- include('../../partials/sidebar') %>
    <main class="main-content">
        <header class="content-header" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:25px;">
            <div><h1>Daily Attendance Report</h1><p class="text-muted">Submitted register records for a selected section, date and status.</p></div>
            <div style="display:flex;gap:8px;"><button onclick="window.print()" class="btn btn-outline">Print</button><button onclick="exportTableToCSV('daily-attendance-<%= query.date || 'report' %>.csv')" class="btn btn-outline">Export CSV</button></div>
        </header>
        <section class="card" style="margin-bottom:24px;">
            <form action="/reports/attendance/daily" method="GET" style="display:flex;gap:14px;align-items:end;flex-wrap:wrap;">
                <div class="form-group"><label>Section</label><select name="section_id" class="form-control" required>
                    <option value="">-- Select Section --</option>
                    <% (sections || []).forEach(section => { %><option value="<%= section.id %>" <%= query.section_id == section.id ? 'selected' : '' %>><%= section.name %></option><% }); %>
                </select></div>
                <div class="form-group"><label>Date</label><input type="date" name="date" class="form-control" value="<%= query.date || '' %>" required></div>
                <div class="form-group"><label>Status</label><select name="type" class="form-control">
                    <% ['Absent','Late','Present','Leave'].forEach(status => { %><option value="<%= status %>" <%= query.type === status ? 'selected' : '' %>><%= status %></option><% }); %>
                </select></div>
                <div class="form-group"><label>Class (optional)</label><select name="class_id" class="form-control"><option value="">All classes in section</option>
                    <% (classes || []).forEach(c => { %><option value="<%= c.id %>" <%= query.class_id == c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
                </select></div>
                <button type="submit" class="btn btn-primary">Generate</button>
            </form>
        </section>
        <% if (query.section_id && query.date) { %>
        <section class="card">
            <% if (students && students.length) { %>
            <div class="table-container"><table class="data-table" id="dataTable">
                <thead><tr><th>Student</th><th>Admission #</th><th>Class</th><th>Parent Phone</th><th>Status</th></tr></thead>
                <tbody><% students.forEach(student => { %><tr>
                    <td><strong><%= student.last_name %>, <%= student.first_name %></strong></td>
                    <td><%= student.admission_number || '' %></td><td><%= student.class_name %></td>
                    <td><%= student.parent_phone || 'N/A' %></td><td><%= student.status %></td>
                </tr><% }); %></tbody>
            </table></div>
            <p class="text-muted" style="text-align:right;margin-top:14px;">Submitted records: <%= students.length %></p>
            <% } else { %><div style="text-align:center;padding:38px;"><h3>No submitted records found</h3><p class="text-muted">No students were recorded with this status in a submitted register for the selected date.</p></div><% } %>
        </section>
        <% } %>
    </main>
</div>
<script src="/js/table-export.js"></script>
<%- include('../../partials/footer') %>
