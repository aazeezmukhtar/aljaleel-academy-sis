<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content reports-attendance-page">
            <header class="content-header">
                <a href="/reports" class="back-link"><i class="bi bi-arrow-left"></i> Back to Report Center</a>
                <h1>Attendance Reports</h1>
                <p>Monitor student attendance and punctuality.</p>
            </header>
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-icon stat-present"><i class="bi bi-check-circle-fill"></i></div><div class="stat-info"><h3><%= stats.present_today %></h3><p>Present Today</p></div></div>
                <div class="stat-card"><div class="stat-icon stat-absent"><i class="bi bi-x-circle-fill"></i></div><div class="stat-info"><h3><%= stats.absent_today %></h3><p>Absent Today</p></div></div>
                <div class="stat-card"><div class="stat-icon stat-late"><i class="bi bi-clock-history"></i></div><div class="stat-info"><h3><%= stats.late_today %></h3><p>Late Today</p></div></div>
            </div>
            <div class="report-dashboard-grid">
                <a href="/reports/attendance/register" class="report-card"><div class="report-icon"><i class="bi bi-calendar3"></i></div><div class="report-info"><h3>Monthly Register</h3><p>View and print monthly attendance registers for any class.</p></div></a>
                <a href="/reports/attendance/low" class="report-card"><div class="report-icon"><i class="bi bi-exclamation-triangle-fill"></i></div><div class="report-info"><h3>Low Attendance Alerts</h3><p>Students below the required attendance threshold.</p></div></a>
            </div>
        </main>
        <%- include('../../partials/footer') %>
