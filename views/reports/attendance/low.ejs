<%- include('../../partials/header') %>
<%- include('../../partials/sidebar') %>
<main class="main-content">
    <header class="content-header no-print">
        <a href="/reports/attendance" class="back-link">← Back to Attendance Reports</a>
        <h1>Low Attendance Alerts</h1>
        <p>Students whose attendance rate is below the selected threshold.</p>
    </header>

    <section class="card no-print" style="margin-bottom:22px;">
        <form action="/reports/attendance/low" method="GET" style="display:flex;gap:14px;align-items:end;flex-wrap:wrap;">
            <div class="form-group" style="min-width:220px;flex:1;">
                <label for="section">Section</label>
                <select id="section" name="section_id" required class="form-control">
                    <option value="">Select one section</option>
                    <% (sections || []).forEach(section => { %>
                        <option value="<%= section.id %>" <%= String(selectedSectionId || '') === String(section.id) ? 'selected' : '' %>><%= section.name %></option>
                    <% }); %>
                </select>
            </div>
            <div class="form-group">
                <label for="threshold">Low-attendance threshold (%)</label>
                <input id="threshold" type="number" name="threshold" min="0" max="100" step="0.1" value="<%= threshold %>" required class="form-control">
            </div>
            <button type="submit" class="btn btn-primary">Generate alerts</button>
        </form>
        <p class="text-muted" style="margin:10px 0 0;font-size:.85rem;">Only one section is analysed per report. Present, Late and approved Leave receive full credit; Absent receives zero. Missing and draft registers are excluded from the rate.</p>
    </section>

    <% if (reportError) { %><div class="card" role="alert" style="border-left:4px solid #dc2626;margin-bottom:20px;"><strong>Report unavailable</strong><p><%= reportError %></p></div><% } %>

    <% if (reportContext) { %>
    <section class="card">
        <div class="report-header" style="margin-bottom:18px;">
            <h2>Critical Attendance Report</h2>
            <p><%= selectedSection.name %> · <%= reportContext.session %> · <%= reportContext.term %></p>
            <p><%= reportContext.start_date %> to <%= reportContext.end_date %> · Below <%= threshold %>%</p>
        </div>
        <% if (students.length) { %>
        <div class="table-container mobile-cards">
            <table class="data-table">
                <thead><tr><th>Student</th><th>Class</th><th>Expected</th><th>Recorded</th><th>Present</th><th>Late</th><th>Leave</th><th>Absent</th><th>Attendance</th><th>Missing / Draft</th></tr></thead>
                <tbody>
                <% students.forEach(student => { %>
                    <tr>
                        <td data-label="Student"><strong><%= student.last_name %>, <%= student.first_name %></strong><small style="display:block;color:var(--text-muted);"><%= student.admission_number || '' %></small></td>
                        <td data-label="Class"><%= student.class_name %></td>
                        <td data-label="Expected"><%= student.expected_days %></td>
                        <td data-label="Recorded"><%= student.recorded_days %></td>
                        <td data-label="Present"><%= student.present_days %></td>
                        <td data-label="Late"><%= student.late_days %></td>
                        <td data-label="Leave"><%= student.leave_days %></td>
                        <td data-label="Absent"><%= student.absent_days %></td>
                        <td data-label="Attendance"><strong><%= student.attendance_rate.toFixed(1) %>%</strong></td>
                        <td data-label="Missing / Draft"><%= student.missing_registers %> missing · <%= student.draft_registers %> draft</td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
            <p style="text-align:center;padding:28px;color:var(--text-muted);">No students with a calculable attendance rate are below this threshold.</p>
        <% } %>
    </section>
    <% } %>
</main>
<style>
.back-link{display:inline-block;margin-bottom:10px;color:var(--text-muted);text-decoration:none}
@media print{.no-print{display:none!important}body *{visibility:hidden}.main-content,.main-content *{visibility:visible}.main-content{position:absolute;left:0;top:0;width:100%}}
</style>
<%- include('../../partials/footer') %>
