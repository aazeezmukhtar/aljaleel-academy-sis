<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content attendance-low-report-page">
            <header class="content-header no-print">
                <div class="header-left">
                    <a href="/reports/attendance" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
                    <h1>Low Attendance Alerts</h1>
                </div>
                <div class="header-actions">
                    <button class="btn btn-primary btn-export" data-filename="low_attendance.csv">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                    </button>
                    <button onclick="window.print()" class="btn btn-secondary">
                        <i class="bi bi-printer"></i> Print List
                    </button>
                </div>
            </header>

            <div class="card no-print settings-card">
                <form action="/reports/attendance/low" method="GET" class="filter-form">
                    <div class="form-group">
                        <label>Term</label>
                        <select name="term" required>
                            <option value="1st Term" <%=query.term==='1st Term' ? 'selected' : '' %>>1st Term</option>
                            <option value="2nd Term" <%=query.term==='2nd Term' ? 'selected' : '' %>>2nd Term</option>
                            <option value="3rd Term" <%=query.term==='3rd Term' ? 'selected' : '' %>>3rd Term</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Session</label>
                        <select name="session" required>
                            <option value="">Select Session</option>
                            <%
                            const sessList = (typeof availableSessions !== 'undefined' && availableSessions && availableSessions.length > 0)
                                ? availableSessions
                                : ((typeof available_sessions !== 'undefined' && available_sessions && available_sessions.length > 0)
                                    ? available_sessions
                                    : ['2024/2025', '2025/2026']);
                            sessList.forEach(s => {
                            %>
                                <option value="<%= s %>" <%= query.session === s ? 'selected' : '' %>><%= s %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Min. Attendance (%)</label>
                        <input type="number" name="threshold" value="<%= query.threshold %>" min="1" max="100">
                    </div>
                    <button type="submit" class="btn btn-primary">Check</button>
                </form>
            </div>

            <% if (students && students.length > 0) { %>
                <div class="report-paper">
                    <div class="report-header">
                        <h2>Critical Attendance Report</h2>
                        <p>Students below <%= query.threshold %>% attendance in <%= query.term %>, <%= query.session %></p>
                    </div>
                    <div class="table-container">
                        <table class="report-table">
                            <thead>
                                <tr>
                                    <th>Student Name</th>
                                    <th>Adm No.</th>
                                    <th>Class</th>
                                    <th>Total Days</th>
                                    <th>Present Days</th>
                                    <th>Attendance %</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% students.forEach(student => { %>
                                    <% const percentage = ((student.present_days / student.total_days) * 100).toFixed(1); %>
                                    <tr>
                                        <td class="student-name"><%= student.last_name.toUpperCase() %>, <%= student.first_name %></td>
                                        <td><%= student.admission_number %></td>
                                        <td><%= student.class_name %></td>
                                        <td><%= student.total_days %></td>
                                        <td><%= student.present_days %></td>
                                        <td class="attendance-percentage"><%= percentage %>%</td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } else if (query.term) { %>
                <div class="empty-state">
                    <i class="bi bi-emoji-smile"></i>
                    <p>Great! No students found with attendance below <%= query.threshold %>%.</p>
                </div>
            <% } %>
        </main>
        <%- include('../../partials/footer') %>
