<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content attendance-monthly-register-page">
            <header class="content-header no-print">
                <div class="header-left">
                    <a href="/reports/attendance" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
                    <h1>Monthly Attendance Register</h1>
                </div>
                <div class="header-actions">
                    <button class="btn btn-primary btn-export" data-filename="attendance_register.csv">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                    </button>
                    <button onclick="window.print()" class="btn btn-secondary">
                        <i class="bi bi-printer"></i> Print Register
                    </button>
                </div>
            </header>

            <div class="card no-print settings-card">
                <form action="/reports/attendance/register" method="GET" class="filter-form">
                    <div class="form-group">
                        <label>Class</label>
                        <select name="class_id" required>
                            <option value="">Select Class</option>
                            <% if (typeof classes !== 'undefined' && classes && classes.length > 0) { %>
                                <% classes.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= query.class_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Month</label>
                        <select name="month" required>
                            <% for (let i = 1; i <= 12; i++) { %>
                                <option value="<%= i %>" <%= query.month == i ? 'selected' : '' %>><%= new Date(0, i - 1).toLocaleString('default', { month: 'long' }) %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Year</label>
                        <select name="year" required>
                            <% const currentYear = new Date().getFullYear(); %>
                            <option value="<%= currentYear %>" <%= query.year == currentYear ? 'selected' : '' %>><%= currentYear %></option>
                            <option value="<%= currentYear - 1 %>" <%= query.year == currentYear - 1 ? 'selected' : '' %>><%= currentYear - 1 %></option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Load</button>
                </form>
            </div>

            <% if (registerData) { %>
                <div class="report-paper landscape">
                    <div class="report-header">
                        <h2>Attendance Register - <%= registerData.class_name %></h2>
                        <p><%= new Date(query.year, query.month - 1).toLocaleString('default', { month: 'long', year: 'numeric' }) %></p>
                    </div>
                    <div class="table-container register-table-container">
                        <table class="report-table register-table">
                            <thead>
                                <tr>
                                    <th class="sticky-col name-col">Student Name</th>
                                    <% registerData.days.forEach(day => { %>
                                        <th class="day-col"><%= day %></th>
                                    <% }) %>
                                    <th class="summary-col">P</th>
                                    <th class="summary-col">A</th>
                                    <th class="summary-col">L</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% registerData.students.forEach(student => { %>
                                    <tr>
                                        <td class="sticky-col name-col"><%= student.last_name.toUpperCase() %>, <%= student.first_name %></td>
                                        <% registerData.days.forEach(day => { %>
                                            <% const status = student.attendance[day]; %>
                                            <td class="status-<%= status ? status.toLowerCase() : 'none' %>">
                                                <% if (status === 'Present') { %>/<% } else if (status === 'Absent') { %>A<% } else if (status === 'Late') { %>L<% } else { %>.<% } %>
                                            </td>
                                        <% }) %>
                                        <td class="summary-col"><strong><%= student.summary.present %></strong></td>
                                        <td class="summary-col"><%= student.summary.absent %></td>
                                        <td class="summary-col"><%= student.summary.late %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <div class="legend no-print">
                        <span><strong>/</strong> Present</span>
                        <span><strong>A</strong> Absent</span>
                        <span><strong>L</strong> Late</span>
                    </div>
                </div>
            <% } %>
        </main>
        <%- include('../../partials/footer') %>
