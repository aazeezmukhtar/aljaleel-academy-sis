<%- include('../partials/header') %>

    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>

            <main class="main-content reports-audit-page system-audit-page">
                <header class="content-header audit-page-header">
                    <div>
                        <h1>System Audit Logs</h1>
                        <p>Track all administrative and academic activities across the system.</p>
                    </div>
                    <div class="audit-header-actions">
                        <button class="btn btn-outline btn-sm" onclick="window.print()"><i class="bi bi-printer"></i>
                            Print Log</button>
                    </div>
                </header>

                <div class="card">
                    <div class="table-container mobile-cards">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Timestamp</th>
                                    <th>User</th>
                                    <th>Module</th>
                                    <th>Action</th>
                                    <th>Details</th>
                                    <th>IP Address</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (logs.length> 0) { %>
                                    <% logs.forEach(log=> { %>
                                        <tr>
                                            <td data-label="Timestamp"
                                                class="audit-timestamp">
                                                <%= new Date(log.timestamp).toLocaleString('en-GB') %>
                                            </td>
                                            <td data-label="User">
                                                <div class="audit-user-cell">
                                                    <strong>
                                                        <%= log.last_name %>, <%= log.first_name %>
                                                    </strong>
                                                    <code
                                                        class="audit-staff-id"><%= log.staff_id %></code>
                                                </div>
                                            </td>
                                            <td data-label="Module">
                                                <span class="badge audit-module-badge">
                                                    <%= log.module %>
                                                </span>
                                            </td>
                                            <td data-label="Action">
                                                <span class="badge audit-action-badge <%= log.action.includes('SAVE') || log.action.includes('UPDATE') ? 'audit-action-success' : (log.action.includes('LOGIN') ? 'audit-action-login' : 'audit-action-default') %>">
                                                    <%= log.action %>
                                                </span>
                                            </td>
                                            <td data-label="Details" class="audit-details-cell">
                                                <div class="audit-details-value">
                                                    <code><%= log.details %></code>
                                                </div>
                                            </td>
                                            <td data-label="IP Address"
                                                class="audit-ip-address">
                                                <%= log.ip_address %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6"
                                                        class="audit-empty-cell">
                                                        No logs available yet.</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
    </div>

    <%- include('../partials/footer') %>