<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content finance-debtors-page finance-report-detail-page finance-debtors-report-page">
            <header class="content-header no-print">
                <div class="header-left">
                    <a href="/reports/finance" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
                    <h1>Debtors List</h1>
                </div>
                <div class="header-actions">
                    <button class="btn btn-primary btn-export" data-filename="debtors_list.csv">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                    </button>
                    <button onclick="window.print()" class="btn btn-secondary">
                        <i class="bi bi-printer"></i> Print List
                    </button>
                </div>
            </header>

            <div class="card no-print settings-card">
                <form action="/reports/finance/debtors" method="GET" class="filter-form">
                    <div class="form-group">
                        <label>Minimum Debt (₦)</label>
                        <input type="number" name="min_debt" value="<%= query.min_debt %>">
                    </div>
                    <button type="submit" class="btn btn-danger">Find Debtors</button>
                </form>
            </div>

            <% if (debtors && debtors.length> 0) { %>
                <div class="report-paper">
                    <div class="report-header">
                        <h2>Outstanding Fees Debtors List</h2>
                        <p>Generated on <%= new Date().toLocaleDateString('en-GB') %>
                        </p>
                    </div>

                    <table class="report-table">
                        <thead>
                            <tr>
                                <th class="finance-report-number">S/N</th>
                                <th>Adm No.</th>
                                <th>Student Name</th>
                                <th>Class</th>
                                <th>Payable</th>
                                <th>Paid</th>
                                <th>Outstanding Debt</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% debtors.forEach((student, index)=> { %>
                                <tr>
                                    <td>
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <%= student.admission_number %>
                                    </td>
                                    <td class="finance-student-name">
                                        <%= student.last_name.toUpperCase() %>, <%= student.first_name %>
                                    </td>
                                    <td>
                                        <%= student.class_name %>
                                    </td>
                                    <td>
                                        <%= student.payable.toLocaleString() %>
                                    </td>
                                    <td>
                                        <%= student.paid.toLocaleString() %>
                                    </td>
                                    <td class="finance-debt-value">
                                        <%= student.debt.toLocaleString() %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                    <div class="empty-state">
                        <i class="bi bi-check-circle-fill finance-empty-success"></i>
                        <h3>No Major Debtors</h3>
                        <p>There are no students owing more than ₦<%= query.min_debt.toLocaleString() %>.</p>
                    </div>
                    <% } %>
        </main>

<%- include('../../partials/footer') %>