<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content finance-reports-page reports-finance-page finance-reports-index-page">
            <header class="content-header">
                <a href="/reports" class="back-link"><i class="bi bi-arrow-left"></i> Back to Report Center</a>
                <h1>Finance Reports</h1>
                <p>Financial overview, fee collections, and outstanding balances.</p>
            </header>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon" class="finance-stat-collected">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                    <div class="stat-info">
                        <h3>₦<%= stats.total_collected_session.toLocaleString() %>
                        </h3>
                        <p>Total Collected (Session)</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" class="finance-stat-today">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="stat-info">
                        <h3>₦<%= stats.total_payment_today.toLocaleString() %>
                        </h3>
                        <p>Collected Today</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" class="finance-stat-outstanding">
                        <i class="bi bi-graph-down-arrow"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Check Report</h3>
                        <p>Outstanding Fees</p>
                    </div>
                </div>
            </div>

            <div class="report-dashboard-grid">
                <a href="/reports/finance/status" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-credit-card-2-front-fill"></i>
                    </div>
                    <div class="report-info">
                        <h3>Fee Status Report</h3>
                        <p>Check paid and unpaid status per class.</p>
                    </div>
                </a>

                <a href="/reports/finance/debtors" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-exclamation-circle-fill"></i>
                    </div>
                    <div class="report-info">
                        <h3>Debtors List</h3>
                        <p>Generate list of students owing fees.</p>
                    </div>
                </a>

                <a href="/fees/manager" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <div class="report-info">
                        <h3>Fee Manager</h3>
                        <p>Go to main Fee Management dashboard.</p>
                    </div>
                </a>
            </div>
        </main>

<%- include('../../partials/footer') %>