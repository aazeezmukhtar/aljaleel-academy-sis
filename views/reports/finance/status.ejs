<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content finance-status-page finance-report-detail-page finance-status-report-page">
            <header class="content-header no-print">
                <div class="header-left">
                    <a href="/reports/finance" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
                    <h1>Fee Status Report</h1>
                </div>
                <div class="header-actions">
                    <button class="btn btn-primary btn-export" data-filename="fee_status.csv">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                    </button>
                    <button onclick="window.print()" class="btn btn-secondary">
                        <i class="bi bi-printer"></i> Print Report
                    </button>
                </div>
            </header>

            <div class="card no-print settings-card">
                <form action="/reports/finance/status" method="GET" class="filter-form">
                    <div class="form-group">
                        <label>Class</label>
                        <select name="class_id" required>
                            <option value="">Select Class</option>
                            <% if (typeof classes !== 'undefined' && classes && classes.length > 0) { %>
                                <% classes.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= query.class_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Status Filter</label>
                        <select name="status">
                            <option value="">All Statuses</option>
                            <option value="Paid" <%=query.status==='Paid' ? 'selected' : '' %>>Paid</option>
                            <option value="Partial" <%=query.status==='Partial' ? 'selected' : '' %>>Partial Payment
                            </option>
                            <option value="Unpaid" <%=query.status==='Unpaid' ? 'selected' : '' %>>Unpaid</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Generate</button>
                </form>
            </div>

            <% if (students && students.length> 0) { %>
                <div class="report-paper">
                    <div class="report-header">
                        <h2>School Fee Status Report</h2>
                        <p>
                            <%= students[0].class_name %> - Generated <%= new Date().toLocaleDateString('en-GB') %>
                        </p>
                    </div>

                    <table class="report-table">
                        <thead>
                            <tr>
                                <th class="finance-report-number">S/N</th>
                                <th>Adm No.</th>
                                <th>Student Name</th>
                                <th>Payable</th>
                                <th>Paid</th>
                                <th>Balance</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach((student, index)=> { %>
                                <tr>
                                    <td>
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <%= student.admission_number %>
                                    </td>
                                    <td class="finance-student-name">
                                        <%= student.last_name.toUpperCase() %>, <%= student.first_name %>
                                    </td>
                                    <td>
                                        <%= student.total_payable.toLocaleString() %>
                                    </td>
                                    <td>
                                        <%= student.paid_amount.toLocaleString() %>
                                    </td>
                                    <td>
                                        <%= student.balance.toLocaleString() %>
                                    </td>
                                    <td>
                                        <span class="status-badge <%= student.status.toLowerCase() %>">
                                            <%= student.status %>
                                        </span>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else if (query.class_id) { %>
                    <div class="empty-state">
                        <i class="bi bi-search"></i>
                        <p>No records found for this criteria.</p>
                    </div>
                    <% } %>
        </main>

<%- include('../../partials/footer') %>