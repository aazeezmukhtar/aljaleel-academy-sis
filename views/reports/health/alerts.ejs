<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content health-report-detail-page health-alerts-page">
            <header class="content-header no-print">
                <div class="header-left">
                    <a href="/reports/health" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
                    <h1>Medical Alerts</h1>
                </div>
                <div class="header-actions">
                    <button class="btn btn-primary btn-export" data-filename="medical_alerts.csv">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                    </button>
                    <button onclick="window.print()" class="btn btn-secondary">
                        <i class="bi bi-printer"></i> Print List
                    </button>
                </div>
            </header>

            <div class="card no-print settings-card">
                <form action="/reports/health/alerts" method="GET" class="filter-form">
                    <div class="form-group">
                        <label>Class</label>
                        <select name="class_id" class="form-control">
                            <option value="">All Classes</option>
                            <% if (typeof classes !== 'undefined' && classes && classes.length > 0) { %>
                                <% classes.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= query.class_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                <div class="report-paper">
                    <div class="report-header">
                        <h2 class="health-alert-report-title">Medical Alert Report</h2>
                        <p>Confidential - Generated <%= new Date().toLocaleDateString('en-GB') %>
                        </p>
                    </div>

                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Student Name</th>
                                <th>Class</th>
                                <th>Medical Conditions</th>
                                <th>Allergies</th>
                                <th>Blood Group</th>
                                <th>Emergency Contact</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% medicalRisks.forEach((student)=> { %>
                                <tr>
                                    <td class="health-student-name-cell">
                                        <%= student.last_name.toUpperCase() %>, <%= student.first_name %>
                                    </td>
                                    <td>
                                        <%= student.class_name %>
                                    </td>
                                    <td>
                                        <% if(student.medical_conditions) { %>
                                            <span class="alert-tag condition">
                                                <%= student.medical_conditions %>
                                            </span>
                                            <% } else { %> - <% } %>
                                    </td>
                                    <td>
                                        <% if(student.allergies) { %>
                                            <span class="alert-tag allergy">
                                                <%= student.allergies %>
                                            </span>
                                            <% } else { %> - <% } %>
                                    </td>
                                    <td>
                                        <%= student.blood_group || '-' %>
                                    </td>
                                    <td>
                                        <%= student.emergency_contact_phone || '-' %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                    <div class="empty-state">
                        <i class="bi bi-heart-pulse"></i>
                        <p>No medical alerts found for the selected criteria.</p>
                    </div>
                    <% } %>
        </main>



        <%- include('../../partials/footer') %>