<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content health-report-detail-page health-contacts-page">
            <header class="content-header no-print">
                <div class="header-left">
                    <a href="/reports/health" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
                    <h1>Emergency Contacts</h1>
                </div>
                <div class="header-actions">
                    <button class="btn btn-primary btn-export" data-filename="emergency_contacts.csv">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                    </button>
                    <button onclick="window.print()" class="btn btn-secondary">
                        <i class="bi bi-printer"></i> Print List
                    </button>
                </div>
            </header>

            <div class="card no-print settings-card">
                <form action="/reports/health/contacts" method="GET" class="filter-form">
                    <div class="form-group">
                        <label>Class</label>
                        <select name="class_id" required>
                            <option value="">Select Class</option>
                            <% if (typeof classes !== 'undefined' && classes && classes.length > 0) { %>
                                <% classes.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= query.class_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                <div class="report-paper">
                    <div class="report-header">
                        <h2>Emergency Contact List</h2>
                        <p>
                            <%= contacts[0].class_name %> - <%= new Date().toLocaleDateString('en-GB') %>
                        </p>
                    </div>

                    <table class="report-table">
                        <thead>
                            <tr>
                                <th class="health-contact-number">S/N</th>
                                <th>Student Name</th>
                                <th>Contact Person</th>
                                <th>Phone Number</th>
                                <th>Blood Group</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% contacts.forEach((contact, index)=> { %>
                                <tr>
                                    <td>
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <%= contact.last_name.toUpperCase() %>, <%= contact.first_name %>
                                    </td>
                                    <td>
                                        <%= contact.contact_name || 'N/A' %>
                                    </td>
                                    <td class="health-contact-phone">
                                        <%= contact.contact_phone || 'N/A' %>
                                    </td>
                                    <td>
                                        <%= contact.blood_group || '-' %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else if (query.class_id) { %>
                    <div class="empty-state">
                        <i class="bi bi-person-lines-fill"></i>
                        <p>No student contacts found for this class.</p>
                    </div>
                    <% } %>
        </main>



        <%- include('../../partials/footer') %>