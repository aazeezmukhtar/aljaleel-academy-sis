<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content reports-health-page health-reports-index-page">
            <header class="content-header">
                <a href="/reports" class="back-link"><i class="bi bi-arrow-left"></i> Back to Report Center</a>
                <h1>Health & Wellness Reports</h1>
                <p>Medical records, emergency contacts, and health insights.</p>
            </header>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon health-stat-condition">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.students_with_conditions %>
                        </h3>
                        <p>Medical Conditions</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon health-stat-allergy">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.students_with_allergies %>
                        </h3>
                        <p>Recorded Allergies</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon health-stat-blood">
                        <i class="bi bi-droplet-fill"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.blood_group_a %>
                        </h3>
                        <p>Blood Group 'A'</p>
                    </div>
                </div>
            </div>

            <div class="report-dashboard-grid">
                <a href="/reports/health/alerts" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-clipboard2-pulse-fill"></i>
                    </div>
                    <div class="report-info">
                        <h3>Medical Alerts</h3>
                        <p>View students with specific medical conditions or allergies.</p>
                    </div>
                </a>

                <a href="/reports/health/contacts" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-telephone-fill"></i>
                    </div>
                    <div class="report-info">
                        <h3>Emergency Contacts</h3>
                        <p>Printable list of emergency contact details per class.</p>
                    </div>
                </a>
            </div>
        </main>



        <%- include('../../partials/footer') %>