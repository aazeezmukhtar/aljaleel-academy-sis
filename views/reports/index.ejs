<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

        <main class="main-content reports-center-page">
            <header class="content-header">
                <h1>Report Center</h1>
                <p>Comprehensive insights and analytical reports.</p>
            </header>

            <div class="report-dashboard-grid">
                <a href="/reports/academic" class="report-card"><div class="report-icon academic"><i class="bi bi-mortarboard-fill"></i></div><div class="report-info"><h3>Academic & Results</h3><p>Broadsheets, Master Sheets, Trend Analysis, and Report Cards.</p></div></a>
                <a href="/reports/students" class="report-card"><div class="report-icon student"><i class="bi bi-people-fill"></i></div><div class="report-info"><h3>Student Demographics</h3><p>Class Lists, Gender Stats, Admission Rates, and Profile Audits.</p></div></a>
                <a href="/reports/attendance" class="report-card"><div class="report-icon attendance"><i class="bi bi-calendar-check-fill"></i></div><div class="report-info"><h3>Attendance & Registers</h3><p>Daily Registers, Monthly Summaries, and Low Attendance Alerts.</p></div></a>
                <% if (user.role==='Admin' || user.role==='Bursar' ) { %>
                    <a href="/reports/fees" class="report-card"><div class="report-icon finance"><i class="bi bi-wallet-fill"></i></div><div class="report-info"><h3>Finance & Fees</h3><p>Fee Status, Debtors Lists, Collections, and Receipt History.</p></div></a>
                <% } %>
                <% if (user.role==='Admin' ) { %>
                    <a href="/reports/staff" class="report-card"><div class="report-icon staff"><i class="bi bi-person-badge-fill"></i></div><div class="report-info"><h3>Staff & HR</h3><p>Staff Directory, Workload Analysis, and Activity Logs.</p></div></a>
                <% } %>
                <a href="/reports/health" class="report-card"><div class="report-icon health"><i class="bi bi-heart-pulse-fill"></i></div><div class="report-info"><h3>Health & Wellness</h3><p>Medical Alerts, Emergency Contacts, and Health Stats.</p></div></a>
                <% if (user.role==='Admin' ) { %>
                    <a href="/reports/audit" class="report-card"><div class="report-icon audit"><i class="bi bi-shield-lock-fill"></i></div><div class="report-info"><h3>System Management</h3><p>System Audit Logs, Access Control, and Security Events.</p></div></a>
                <% } %>
            </div>
        </main>
        <%- include('../partials/footer') %>
