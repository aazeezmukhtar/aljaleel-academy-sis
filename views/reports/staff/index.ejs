<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content reports-staff-page staff-reports-index-page">
            <header class="content-header">
                <a href="/reports" class="back-link"><i class="bi bi-arrow-left"></i> Back to Report Center</a>
                <h1>Staff Reports</h1>
                <p>Human Resources and Performance Analysis.</p>
            </header>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon staff-stat-total">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.total_staff %>
                        </h3>
                        <p>Total Staff</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon staff-stat-teaching">
                        <i class="bi bi-person-video3"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.teaching_staff %>
                        </h3>
                        <p>Teaching Staff</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon staff-stat-admin">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.admins %>
                        </h3>
                        <p>Administrators</p>
                    </div>
                </div>
            </div>

            <div class="report-dashboard-grid">
                <a href="/reports/staff/directory" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <div class="report-info">
                        <h3>Staff Directory</h3>
                        <p>View and print list of all active staff members.</p>
                    </div>
                </a>

                <a href="/reports/staff/workload" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                    <div class="report-info">
                        <h3>Workload Analysis</h3>
                        <p>See assigned classes and subjects per teacher.</p>
                    </div>
                </a>

                <a href="/reports/staff/activity" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-activity"></i>
                    </div>
                    <div class="report-info">
                        <h3>Activity Logs</h3>
                        <p>Track system usage and actions by staff members.</p>
                    </div>
                </a>
            </div>
        </main>



        <%- include('../../partials/footer') %>