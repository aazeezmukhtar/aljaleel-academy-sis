<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content staff-report-detail-page staff-workload-report-page">
            <header class="content-header no-print">
                <div class="header-left">
                    <a href="/reports/staff" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
                    <h1>Workload Analysis</h1>
                </div>
                <div class="header-actions">
                    <button class="btn btn-primary btn-export" data-filename="staff_workload.csv">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                    </button>
                    <button onclick="window.print()" class="btn btn-secondary">
                        <i class="bi bi-printer"></i> Print Report
                    </button>
                </div>
            </header>

            <div class="report-paper">
                <div class="report-header">
                    <h2>Teaching Staff Workload</h2>
                    <p>Current session assignments (section-specific sessions are respected)</p>
                </div>

                <table class="report-table">
                    <thead>
                        <tr>
                            <th class="staff-report-number">S/N</th>
                            <th>Teacher Name</th>
                            <th>Assigned Classes</th>
                            <th>Assigned Subjects</th>
                            <th>Total Load</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% staffWorkload.forEach((staff, index)=> { %>
                            <tr>
                                <td>
                                    <%= index + 1 %>
                                </td>
                                <td>
                                    <%= staff.last_name.toUpperCase() %>, <%= staff.first_name %>
                                </td>
                                <td>
                                    <%= staff.classes || '-' %>
                                </td>
                                <td>
                                    <%= staff.subjects || '-' %>
                                </td>
                                <td>
                                    <%= staff.class_count %> Classes, <%= staff.subject_count %> Subjects
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </main>



        <%- include('../../partials/footer') %>