<%- include('../../partials/header') %>
    <%- include('../../partials/sidebar') %>

        <main class="main-content reports-student-page student-reports-index-page">
            <header class="content-header">
                <a href="/reports" class="back-link"><i class="bi bi-arrow-left"></i> Back to Report Center</a>
                <h1>Student Reports</h1>
                <p>Demographics, Class Lists, and Enrollment Statistics.</p>
            </header>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon student-stat-total">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.total %>
                        </h3>
                        <p>Total Active Students</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon student-stat-male">
                        <i class="bi bi-gender-male"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.males %>
                        </h3>
                        <p>Male Students</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon student-stat-female">
                        <i class="bi bi-gender-female"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.females %>
                        </h3>
                        <p>Female Students</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon student-stat-intake">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <div class="stat-info">
                        <h3>
                            <%= stats.new_intake %>
                        </h3>
                        <p>New Intake (<%= new Date().getFullYear() %>)</p>
                    </div>
                </div>
            </div>

            <div class="report-dashboard-grid">
                <a href="/reports/students/list" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-list-task"></i>
                    </div>
                    <div class="report-info">
                        <h3>Class Lists</h3>
                        <p>Generate printable lists for any class.</p>
                    </div>
                </a>

                <a href="/reports/students/demographics" class="report-card">
                    <div class="report-icon">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                    <div class="report-info">
                        <h3>Demographics</h3>
                        <p>Analyze gender ratio, age distribution, and more.</p>
                    </div>
                </a>

                <% if (user.role==='Admin' ) { %>
                    <a href="/reports/students/audit" class="report-card">
                        <div class="report-icon">
                            <i class="bi bi-shield-exclamation"></i>
                        </div>
                        <div class="report-info">
                            <h3>Profile Audit</h3>
                            <p>Identify students with missing photos or contact info.</p>
                        </div>
                    </a>
                    <% } %>
            </div>
        </main>

<%- include('../../partials/footer') %>