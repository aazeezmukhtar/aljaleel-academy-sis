<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

        <main class="main-content results-bulk-select-page">
            <header class="content-header">
                <a href="/reports/academic" class="back-link"><i class="bi bi-arrow-left"></i> Back to Academic
                    Reports</a>
                <h1><i class="bi bi-card-checklist"></i> Print Report Cards</h1>
                <p>Select a class and academic period to generate report cards for all students.</p>
            </header>

            <% if (error) { %>
                <div class="alert alert-danger results-bulk-error">
                    <i class="bi bi-exclamation-triangle"></i>
                    <%= error %>
                </div>
                <% } %>

                    <div class="card results-bulk-card">
                        <div class="card-body results-bulk-card-body">
                            <form id="bulkReportForm" method="GET" action="/results/bulk">
                                <div class="form-group results-bulk-field">
                                    <label for="class_id"
                                        class="results-bulk-label">
                                        <i class="bi bi-building"></i> Class
                                    </label>
                                    <select name="class_id" id="class_id" class="form-control" required
                                        >
                                        <option value="">-- Select Class --</option>
                                        <% classes.forEach(c=> { %>
                                            <option value="<%= c.id %>" <%=filters.class_id==c.id ? 'selected' : '' %>>
                                                <%= c.name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>

                                <div class="form-group" style="margin-bottom: 20px;">
                                    <label for="term"
                                        style="display: block; margin-bottom: 8px; font-weight: 600; color: var(--text-dark);">
                                        <i class="bi bi-calendar3"></i> Term
                                    </label>
                                    <select name="term" id="term" class="form-control" required
                                        style="width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 0.95rem;">
                                        <option value="">-- Select Term --</option>
                                        <option value="1st Term" <%=filters.term==='1st Term' ? 'selected' : '' %>>1st
                                            Term</option>
                                        <option value="2nd Term" <%=filters.term==='2nd Term' ? 'selected' : '' %>>2nd
                                            Term</option>
                                        <option value="3rd Term" <%=filters.term==='3rd Term' ? 'selected' : '' %>>3rd
                                            Term</option>
                                        <option value="Cumulative" <%=filters.term==='Cumulative' ? 'selected' : '' %>>Cumulative
                                            (Full Session)</option>
                                    </select>
                                </div>

                                <div class="form-group results-bulk-field results-bulk-field--last">
                                    <label for="session"
                                        style="display: block; margin-bottom: 8px; font-weight: 600; color: var(--text-dark);">
                                        <i class="bi bi-journal-text"></i> Session
                                    </label>
                                     <select name="session" id="session" class="form-control" required
                                         style="width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 0.95rem;">
                                         <option value="">-- Select Session --</option>
                                         <% 
                                         const sessList = (typeof availableSessions !== 'undefined' && availableSessions && availableSessions.length > 0) 
                                             ? availableSessions 
                                             : ((typeof available_sessions !== 'undefined' && available_sessions && available_sessions.length > 0) 
                                                 ? available_sessions 
                                                 : ['2024/2025', '2025/2026']);
                                         sessList.forEach(s => { 
                                         %>
                                             <option value="<%= s %>" <%= filters.session === s ? 'selected' : '' %>><%= s %></option>
                                         <% }); %>
                                     </select>
                                </div>

                                <% if (typeof user !== 'undefined' && user.role === 'Admin') { %>
                                    <div class="results-bulk-actions results-bulk-actions--admin">
                                        <button type="submit" class="btn btn-primary"
                                            class="btn btn-primary results-bulk-action">
                                            <i class="bi bi-printer"></i> Generate Report Cards
                                        </button>
                                        <button type="button" class="btn" onclick="publishBulk()"
                                            class="btn results-bulk-action results-bulk-publish">
                                            <i class="bi bi-check-all"></i> Publish Results
                                        </button>
                                    </div>
                                <% } else { %>
                                    <button type="submit" class="btn btn-primary"
                                        class="btn btn-primary results-bulk-action">
                                        <i class="bi bi-printer"></i> Generate Report Cards
                                    </button>
                                <% } %>
                            </form>
                        </div>
                    </div>
        </main>

        <script>
            async function publishBulk() {
                const class_id = document.getElementById('class_id').value;
                const term = document.getElementById('term').value;
                const session = document.getElementById('session').value;

                if (!term || !session) return alert('Session and Term are strictly required to publish results.');
                
                let confirmMsg = `Are you sure you want to PUBLISH results for ${term} ${session}?`;
                if (!class_id) {
                    confirmMsg = `WARNING: You did not select a Class! This will publish ALL RESULTS IN THE SYSTEM for ${term} ${session}. Do you want to proceed?`;
                }

                if (!confirm(confirmMsg)) return;

                try {
                    const res = await fetch('/results/publish-bulk', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ class_id, term, session })
                    });
                    const data = await res.json();
                    alert(data.message);
                } catch (err) {
                    alert('Network error while attempting to publish results.');
                }
            }
        </script>



        <%- include('../partials/footer') %>