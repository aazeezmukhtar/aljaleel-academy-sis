<%- include('../partials/header') %>

<div class="dashboard-container">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <header class="content-header">
            <div>
                <a href="/staff" class="staff-back-link">&larr; Back to Directory</a>
                <h1>Register New Staff</h1>
                <p class="text-muted">Create a staff account and set their school profile.</p>
            </div>
        </header>

        <section class="card staff-form-card">
            <form action="/staff/add" method="POST" class="enroll-form" enctype="multipart/form-data">
                <div class="grid-2">
                    <div class="form-group">
                        <label for="staff-first-name">First Name</label>
                        <input id="staff-first-name" type="text" name="first_name" placeholder="Enter first name" required class="form-control" autocomplete="given-name">
                    </div>
                    <div class="form-group">
                        <label for="staff-last-name">Last Name</label>
                        <input id="staff-last-name" type="text" name="last_name" placeholder="Enter last name" required class="form-control" autocomplete="family-name">
                    </div>
                    <div class="form-group">
                        <label for="staff-login-id">Staff ID (Login ID)</label>
                        <input id="staff-login-id" type="text" name="staff_id" placeholder="e.g. teacher01, admin_js" required class="form-control" style="text-transform: lowercase;" autocapitalize="none" spellcheck="false" aria-describedby="staff-login-help">
                        <small id="staff-login-help" class="text-muted">This will be used for login and must be unique.</small>
                    </div>
                    <div class="form-group">
                        <label for="staff-role">System Access Role</label>
                        <select id="staff-role" name="role" required class="form-control">
                            <option value="">-- Select Access --</option>
                            <option value="Admin">Administrator</option>
                            <option value="Teacher">Teacher</option>
                            <option value="Bursar">Bursar</option>
                            <option value="Principal">Principal</option>
                            <option value="Staff">Non-Academic Staff</option>
                        </select>
                        <small class="text-muted">This determines the access available in AcadMe.</small>
                    </div>
                    <div class="form-group">
                        <label for="staff-designation">Designation / Title</label>
                        <input id="staff-designation" type="text" name="designation" placeholder="e.g. Class Teacher, Registrar" required class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="staff-avatar">Profile Photo</label>
                        <input id="staff-avatar" type="file" name="avatar_image" class="form-control" accept="image/*" data-crop="square" aria-describedby="staff-avatar-help">
                        <small id="staff-avatar-help" class="text-muted">Optional. The photo will be cropped before upload and can be displayed on the school website.</small>
                    </div>
                </div>

                <div class="form-group">
                    <label for="staff-public-bio">Public Bio</label>
                    <textarea id="staff-public-bio" name="public_bio" class="form-control" rows="3" placeholder="A brief bio visible on the public school website..."></textarea>
                </div>

                <div class="staff-website-toggle">
                    <input type="checkbox" name="show_on_website" id="show_on_website" value="1">
                    <label for="show_on_website">Show on Public Website (Faculty Section)</label>
                </div>

                <div class="alert alert-info staff-password-note" role="note">
                    <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                    <span><strong>Default password:</strong> <code>[StaffID]123</code>. The staff member should change it after their first login.</span>
                </div>

                <div class="staff-form-actions">
                    <button type="submit" class="btn btn-primary">Register Staff Member</button>
                    <a href="/staff" class="btn btn-outline">Cancel</a>
                </div>
            </form>
        </section>
    </main>
</div>

<style>
    .staff-form-card { max-width: 900px; }
    .staff-back-link { display: inline-block; margin-bottom: 12px; color: var(--primary); font-weight: 600; }
    .staff-website-toggle { display: flex; align-items: center; gap: 12px; margin: 18px 0; }
    .staff-website-toggle input { width: 20px; height: 20px; flex: 0 0 auto; }
    .staff-website-toggle label { margin: 0; cursor: pointer; font-weight: 600; }
    .staff-password-note { display: flex; align-items: flex-start; gap: 10px; margin-top: 20px; }
    .staff-form-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
    @media (max-width: 600px) {
        .staff-form-actions .btn { width: 100%; }
    }
</style>

<%- include('../partials/footer') %>
