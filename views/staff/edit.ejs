<%- include('../partials/header') %>

<div class="dashboard-container">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <header class="content-header">
            <div>
                <h1>Edit Staff</h1>
                <p class="text-muted">Update profile for <%= member.first_name %> <%= member.last_name %></p>
            </div>
            <a href="/staff/view/<%= member.id %>" class="btn btn-outline">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Profile
            </a>
        </header>

        <section class="card staff-form-card">
            <form action="/staff/update/<%= member.id %>" method="POST" enctype="multipart/form-data">
                <div class="grid-2">
                    <div class="form-group">
                        <label for="edit-staff-first-name">First Name</label>
                        <input id="edit-staff-first-name" type="text" name="first_name" class="form-control" value="<%= member.first_name %>" required autocomplete="given-name">
                    </div>
                    <div class="form-group">
                        <label for="edit-staff-last-name">Last Name</label>
                        <input id="edit-staff-last-name" type="text" name="last_name" class="form-control" value="<%= member.last_name %>" required autocomplete="family-name">
                    </div>
                    <div class="form-group">
                        <label for="edit-staff-login-id">Staff ID (Login ID)</label>
                        <input id="edit-staff-login-id" type="text" name="staff_id" class="form-control" value="<%= member.staff_id %>" required autocapitalize="none" spellcheck="false">
                    </div>
                    <div class="form-group">
                        <label for="edit-staff-designation">Designation</label>
                        <input id="edit-staff-designation" type="text" name="designation" class="form-control" value="<%= member.designation || '' %>" placeholder="e.g. Senior Teacher">
                    </div>
                    <div class="form-group">
                        <label for="edit-staff-role">System Access Role</label>
                        <select id="edit-staff-role" name="role" class="form-control" required>
                            <option value="Teacher" <%=member.role==='Teacher' ? 'selected' : '' %>>Teacher</option>
                            <option value="Admin" <%=member.role==='Admin' ? 'selected' : '' %>>Admin</option>
                            <option value="Bursar" <%=member.role==='Bursar' ? 'selected' : '' %>>Bursar</option>
                            <option value="Principal" <%=member.role==='Principal' ? 'selected' : '' %>>Principal</option>
                            <option value="Staff" <%=member.role==='Staff' ? 'selected' : '' %>>Non-Academic Staff</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="edit-staff-status">Employment Status</label>
                        <select id="edit-staff-status" name="status" class="form-control" required>
                            <option value="active" <%=member.status==='active' ? 'selected' : '' %>>Active</option>
                            <option value="suspended" <%=member.status==='suspended' ? 'selected' : '' %>>Suspended</option>
                            <option value="inactive" <%=member.status==='inactive' ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="edit-staff-avatar">Profile Photo</label>
                        <input id="edit-staff-avatar" type="file" name="avatar_image" class="form-control" accept="image/*" data-crop="square" aria-describedby="edit-staff-avatar-help">
                        <small id="edit-staff-avatar-help" class="text-muted">Optional. Select a new photo only if you want to replace the current one.</small>
                        <% if (member.avatar_image) { %>
                            <div class="staff-current-photo">
                                <img src="<%= member.avatar_image %>" alt="Current profile photo of <%= member.first_name %> <%= member.last_name %>">
                                <span class="text-muted">Current profile photo</span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="form-group">
                    <label for="edit-staff-public-bio">Public Bio</label>
                    <textarea id="edit-staff-public-bio" name="public_bio" class="form-control" rows="3" placeholder="A brief bio visible on the public school website..."><%= member.public_bio || '' %></textarea>
                </div>

                <div class="staff-website-toggle">
                    <input type="checkbox" name="show_on_website" id="edit-show-on-website" value="1" <%= member.show_on_website ? 'checked' : '' %>>
                    <label for="edit-show-on-website">Show on Public Website (Faculty Section)</label>
                </div>

                <div class="staff-form-actions">
                    <button type="submit" class="btn btn-primary">Update Staff Profile</button>
                    <a href="/staff/view/<%= member.id %>" class="btn btn-outline">Cancel</a>
                </div>
            </form>
        </section>
    </main>
</div>

<style>
    .staff-form-card { max-width: 900px; }
    .staff-website-toggle { display: flex; align-items: center; gap: 12px; margin: 18px 0; }
    .staff-website-toggle input { width: 20px; height: 20px; flex: 0 0 auto; }
    .staff-website-toggle label { margin: 0; cursor: pointer; font-weight: 600; }
    .staff-current-photo { display: flex; align-items: center; gap: 10px; margin-top: 10px; flex-wrap: wrap; }
    .staff-current-photo img { width: 64px; height: 64px; object-fit: cover; border-radius: 12px; }
    .staff-form-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
    @media (max-width: 600px) {
        .staff-form-actions .btn { width: 100%; }
    }
</style>

<%- include('../partials/footer') %>
