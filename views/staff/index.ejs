<%- include('../partials/header') %>

<div class="dashboard-container">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <header class="content-header">
            <div>
                <h1>Staff Directory</h1>
                <p class="text-muted">Manage all school personnel and teachers.</p>
            </div>
            <a href="/staff/add" class="btn btn-primary">
                <i class="bi bi-person-plus-fill" aria-hidden="true"></i> Register New Staff
            </a>
        </header>

        <section class="card staff-directory-card" aria-label="Staff directory filters">
            <div class="staff-directory-filters">
                <div class="form-group staff-search-field">
                    <label for="staff-directory-search">Search staff</label>
                    <input type="search" id="staff-directory-search" class="form-control" placeholder="Search by name, staff ID or designation" autocomplete="off">
                </div>
                <div class="form-group">
                    <label for="staff-role-filter">System role</label>
                    <select id="staff-role-filter" class="form-control">
                        <option value="">All roles</option>
                        <option value="admin">Admin</option>
                        <option value="teacher">Teacher</option>
                        <option value="bursar">Bursar</option>
                        <option value="principal">Principal</option>
                        <option value="staff">Staff</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="staff-status-filter">Employment status</label>
                    <select id="staff-status-filter" class="form-control">
                        <option value="">All statuses</option>
                        <option value="active">Active</option>
                        <option value="suspended">Suspended</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
            </div>
            <p id="staff-directory-count" class="text-muted staff-directory-count" role="status" aria-live="polite"></p>
        </section>

        <section class="card">
            <div class="table-container table-stack">
                <table class="data-table" id="staff-directory-table">
                    <thead>
                        <tr>
                            <th scope="col">Staff ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Designation</th>
                            <th scope="col">System Role</th>
                            <th scope="col">Status</th>
                            <th scope="col" style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (staff && staff.length > 0) { %>
                            <% staff.forEach(member => { %>
                                <tr data-search="<%= [member.staff_id, member.first_name, member.last_name, member.designation].filter(Boolean).join(' ').toLowerCase() %>"
                                    data-role="<%= (member.role || '').toLowerCase() %>"
                                    data-status="<%= (member.status || 'unknown').toLowerCase() %>">
                                    <td data-label="Staff ID">
                                        <code class="staff-id-chip"><%= member.staff_id %></code>
                                    </td>
                                    <td data-label="Name">
                                        <strong><%= member.first_name %> <%= member.last_name %></strong>
                                    </td>
                                    <td data-label="Designation"><%= member.designation || '—' %></td>
                                    <td data-label="System Role">
                                        <% if (member.role === 'Admin') { %>
                                            <span class="badge staff-role-admin">Admin</span>
                                        <% } else if (member.role === 'Teacher') { %>
                                            <span class="badge staff-role-teacher">Teacher</span>
                                        <% } else { %>
                                            <span class="badge staff-role-other"><%= member.role || 'Staff' %></span>
                                        <% } %>
                                    </td>
                                    <td data-label="Status">
                                        <span class="badge <%= member.status === 'active' ? 'badge-success' : 'badge-danger' %>">
                                            <%= member.status || 'Unknown' %>
                                        </span>
                                    </td>
                                    <td data-label="Action" class="staff-directory-action">
                                        <a href="/staff/view/<%= member.id %>" class="btn btn-sm btn-outline">View Profile</a>
                                    </td>
                                </tr>
                            <% }); %>
                            <tr id="staff-directory-no-results" hidden>
                                <td colspan="6" class="staff-directory-empty">No staff match these filters. Try changing your search.</td>
                            </tr>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="staff-directory-empty">
                                    No staff members found. <a href="/staff/add">Register the first one</a>.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

<style>
    .staff-directory-card { padding: 20px; }
    .staff-directory-filters {
        display: grid;
        grid-template-columns: minmax(220px, 2fr) repeat(2, minmax(150px, 1fr));
        gap: 16px;
        align-items: end;
    }
    .staff-directory-filters .form-group { margin: 0; min-width: 0; }
    .staff-directory-count { margin: 12px 0 0; font-size: 0.85rem; }
    .staff-id-chip { background: #f1f5f9; padding: 4px 8px; border-radius: 4px; color: var(--school-primary); font-weight: 700; }
    .staff-role-admin { background: #fee2e2; color: #b91c1c; }
    .staff-role-teacher { background: #dcfce7; color: #15803d; }
    .staff-role-other { background: #f1f5f9; color: #64748b; }
    .staff-directory-action { text-align: right; }
    .staff-directory-empty { text-align: center; padding: 36px 16px !important; color: var(--text-muted); }
    @media (max-width: 768px) {
        .staff-directory-filters { grid-template-columns: 1fr; gap: 12px; }
        .staff-directory-action { text-align: left; }
        .staff-directory-action .btn { min-height: 40px; }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('staff-directory-search');
        const roleFilter = document.getElementById('staff-role-filter');
        const statusFilter = document.getElementById('staff-status-filter');
        const count = document.getElementById('staff-directory-count');
        const noResults = document.getElementById('staff-directory-no-results');
        const rows = Array.from(document.querySelectorAll('#staff-directory-table tbody tr[data-search]'));

        if (!searchInput || !roleFilter || !statusFilter || !count) return;

        function filterStaff() {
            const query = searchInput.value.trim().toLowerCase();
            const role = roleFilter.value;
            const status = statusFilter.value;
            let visible = 0;

            rows.forEach(row => {
                const matches = row.dataset.search.includes(query)
                    && (!role || row.dataset.role === role)
                    && (!status || row.dataset.status === status);
                row.hidden = !matches;
                if (matches) visible += 1;
            });

            if (noResults) noResults.hidden = visible > 0;
            count.textContent = visible + (visible === 1 ? ' staff member shown' : ' staff members shown');
        }

        searchInput.addEventListener('input', filterStaff);
        roleFilter.addEventListener('change', filterStaff);
        statusFilter.addEventListener('change', filterStaff);
        filterStaff();
    });
</script>

<%- include('../partials/footer') %>
