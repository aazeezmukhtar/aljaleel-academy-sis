<%- include('../partials/header') %>
<div class="dashboard-container"><%- include('../partials/sidebar') %><main class="main-content">
<header class="content-header"><div><a href="<%= isOwnProfile?'/dashboard':'/staff/view/'+member.id %>" class="staff-back-link">&larr; Back</a><h1><%= isOwnProfile?'My Profile':'Staff Information' %></h1><p class="text-muted"><%= member.first_name %> <%= member.last_name %> · <%= member.designation||member.role %></p></div></header>
<% if(error){ %><div class="alert alert-danger" role="alert"><%= error %></div><% } %><% if(success){ %><div class="alert alert-success" role="status"><%= success %></div><% } %>
<% if(migrationRequired){ %><section class="card"><h2>Staff information setup required</h2><p>The staff-information database migration has not been installed in this environment. Existing staff accounts and assignments are unaffected. These forms will be available after the migration is approved and applied.</p></section><% }else{ %>
<section class="card staff-info-card"><h2>Personal and contact details</h2><p class="text-muted">Only you can edit these details. Login ID, role and designation remain managed separately.</p>
<% if(isOwnProfile){ %><form method="POST" action="/staff/my-profile/personal"><% }else{ %><div><% } %>
<div class="staff-info-grid">
<div class="form-group"><label for="dob">Date of birth</label><input class="form-control" id="dob" name="date_of_birth" type="date" value="<%= personal&&personal.date_of_birth?String(personal.date_of_birth).slice(0,10):'' %>" <%= isOwnProfile?'':'disabled' %>></div>
<div class="form-group"><label for="gender">Gender</label><select class="form-control" id="gender" name="gender" <%= isOwnProfile?'':'disabled' %>><option value="">Not specified</option><% ['Female','Male','Prefer not to say'].forEach(v=>{ %><option value="<%= v %>" <%= personal&&personal.gender===v?'selected':'' %>><%= v %></option><% }) %></select></div>
<div class="form-group"><label for="phone">Phone</label><input class="form-control" id="phone" name="phone" maxlength="40" value="<%= personal?personal.phone||'':'' %>" <%= isOwnProfile?'':'disabled' %>></div>
<div class="form-group"><label for="alt_phone">Alternate phone</label><input class="form-control" id="alt_phone" name="alternate_phone" maxlength="40" value="<%= personal?personal.alternate_phone||'':'' %>" <%= isOwnProfile?'':'disabled' %>></div>
<div class="form-group"><label for="email">Personal email</label><input class="form-control" id="email" name="personal_email" type="email" maxlength="160" value="<%= personal?personal.personal_email||'':'' %>" <%= isOwnProfile?'':'disabled' %>></div>
<div class="form-group"><label for="nationality">Nationality</label><input class="form-control" id="nationality" name="nationality" maxlength="80" value="<%= personal?personal.nationality||'':'' %>" <%= isOwnProfile?'':'disabled' %>></div>
<div class="form-group"><label for="marital">Marital status</label><select class="form-control" id="marital" name="marital_status" <%= isOwnProfile?'':'disabled' %>><option value="">Not specified</option><% ['Single','Married','Widowed','Divorced','Prefer not to say'].forEach(v=>{ %><option value="<%= v %>" <%= personal&&personal.marital_status===v?'selected':'' %>><%= v %></option><% }) %></select></div>
<div class="form-group staff-wide"><label for="address">Residential address</label><textarea class="form-control" id="address" name="residential_address" rows="2" maxlength="1000" <%= isOwnProfile?'':'disabled' %>><%= personal?personal.residential_address||'':'' %></textarea></div>
</div><% if(isOwnProfile){ %><button class="btn btn-primary" type="submit">Save personal details</button></form><% }else{ %></div><% } %></section>
<section class="card staff-info-card"><h2>Emergency contacts</h2>
<% if(contacts.length){ %><div class="staff-info-list"><% contacts.forEach(c=>{ %><article class="staff-info-item"><div><strong><%= c.contact_name %></strong> <% if(c.is_primary){ %><span class="badge badge-success">Primary</span><% } %><p class="text-muted"><%= c.relationship||'Contact' %> · <%= c.phone %></p></div><% if(isOwnProfile){ %><form method="POST" action="/staff/my-profile/emergency-contacts/<%= c.id %>/delete" onsubmit="return confirm('Remove this contact?')"><button class="btn btn-sm btn-outline" type="submit">Remove</button></form><% } %></article><% }) %></div><% }else{ %><p class="text-muted">No emergency contacts added.</p><% } %>
<% if(isOwnProfile){ %><form method="POST" action="/staff/my-profile/emergency-contacts" class="staff-info-form"><h3>Add emergency contact</h3><div class="staff-info-grid">
<div class="form-group"><label for="contact_name">Full name</label><input class="form-control" id="contact_name" name="contact_name" required maxlength="120"></div><div class="form-group"><label for="relationship">Relationship</label><input class="form-control" id="relationship" name="relationship" maxlength="60"></div><div class="form-group"><label for="contact_phone">Phone</label><input class="form-control" id="contact_phone" name="phone" required maxlength="40"></div><div class="form-group"><label for="contact_alt">Alternate phone</label><input class="form-control" id="contact_alt" name="alternate_phone" maxlength="40"></div><div class="form-group"><label for="contact_email">Email</label><input class="form-control" id="contact_email" name="email" type="email" maxlength="160"></div><div class="form-group"><label for="contact_address">Address</label><input class="form-control" id="contact_address" name="address" maxlength="500"></div></div><label class="staff-check"><input type="checkbox" name="is_primary" value="1"> Make this my primary emergency contact</label><button class="btn btn-primary" type="submit">Add contact</button></form><% } %></section>
<section class="card staff-info-card"><h2>Qualifications</h2><% if(qualifications.length){ %><div class="staff-info-list"><% qualifications.forEach(q=>{ %><article class="staff-info-item"><div><strong><%= q.qualification %></strong> <span class="badge"><%= q.verification_status %></span><p class="text-muted"><%= [q.field_of_study,q.institution,q.award_year].filter(Boolean).join(' · ')||'Details not supplied' %></p></div><% if(isAdmin){ %><form action="/staff/qualifications/<%= q.id %>/review" method="POST" class="staff-review"><button class="btn btn-sm btn-outline" name="verification_status" value="verified">Verify</button><button class="btn btn-sm btn-outline" name="verification_status" value="rejected">Reject</button></form><% } %></article><% }) %></div><% }else{ %><p class="text-muted">No qualifications submitted.</p><% } %>
<% if(isOwnProfile){ %><form action="/staff/my-profile/qualifications" method="POST" class="staff-info-form"><h3>Submit a qualification</h3><div class="staff-info-grid"><div class="form-group"><label for="qualification">Qualification</label><input class="form-control" id="qualification" name="qualification" required maxlength="160" placeholder="e.g. BSc Computer Science"></div><div class="form-group"><label for="field">Field of study</label><input class="form-control" id="field" name="field_of_study" maxlength="160"></div><div class="form-group"><label for="institution">Institution</label><input class="form-control" id="institution" name="institution" maxlength="200"></div><div class="form-group"><label for="year">Award year</label><input class="form-control" id="year" name="award_year" type="number" min="1900" max="<%= new Date().getFullYear()+5 %>"></div><div class="form-group staff-wide"><label for="certificate">Certificate reference (optional)</label><input class="form-control" id="certificate" name="certificate_reference" maxlength="120"></div></div><button class="btn btn-primary" type="submit">Submit qualification</button></form><% } %></section>
<% if(isAdmin&&!isOwnProfile){ %><section class="card staff-info-card"><h2>Employment information</h2><form method="POST" action="/staff/information/<%= member.id %>/employment"><div class="staff-info-grid">
<div class="form-group"><label for="department">Department</label><input class="form-control" id="department" name="department" maxlength="120" value="<%= employment?employment.department||'':'' %>"></div><div class="form-group"><label for="employment_type">Employment type</label><select class="form-control" id="employment_type" name="employment_type"><option value="">Not specified</option><% ['Full-time','Part-time','Contract','Temporary','Volunteer'].forEach(v=>{ %><option value="<%= v %>" <%= employment&&employment.employment_type===v?'selected':'' %>><%= v %></option><% }) %></select></div>
<div class="form-group"><label for="start_date">Start date</label><input class="form-control" id="start_date" name="employment_start_date" type="date" value="<%= employment&&employment.employment_start_date?String(employment.employment_start_date).slice(0,10):'' %>"></div><div class="form-group"><label for="end_date">End date</label><input class="form-control" id="end_date" name="employment_end_date" type="date" value="<%= employment&&employment.employment_end_date?String(employment.employment_end_date).slice(0,10):'' %>"></div>
<div class="form-group"><label for="work_email">Work email</label><input class="form-control" id="work_email" name="work_email" type="email" value="<%= employment?employment.work_email||'':'' %>"></div><div class="form-group"><label for="work_phone">Work phone</label><input class="form-control" id="work_phone" name="work_phone" value="<%= employment?employment.work_phone||'':'' %>"></div><div class="form-group staff-wide"><label for="notes">Administrative notes</label><textarea class="form-control" id="notes" name="notes" rows="2"><%= employment?employment.notes||'':'' %></textarea></div></div><button class="btn btn-primary" type="submit">Save employment information</button></form></section><% } %>
<% } %>
</main></div>
<style>
.staff-back-link{display:inline-block;margin-bottom:10px;color:var(--school-primary);font-weight:600}.staff-info-card{margin-bottom:20px;padding:clamp(16px,3vw,26px)}.staff-info-card h2{margin:0 0 8px;font-size:1.2rem}.staff-info-card h3{font-size:1rem;margin:20px 0 12px}.staff-info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.staff-info-grid .form-group{margin:0;min-width:0}.staff-wide{grid-column:1/-1}.staff-info-form{border-top:1px solid #e2e8f0;margin-top:20px;padding-top:16px}.staff-info-list{display:grid;gap:10px}.staff-info-item{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:12px 0;border-bottom:1px solid #e2e8f0}.staff-info-item p{margin:5px 0 0}.staff-check{display:flex;gap:9px;align-items:center;margin:14px 0}.staff-review{display:flex;gap:8px}@media(max-width:640px){.staff-info-grid{grid-template-columns:1fr}.staff-wide{grid-column:auto}.staff-info-item{align-items:flex-start;flex-direction:column}.staff-review{width:100%}.staff-review .btn{flex:1}}
</style>
<%- include('../partials/footer') %>