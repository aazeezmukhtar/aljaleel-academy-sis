<%- include('../partials/header') %>

    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>

            <main class="main-content">
                <header class="content-header">
                    <div>
                        <h1>Edit Student</h1>
                        <p class="text-muted">Update details for <%= student.first_name %>
                                <%= student.last_name %>
                        </p>
                    </div>
                    <a href="/students/view/<%= student.id %>" class="btn btn-outline">
                        <i class="bi bi-arrow-left"></i> Back to Profile
                    </a>
                </header>

                <div class="card student-edit-card" style="max-width: 800px; margin: 0 auto; padding: 30px;">
                    <form id="editStudentForm" enctype="multipart/form-data" novalidate>
                        <input type="hidden" name="existing_photo" value="<%= student.passport_photo_path %>">

                        <h3 style="margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px;">Personal
                            Information</h3>
                        <div class="form-grid"
                            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                            <div class="form-group">
                                <label for="edit_first_name">First Name</label>
                                <input id="edit_first_name" type="text" name="first_name" class="form-control"
                                    value="<%= student.first_name %>" required placeholder="e.g. John">
                            </div>
                            <div class="form-group">
                                <label for="edit_last_name">Last Name</label>
                                <input id="edit_last_name" type="text" name="last_name" class="form-control"
                                    value="<%= student.last_name %>" required placeholder="e.g. Doe">
                            </div>
                            <div class="form-group">
                                <label for="edit_gender">Gender</label>
                                <select id="edit_gender" name="gender" class="form-control" required>
                                    <option value="Male" <%=student.gender==='Male' ? 'selected' : '' %>>Male</option>
                                    <option value="Female" <%=student.gender==='Female' ? 'selected' : '' %>>Female
                                    </option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="edit_dob">Date of Birth</label>
                                <%
                                  let formattedDob = '';
                                  if (student.dob && String(student.dob).trim() !== '' && String(student.dob) !== 'null') {
                                      const str = String(student.dob).trim();
                                      const match = str.match(/^(\d{4})[-/](\d{1,2})[-/](\d{1,2})/);
                                      if (match) {
                                          formattedDob = `${match[1]}-${match[2].padStart(2, '0')}-${match[3].padStart(2, '0')}`;
                                      } else {
                                          const d = new Date(student.dob);
                                          if (!isNaN(d.getTime())) {
                                              const day = String(d.getUTCDate()).padStart(2, '0');
                                              const month = String(d.getUTCMonth() + 1).padStart(2, '0');
                                              const year = d.getUTCFullYear();
                                              formattedDob = `${year}-${month}-${day}`;
                                          }
                                      }
                                  }
                                %>
                                <input id="edit_dob" type="date" name="dob" class="form-control" value="<%= formattedDob %>">
                            </div>
                        </div>

                        <h3
                            style="margin-top: 30px; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px;">
                            Academic Details</h3>
                        <div class="form-grid"
                            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                            <div class="form-group">
                                <label for="edit_admission_number">Student ID</label>
                                <input id="edit_admission_number" type="text" name="admission_number" class="form-control"
                                    value="<%= student.admission_number %>" placeholder="e.g. ADM/2024/001">
                            </div>
                            <div class="form-group">
                                <label for="edit_status">Status</label>
                                <select id="edit_status" name="status" class="form-control" required>
                                    <option value="active" <%=student.status==='active' ? 'selected' : '' %>>Active</option>
                                    <option value="withdrawn" <%=student.status==='withdrawn' ? 'selected' : '' %>>Withdrawn</option>
                                    <option value="graduated" <%=student.status==='graduated' ? 'selected' : '' %>>Graduated</option>
                                </select>
                            </div>
                        </div>

                        <% if (typeof sections !== 'undefined' && sections && sections.length > 0) { %>
                        <h4 style="margin-top: 24px; margin-bottom: 14px; color: #475569; font-size: 0.95rem; font-weight: 600;">
                            <i class="bi bi-building"></i> Class Assignment by Section
                        </h4>
                        <p style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 16px;">
                            Assign the student to a class in each section. Leave blank to unenroll from that section.
                        </p>
                        <div class="form-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                            <% sections.forEach((sec, idx) => {
                                const sectionClasses = classes.filter(c => c.section_id === sec.id);
                                if (sectionClasses.length === 0) return;
                                const fieldName = `section_${sec.id}_class_id`;
                                const currentEnrolledId = enrolledClassIds.find(cid => sectionClasses.some(sc => sc.id === cid));
                                
                                const theme = (sec.name === 'Academy' || sec.id === 1 || idx === 0)
                                    ? { dot: '#6366f1', bg: '#e0e7ff', text: '#4338ca', border: '#c7d2fe' }
                                    : { dot: '#059669', bg: '#d1fae5', text: '#065f46', border: '#a7f3d0' };
                            %>
                            <div class="form-group" style="background: #f8fafc; padding: 14px; border-radius: 12px; border: 1px solid #e2e8f0;">
                                <label for="edit_<%= fieldName %>" style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                                    <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: <%= theme.dot %>; box-shadow: 0 0 0 3px <%= theme.bg %>;"></span>
                                    <span style="background: <%= theme.bg %>; color: <%= theme.text %>; border: 1px solid <%= theme.border %>; padding: 3px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 700;">
                                        <%= sec.name %> Class
                                    </span>
                                </label>
                                <select id="edit_<%= fieldName %>" name="<%= fieldName %>" class="form-control">
                                    <option value="">— Not Enrolled —</option>
                                    <% sectionClasses.forEach(c => { %>
                                        <option value="<%= c.id %>" <%= currentEnrolledId == c.id ? 'selected' : '' %>><%= c.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <% }); %>
                        </div>
                        <% } else { %>
                        <div class="form-group" style="margin-top: 16px;">
                            <label for="edit_current_class_id">Class</label>
                            <select id="edit_current_class_id" name="current_class_id" class="form-control">
                                <option value="">Select Class</option>
                                <% classes.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= student.current_class_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <% } %>

                        <h3
                            style="margin-top: 30px; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px;">
                            Student Contact Details</h3>
                        <div class="form-grid"
                            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                            <div class="form-group">
                                <label for="edit_phone">Student Phone Number</label>
                                <input id="edit_phone" type="tel" name="phone" class="form-control"
                                    value="<%= student.phone || '' %>" placeholder="e.g. +234 800 000 0000">
                            </div>
                            <div class="form-group">
                                <label for="edit_email">Student Email Address</label>
                                <input id="edit_email" type="email" name="email" class="form-control"
                                    value="<%= student.email || '' %>" placeholder="student@example.com">
                            </div>
                            <div class="form-group" style="grid-column: 1 / -1;">
                                <label for="edit_address">Student Residential Address</label>
                                <textarea id="edit_address" name="address" class="form-control"
                                    placeholder="Residential Address"><%= student.address || '' %></textarea>
                            </div>
                        </div>

                        <h3
                            style="margin-top: 30px; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px;">
                            Parent/Guardian Contact</h3>
                        <div class="form-grid"
                            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                            <div class="form-group">
                                <label for="edit_parent_phone">Parent Phone Number</label>
                                <input id="edit_parent_phone" type="tel" name="parent_phone" class="form-control"
                                    value="<%= student.parent_phone || '' %>" placeholder="e.g. +234 800 000 0000">
                            </div>
                            <div class="form-group">
                                <label for="edit_parent_phone_alt">Parent Alternate Phone</label>
                                <input id="edit_parent_phone_alt" type="tel" name="parent_phone_alt" class="form-control"
                                    value="<%= student.parent_phone_alt || '' %>" placeholder="e.g. +234 800 000 0001">
                            </div>
                            <div class="form-group">
                                <label for="edit_parent_email">Parent Email Address</label>
                                <input id="edit_parent_email" type="email" name="parent_email" class="form-control"
                                    value="<%= student.parent_email || '' %>" placeholder="parent@example.com">
                            </div>
                            <div class="form-group" style="grid-column: 1 / -1;">
                                <label for="edit_parent_address">Parent Address</label>
                                <textarea id="edit_parent_address" name="parent_address" class="form-control"
                                    placeholder="Residential Address"><%= student.parent_address || '' %></textarea>
                            </div>
                        </div>

                        <div class="form-group" style="margin-top: 20px;">
                            <label for="edit_passport">Update Passport Photo</label>
                            <input id="edit_passport" type="file" name="passport" class="form-control" accept="image/*" data-crop="square">
                            <small class="text-muted">You will be able to crop the photo before it is uploaded.</small>
                            <% if (student.passport_photo_path) { %>
                                <div style="margin-top: 10px;">
                                    <img src="<%= student.passport_photo_path %>"
                                        style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;">
                                </div>
                                <% } %>
                        </div>

                        <div id="studentUpdateStatus" class="text-muted" role="status" aria-live="polite" aria-atomic="true" style="margin-top: 18px;"></div>
                        <div class="student-edit-actions" style="margin-top: 24px; display: flex; gap: 15px;">
                            <button type="submit" class="btn btn-primary" style="flex: 1; min-height: 44px;">Update Student
                                Profile</button>
                            <a href="/students" class="btn btn-outline" style="flex: 1; min-height: 44px; display: inline-flex; align-items: center; justify-content: center;">Cancel</a>
                        </div>
                    </form>
                </div>
            </main>
    </div>

    <script>
        document.getElementById('editStudentForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const submitButton = form.querySelector('button[type="submit"]');
            const status = document.getElementById('studentUpdateStatus');
            const originalButtonText = submitButton.textContent.trim();
            if (!form.reportValidity()) return;
            const formData = new FormData(form);
            submitButton.disabled = true;
            submitButton.textContent = 'Saving changes…';
            status.textContent = 'Saving student details. Please wait.';

            try {
                const response = await fetch('/students/update/<%= student.id %>', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json().catch(() => ({}));
                if (response.ok && result.success) {
                    alert('Student updated successfully!');
                    window.location.href = '/students/view/<%= student.id %>';
                } else {
                    status.textContent = result.message || 'The student details could not be updated. Please review the form and try again.';
                }
            } catch (err) {
                console.error(err);
                status.textContent = 'Unable to update the student details. Check your connection and try again.';
            } finally {
                submitButton.disabled = false;
                submitButton.textContent = originalButtonText;
            }
        });
    </script>

    <%- include('../partials/footer') %>