<%- include('../partials/header') %>

<style>
    .student-enroll-page {
        --enroll-border: var(--border-subtle, #e2e8f0);
        --enroll-muted: var(--text-secondary, #475569);
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
    }

    .student-enroll-page *,
    .student-enroll-page *::before,
    .student-enroll-page *::after { box-sizing: border-box; }

    .student-enroll-header { margin-bottom: 22px; }
    .student-enroll-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--primary);
        font-weight: 700;
        margin-bottom: 12px;
        min-height: 40px;
    }
    .student-enroll-header p { color: var(--enroll-muted); margin: 8px 0 0; max-width: 720px; }

    .student-enroll-card { padding: clamp(16px, 3vw, 30px); }
    .student-enroll-form { display: flex; flex-direction: column; gap: 24px; }
    .student-enroll-section { min-width: 0; }
    .student-enroll-section + .student-enroll-section {
        border-top: 1px solid var(--enroll-border);
        padding-top: 22px;
    }
    .student-enroll-section-heading { margin: 0 0 4px; font-size: 1.08rem; }
    .student-enroll-section-help { color: var(--enroll-muted); margin: 0 0 16px; font-size: .9rem; }
    .student-enroll-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }
    .student-enroll-field { min-width: 0; margin: 0; }
    .student-enroll-field--full { grid-column: 1 / -1; }
    .student-enroll-field label {
        display: block;
        margin: 0 0 7px;
        color: var(--text-primary, #0f172a);
        font-size: .9rem;
        font-weight: 700;
    }
    .student-enroll-required { color: var(--danger, #dc2626); }
    .student-enroll-field input,
    .student-enroll-field select {
        display: block;
        width: 100%;
        min-width: 0;
        min-height: 46px;
        padding: 10px 12px;
        border: 1px solid var(--enroll-border);
        border-radius: var(--radius-md, 12px);
        background: var(--bg-surface, #fff);
        color: var(--text-primary, #0f172a);
        font: inherit;
        font-size: 16px;
    }
    .student-enroll-field input:focus-visible,
    .student-enroll-field select:focus-visible,
    .student-enroll-actions a:focus-visible,
    .student-enroll-actions button:focus-visible {
        outline: 3px solid var(--info, #2563eb);
        outline-offset: 2px;
    }
    .student-enroll-field input[type="file"] {
        min-height: auto;
        padding: 10px;
        background: var(--bg-body, #f8fafc);
    }
    .student-enroll-help { display: block; color: var(--enroll-muted); font-size: .82rem; margin-top: 6px; }
    .student-enroll-alert {
        padding: 12px 14px;
        border: 1px solid #fecaca;
        border-left: 4px solid var(--danger, #dc2626);
        border-radius: var(--radius-md, 12px);
        background: #fef2f2;
        color: #991b1b;
        margin-bottom: 18px;
    }
    .student-enroll-section-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
        gap: 14px;
    }
    .student-enroll-section-card {
        min-width: 0;
        padding: 15px;
        border: 1px solid var(--enroll-border);
        border-radius: var(--radius-md, 12px);
        background: var(--bg-body, #f8fafc);
    }
    .student-enroll-section-card label {
        display: block;
        margin: 0 0 9px;
        font-weight: 700;
        color: var(--text-primary, #0f172a);
    }
    .student-enroll-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 4px;
    }
    .student-enroll-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 48px;
        min-width: 190px;
        padding: 12px 20px;
        border: 0;
        border-radius: var(--radius-md, 12px);
        background: var(--primary);
        color: var(--text-on-primary, #fff);
        font: inherit;
        font-weight: 700;
        cursor: pointer;
    }
    .student-enroll-submit:disabled { opacity: .7; cursor: wait; }
    @media (max-width: 640px) {
        .student-enroll-header { margin-bottom: 16px; }
        .student-enroll-grid { grid-template-columns: minmax(0, 1fr); gap: 14px; }
        .student-enroll-card { padding: 16px !important; }
        .student-enroll-actions { flex-direction: column-reverse; align-items: stretch; }
        .student-enroll-submit { width: 100%; }
    }
    @media (prefers-reduced-motion: reduce) {
        .student-enroll-page *, .student-enroll-page *::before, .student-enroll-page *::after {
            scroll-behavior: auto !important;
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
        }
    }
</style>

<div class="dashboard-container">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
        <div class="student-enroll-page">
            <header class="student-enroll-header">
                <a href="/students" class="student-enroll-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Student Directory</a>
                <h1>Enroll New Student</h1>
                <p>Enter the student's details below. You can assign the student to one or more sections; each assignment uses that section's active academic session and term.</p>
            </header>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="student-enroll-alert" role="alert" aria-live="assertive">
                    <strong>Enrollment could not be completed.</strong>
                    <span><%= error %></span>
                    <p class="student-enroll-help">Please review the information and try again. No successful enrollment was recorded.</p>
                </div>
            <% } %>

            <section class="card student-enroll-card" aria-labelledby="studentEnrollFormTitle">
                <h2 id="studentEnrollFormTitle" class="student-enroll-section-heading" style="margin-bottom:20px;">Student information</h2>
                <form id="studentEnrollmentForm" class="student-enroll-form" action="/students/enroll" method="POST" enctype="multipart/form-data">
                    <section class="student-enroll-section" aria-labelledby="personalInfoHeading">
                        <h3 id="personalInfoHeading" class="student-enroll-section-heading">Personal details</h3>
                        <p class="student-enroll-section-help">Fields marked with * are required.</p>
                        <div class="student-enroll-grid">
                            <div class="student-enroll-field">
                                <label for="first_name">First name <span class="student-enroll-required">*</span></label>
                                <input type="text" id="first_name" name="first_name" required maxlength="100" autocomplete="given-name" placeholder="e.g. Amina">
                            </div>
                            <div class="student-enroll-field">
                                <label for="last_name">Last name <span class="student-enroll-required">*</span></label>
                                <input type="text" id="last_name" name="last_name" required maxlength="100" autocomplete="family-name" placeholder="e.g. Bello">
                            </div>
                            <div class="student-enroll-field">
                                <label for="gender">Gender <span class="student-enroll-required">*</span></label>
                                <select id="gender" name="gender" required>
                                    <option value="">Select gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                            <div class="student-enroll-field">
                                <label for="dob">Date of birth <span class="student-enroll-required">*</span></label>
                                <input type="date" id="dob" name="dob" required autocomplete="bday">
                            </div>
                        </div>
                    </section>

                    <section class="student-enroll-section" aria-labelledby="studentContactHeading">
                        <h3 id="studentContactHeading" class="student-enroll-section-heading">Student contact details</h3>
                        <p class="student-enroll-section-help">These details are optional. Leave them blank if the student does not have them.</p>
                        <div class="student-enroll-grid">
                            <div class="student-enroll-field">
                                <label for="phone">Student phone number</label>
                                <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="e.g. +234 800 000 0000">
                            </div>
                            <div class="student-enroll-field">
                                <label for="email">Student email address</label>
                                <input type="email" id="email" name="email" autocomplete="email" placeholder="student@example.com">
                            </div>
                            <div class="student-enroll-field student-enroll-field--full">
                                <label for="address">Student residential address</label>
                                <input type="text" id="address" name="address" autocomplete="street-address" placeholder="Student residential address">
                            </div>
                        </div>
                    </section>

                    <section class="student-enroll-section" aria-labelledby="parentContactHeading">
                        <h3 id="parentContactHeading" class="student-enroll-section-heading">Parent or guardian details</h3>
                        <p class="student-enroll-section-help">Provide at least one reliable contact number where possible.</p>
                        <div class="student-enroll-grid">
                            <div class="student-enroll-field">
                                <label for="parent_phone">Parent phone number</label>
                                <input type="tel" id="parent_phone" name="parent_phone" autocomplete="tel" placeholder="e.g. +234 800 000 0000">
                            </div>
                            <div class="student-enroll-field">
                                <label for="parent_phone_alt">Alternate phone number</label>
                                <input type="tel" id="parent_phone_alt" name="parent_phone_alt" placeholder="e.g. +234 800 000 0001">
                            </div>
                            <div class="student-enroll-field">
                                <label for="parent_email">Parent email address</label>
                                <input type="email" id="parent_email" name="parent_email" autocomplete="email" placeholder="parent@example.com">
                            </div>
                            <div class="student-enroll-field">
                                <label for="parent_address">Parent residential address</label>
                                <input type="text" id="parent_address" name="parent_address" placeholder="Parent residential address">
                            </div>
                        </div>
                    </section>

                    <section class="student-enroll-section" aria-labelledby="studentPhotoHeading">
                        <h3 id="studentPhotoHeading" class="student-enroll-section-heading">Passport photograph</h3>
                        <p class="student-enroll-section-help">Optional. Select a clear, recent photograph. You can crop it before it is uploaded.</p>
                        <div class="student-enroll-field">
                            <label for="passport">Student photograph</label>
                            <input type="file" id="passport" name="passport" accept="image/*" data-crop="square" aria-describedby="passportHelp">
                            <small id="passportHelp" class="student-enroll-help">Image selection and cropping happen before the photograph is sent for upload.</small>
                        </div>
                    </section>

                    <section class="student-enroll-section" aria-labelledby="classAssignmentHeading">
                        <h3 id="classAssignmentHeading" class="student-enroll-section-heading">Class assignment by section</h3>
                        <p class="student-enroll-section-help">Choose a class for each section the student should join. Leave a section unselected if the student is not being enrolled there yet.</p>
                        <% if (typeof sections !== 'undefined' && sections && sections.length > 0) { %>
                            <div class="student-enroll-section-grid">
                                <% sections.forEach((sec) => {
                                    const sectionClasses = classes.filter(c => Number(c.section_id) === Number(sec.id));
                                    if (sectionClasses.length === 0) return;
                                    const fieldName = `section_${sec.id}_class_id`;
                                %>
                                    <div class="student-enroll-section-card">
                                        <label for="<%= fieldName %>"><%= sec.name %> class</label>
                                        <select id="<%= fieldName %>" name="<%= fieldName %>">
                                            <option value="">Not enrolled</option>
                                            <% sectionClasses.forEach(c => { %>
                                                <option value="<%= c.id %>"><%= c.name %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <div class="student-enroll-grid">
                                <div class="student-enroll-field">
                                    <label for="current_class_id">Class</label>
                                    <select id="current_class_id" name="current_class_id">
                                        <option value="">Assign later</option>
                                        <% classes.forEach(cls => { %>
                                            <option value="<%= cls.id %>"><%= cls.name %><%= cls.section_name ? ' (' + cls.section_name + ')' : '' %></option>
                                        <% }); %>
                                    </select>
                                </div>
                            </div>
                        <% } %>
                    </section>

                    <div class="student-enroll-actions">
                        <a href="/students" class="btn btn-outline">Cancel</a>
                        <button type="submit" id="studentEnrollSubmit" class="student-enroll-submit">
                            <i class="bi bi-person-plus" aria-hidden="true"></i>
                            <span>Submit enrollment</span>
                        </button>
                    </div>
                    <p id="studentEnrollStatus" class="student-enroll-help" role="status" aria-live="polite"></p>
                </form>
            </section>
        </div>
    </main>
</div>

<script>
    (() => {
        const form = document.getElementById('studentEnrollmentForm');
        const submitButton = document.getElementById('studentEnrollSubmit');
        const status = document.getElementById('studentEnrollStatus');
        if (!form || !submitButton || !status) return;

        form.addEventListener('submit', (event) => {
            if (!form.checkValidity()) {
                event.preventDefault();
                form.reportValidity();
                return;
            }
            if (submitButton.disabled) {
                event.preventDefault();
                return;
            }
            submitButton.disabled = true;
            submitButton.setAttribute('aria-disabled', 'true');
            submitButton.querySelector('span').textContent = 'Submitting enrollment…';
            status.textContent = 'Please wait while the student record is being saved.';
        });
    })();
</script>

<%- include('../partials/footer') %>
