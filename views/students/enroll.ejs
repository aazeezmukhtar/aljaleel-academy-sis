<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/main.css">
    <style>
        :root {
            --school-primary: #6366f1;
            --school-secondary: #a855f7;
        }

        .form-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: var(--text-dark);
        }

        input,
        select {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: var(--radius);
            outline: none;
            font-size: 1rem;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .btn-submit {
            background: var(--primary);
            color: white;
            border: none;
            padding: 14px 28px;
            border-radius: var(--radius);
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
            width: 100%;
            margin-top: 20px;
        }
    </style>
</head>

<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <!-- Sidebar -->
        <%- include('../partials/sidebar') %>

            <!-- Main Content -->
            <main class="main-content">
                <header style="margin-bottom: 30px;">
                    <a href="/students" style="color: var(--primary); text-decoration: none; font-weight: 600;">&larr;
                        Back
                        to Directory</a>
                    <h1 style="margin-top: 10px;">Enroll New Student</h1>
                    <p class="text-muted">Register a new student for the current academic session.</p>
                    <% if (typeof activeSession !== 'undefined' && activeSession) { %>
                        <div style="margin-top: 8px;">
                            <span class="badge" style="background: #e0e7ff; color: #4338ca; border: 1px solid #c7d2fe; padding: 4px 14px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 6px;">
                                <i class="bi bi-calendar-check"></i> Enrolling for Session: <%= activeSession %>
                            </span>
                        </div>
                    <% } %>
                </header>

                <div class="card form-container">
                    <form action="/students/enroll" method="POST" enctype="multipart/form-data">
                        <div class="grid-2">
                            <div class="form-group">
                                <label for="first_name">First Name *</label>
                                <input type="text" id="first_name" name="first_name" required placeholder="e.g. John">
                            </div>
                            <div class="form-group">
                                <label for="last_name">Last Name *</label>
                                <input type="text" id="last_name" name="last_name" required placeholder="e.g. Doe">
                            </div>
                        </div>

                        <div class="grid-2">
                            <div class="form-group">
                                <label for="gender">Gender *</label>
                                <select id="gender" name="gender" required>
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="dob">Date of Birth *</label>
                                <input type="date" id="dob" name="dob" required>
                            </div>
                        </div>

                        <div class="grid-2">
                            <div class="form-group">
                                <label for="phone">Student Phone Number (Optional)</label>
                                <input type="tel" id="phone" name="phone"
                                    placeholder="e.g. +234 800 000 0000">
                            </div>
                            <div class="form-group">
                                <label for="email">Student Email Address (Optional)</label>
                                <input type="email" id="email" name="email"
                                    placeholder="student@example.com">
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="address">Student Residential Address (Optional)</label>
                            <input type="text" id="address" name="address"
                                placeholder="Student Residential Address">
                        </div>

                        <div class="grid-2">
                            <div class="form-group">
                                <label for="parent_phone">Parent Phone Number (Optional)</label>
                                <input type="tel" id="parent_phone" name="parent_phone"
                                    placeholder="e.g. +234 800 000 0000">
                            </div>
                            <div class="form-group">
                                <label for="parent_phone_alt">Parent Alternate Phone (Optional)</label>
                                <input type="tel" id="parent_phone_alt" name="parent_phone_alt"
                                    placeholder="e.g. +234 800 000 0001">
                            </div>
                        </div>

                        <div class="grid-2">
                            <div class="form-group">
                                <label for="parent_email">Parent Email Address (Optional)</label>
                                <input type="email" id="parent_email" name="parent_email"
                                    placeholder="parent@example.com">
                            </div>
                            <div class="form-group">
                                <label for="parent_address">Parent Address (Optional)</label>
                                <input type="text" id="parent_address" name="parent_address"
                                    placeholder="Parent Residential Address">
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="passport">Passport Photo (Optional)</label>
                            <input type="file" id="passport" name="passport" accept="image/*">
                        </div>



                        <% if (typeof sections !== 'undefined' && sections && sections.length > 0) { %>
                        <h4 style="margin-top: 24px; margin-bottom: 14px; color: #475569; font-size: 0.95rem; font-weight: 600;">
                            <i class="bi bi-building"></i> Class Assignment by Section
                        </h4>
                        <p style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 16px;">
                            Assign the student to a class in each section. Leave blank to skip that section.
                        </p>
                        <div class="form-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 25px;">
                            <% sections.forEach((sec, idx) => {
                                const sectionClasses = classes.filter(c => c.section_id === sec.id);
                                if (sectionClasses.length === 0) return;
                                const fieldName = sec.id === 1 ? 'academy_class_id' : (sec.id === 2 ? 'tahfeez_class_id' : `section_${sec.id}_class_id`);
                                const theme = (sec.name === 'Academy' || sec.id === 1 || idx === 0)
                                    ? { dot: '#6366f1', bg: '#e0e7ff', text: '#4338ca', border: '#c7d2fe' }
                                    : { dot: '#059669', bg: '#d1fae5', text: '#065f46', border: '#a7f3d0' };
                            %>
                            <div class="form-group" style="background: #f8fafc; padding: 14px; border-radius: 12px; border: 1px solid #e2e8f0;">
                                <label style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                                    <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: <%= theme.dot %>; box-shadow: 0 0 0 3px <%= theme.bg %>;"></span>
                                    <span style="background: <%= theme.bg %>; color: <%= theme.text %>; border: 1px solid <%= theme.border %>; padding: 3px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 700;">
                                        <%= sec.name %> Class
                                    </span>
                                </label>
                                <select name="<%= fieldName %>" class="form-control">
                                    <option value="">— Not Enrolled —</option>
                                    <% sectionClasses.forEach(c => { %>
                                        <option value="<%= c.id %>"><%= c.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <% }); %>
                        </div>
                        <% } else { %>
                        <div class="grid-2" style="margin-bottom: 25px;">
                            <div class="form-group">
                                <label for="current_class_id">Class</label>
                                <select id="current_class_id" name="current_class_id" class="form-control">
                                    <option value="">Assign Later</option>
                                    <% classes.forEach(cls=> { %>
                                        <option value="<%= cls.id %>">
                                            <%= cls.name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>
                        </div>
                        <% } %>

                        <button type="submit" class="btn-submit">Submit Enrollment</button>
                    </form>
                </div>
            </main>
    </div>
</body>
</html>