<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <style>
        .offline-profile-card { max-width: 760px; margin: 24px auto; padding: 28px; background: #fff; border-radius: 14px; box-shadow: var(--shadow); }
        .offline-profile-avatar { width: 84px; height: 84px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #e8edf2; color: #334155; font-size: 1.7rem; font-weight: 700; flex-shrink: 0; }
        .offline-profile-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 26px; }
        .offline-profile-field { border-bottom: 1px solid #e5e7eb; padding-bottom: 12px; }
        .offline-profile-field small { display: block; color: #64748b; text-transform: uppercase; font-size: .72rem; font-weight: 700; margin-bottom: 5px; }
        .offline-profile-field strong { color: #0f172a; overflow-wrap: anywhere; }
        @media (max-width: 600px) { .offline-profile-card { padding: 20px; } .offline-profile-grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <%- include('../partials/sidebar') %>
        <main class="main-content">
            <div style="max-width:760px;margin:0 auto 18px;">
                <a href="/students" style="font-weight:600;color:var(--primary);text-decoration:none;">&larr; Back to Student Directory</a>
            </div>
            <section class="offline-profile-card">
                <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;">
                    <div class="offline-profile-avatar">
                        <%= (student.first_name ? student.first_name[0] : '') + (student.last_name ? student.last_name[0] : '') %>
                    </div>
                    <div>
                        <h1 style="margin:0 0 6px;"><%= student.first_name %> <%= student.last_name %></h1>
                        <div style="color:#64748b;font-family:monospace;"><%= student.admission_number || 'Admission Pending' %></div>
                        <span class="badge badge-<%= student.status || 'active' %>" style="margin-top:10px;display:inline-block;"><%= (student.status || 'active').toUpperCase() %></span>
                    </div>
                </div>
                <h2 style="font-size:1.05rem;margin:28px 0 0;">Personal and academic information</h2>
                <div class="offline-profile-grid">
                    <div class="offline-profile-field"><small>Gender</small><strong><%= student.gender || 'Not recorded' %></strong></div>
                    <div class="offline-profile-field"><small>Date of Birth</small><strong><%
                        let formattedDob = 'Not provided';
                        if (student.dob) {
                            const rawDob = String(student.dob).trim();
                            const dobMatch = rawDob.match(/^(\d{4})[-/](\d{1,2})[-/](\d{1,2})/);
                            if (dobMatch) formattedDob = dobMatch[3].padStart(2, '0') + '/' + dobMatch[2].padStart(2, '0') + '/' + dobMatch[1];
                            else {
                                const parsedDob = new Date(student.dob);
                                if (!isNaN(parsedDob.getTime())) formattedDob = String(parsedDob.getUTCDate()).padStart(2, '0') + '/' + String(parsedDob.getUTCMonth() + 1).padStart(2, '0') + '/' + parsedDob.getUTCFullYear();
                            }
                        }
                    %><%= formattedDob %></strong></div>
                    <div class="offline-profile-field"><small>Class</small><strong><%= student.class_name || 'Not enrolled' %></strong></div>
                    <div class="offline-profile-field"><small>Student ID</small><strong><%= student.id %></strong></div>
                </div>
                <h2 style="font-size:1.05rem;margin:28px 0 0;">Student contact</h2>
                <div class="offline-profile-grid">
                    <div class="offline-profile-field"><small>Phone</small><strong><%= student.phone || 'Not provided' %></strong></div>
                    <div class="offline-profile-field"><small>Email</small><strong><%= student.email || 'Not provided' %></strong></div>
                    <div class="offline-profile-field"><small>Residential address</small><strong><%= student.address || 'Not provided' %></strong></div>
                </div>
                <h2 style="font-size:1.05rem;margin:28px 0 0;">Parent / guardian contact</h2>
                <div class="offline-profile-grid">
                    <div class="offline-profile-field"><small>Primary phone</small><strong><%= student.parent_phone || 'Not provided' %></strong></div>
                    <div class="offline-profile-field"><small>Alternate phone</small><strong><%= student.parent_phone_alt || 'Not provided' %></strong></div>
                    <div class="offline-profile-field"><small>Email</small><strong><%= student.parent_email || 'Not provided' %></strong></div>
                    <div class="offline-profile-field"><small>Home address</small><strong><%= student.parent_address || 'Not provided' %></strong></div>
                </div>
                <p style="margin:24px 0 0;color:#64748b;font-size:.88rem;">This profile is read-only offline. It includes personal and family contact information. Keep this device's access restricted and sign out when finished. Health records, financial information and academic history are not included.</p>
            </section>
        </main>
    </div>
</body>
</html>
