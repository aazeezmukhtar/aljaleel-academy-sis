<%- include('../partials/header') %>
<div class="dashboard-container">
    <%- include('../partials/sidebar') %>
    <main class="main-content" data-acadme-offline-profile="true">
        <header class="content-header">
            <a href="/students" class="btn btn-outline">← Back to Student Directory</a>
            <p class="text-muted" style="margin-top:12px;">Limited offline student profile</p>
        </header>

        <section class="card offline-student-profile" aria-labelledby="offlineStudentName">
            <div class="offline-student-heading">
                <% if (student.passport_photo_path) { %>
                    <img src="<%= student.passport_photo_path %>" alt="Photo of <%= student.first_name %> <%= student.last_name %>" class="offline-student-photo">
                <% } else { %>
                    <div class="offline-student-photo offline-student-initials" aria-hidden="true">
                        <%= (student.first_name || '').charAt(0) %><%= (student.last_name || '').charAt(0) %>
                    </div>
                <% } %>
                <div>
                    <h1 id="offlineStudentName"><%= student.first_name %> <%= student.last_name %></h1>
                    <p><strong>Admission number:</strong> <%= student.admission_number || 'Pending' %></p>
                </div>
            </div>

            <div class="offline-student-grid">
                <div><strong>Gender</strong><span><%= student.gender || 'Not recorded' %></span></div>
                <div><strong>Date of birth</strong><span><%= student.dob || 'Not recorded' %></span></div>
                <div><strong>Current class / section</strong>
                    <span>
                        <% if (classAssignments && classAssignments.length) { %>
                            <% classAssignments.forEach((item, index) => { %>
                                <span class="offline-class-chip"><%= item.class_name %><%= item.section_name ? ' · ' + item.section_name : '' %></span>
                            <% }); %>
                        <% } else { %>Not enrolled<% } %>
                    </span>
                </div>
                <div><strong>Student phone</strong>
                    <span><% if (student.phone) { %><a href="tel:<%= student.phone %>"><%= student.phone %></a><% } else { %>Not provided<% } %></span>
                </div>
                <div><strong>Parent / guardian primary phone</strong>
                    <span><% if (student.parent_phone) { %><a href="tel:<%= student.parent_phone %>"><%= student.parent_phone %></a><% } else { %>Not provided<% } %></span>
                </div>
                <div><strong>Parent / guardian alternate phone</strong>
                    <span><% if (student.parent_phone_alt) { %><a href="tel:<%= student.parent_phone_alt %>"><%= student.parent_phone_alt %></a><% } else { %>Not provided<% } %></span>
                </div>
            </div>
            <p class="offline-profile-limit">This offline copy excludes financial information, health records, residential addresses and academic results.</p>
        </section>
    </main>
</div>
<style>
.offline-student-profile { max-width: 900px; margin: 20px auto; }
.offline-student-heading { display:flex; align-items:center; gap:18px; margin-bottom:26px; min-width:0; }
.offline-student-heading h1 { overflow-wrap:anywhere; margin:0 0 6px; }
.offline-student-heading p { margin:0; color:var(--text-muted); }
.offline-student-photo { width:96px; height:96px; flex:0 0 96px; object-fit:cover; border-radius:16px; }
.offline-student-initials { display:flex; align-items:center; justify-content:center; background:#e2e8f0; color:#334155; font-size:1.8rem; font-weight:700; }
.offline-student-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
.offline-student-grid > div { min-width:0; padding:12px 0; border-bottom:1px solid #e2e8f0; }
.offline-student-grid strong { display:block; color:var(--text-muted); font-size:.78rem; text-transform:uppercase; margin-bottom:5px; }
.offline-student-grid span { overflow-wrap:anywhere; }
.offline-class-chip { display:inline-block; margin:2px 4px 2px 0; padding:4px 8px; border-radius:6px; background:#eff6ff; }
.offline-profile-limit { margin-top:22px; padding:12px; background:#f8fafc; border-radius:8px; color:#475569; font-size:.88rem; }
@media(max-width:640px) {
 .offline-student-heading { align-items:flex-start; gap:12px; }
 .offline-student-photo { width:72px; height:72px; flex-basis:72px; }
 .offline-student-grid { grid-template-columns:minmax(0,1fr); gap:8px; }
}
</style>
<%- include('../partials/footer') %>
