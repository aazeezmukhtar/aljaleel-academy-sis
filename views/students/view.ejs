<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/main.css">
    <style>
        :root {
            --school-primary: #6366f1;
            --school-secondary: #a855f7;
        }

        .profile-header {
            background: white;
            padding: 40px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 30px;
            margin-bottom: 30px;
        }

        .avatar-placeholder {
            width: 120px;
            height: 120px;
            background: #f0f2f5;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: #bdc3c7;
            text-transform: uppercase;
        }

        .profile-info h1 {
            margin: 0;
            font-size: 2rem;
        }

        .profile-info p {
            margin: 5px 0 0;
            color: var(--text-muted);
        }

        .detail-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
        }

        .detail-item {
            padding-bottom: 12px;
            border-bottom: 1px solid #eee;
        }

        .detail-item strong {
            display: block;
            font-size: 0.85rem;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-bottom: 4px;
        }
    </style>
</head>

<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <!-- Sidebar -->
        <%- include('../partials/sidebar') %>

            <!-- Main Content -->
            <main class="main-content">
                <header style="margin-bottom: 30px;">
                    <a href="/students" style="color: var(--primary); text-decoration: none; font-weight: 600;">&larr;
                        Back
                        to Directory</a>
                </header>

                <% if (typeof success !=='undefined' && success) { %>
                    <div class="alert alert-success"
                        style="margin-bottom: 20px; padding: 12px; border-radius: 8px; background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0;">
                        <i class="bi bi-check-circle-fill"></i>
                        <%= success %>
                    </div>
                    <% } %>

                        <% if (typeof error !=='undefined' && error) { %>
                            <div class="alert alert-danger"
                                style="margin-bottom: 20px; padding: 12px; border-radius: 8px; background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca;">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <%= error %>
                            </div>
                            <% } %>

                                <div class="profile-header">
                                    <% if (student.passport_photo_path) { %>
                                        <img src="<%= student.passport_photo_path %>" alt="Student Photo"
                                            style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 4px solid white; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
                                    <% } else { %>
                                        <div class="avatar-placeholder" style="width: 120px; height: 120px; border-radius: 50%; background: linear-gradient(135deg, #6b73ff 0%, #000dff 100%); color: white; display: flex; align-items: center; justify-content: center; font-weight: 600; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
                                            <%= (student.first_name ? student.first_name[0] : '') + (student.last_name ? student.last_name[0] : '') %>
                                        </div>
                                    <% } %>
                                                <div class="profile-info" style="flex-grow: 1;">
                                                    <h1>
                                                        <%= student.first_name %> <%= student.last_name %>
                                                    </h1>
                                                    <p>
                                                        <%= student.admission_number || 'Admission Pending' %>
                                                    </p>
                                                    <div style="margin-top: 15px;">
                                                        <span class="badge badge-<%= student.status %>">
                                                            <%= student.status ? student.status.toUpperCase() : 'ACTIVE' %>
                                                        </span>
                                                    </div>
                                                </div>
                                                <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-start;">
                                                    <a href="/students/edit/<%= student.id %>" class="btn btn-primary">
                                                        <i class="bi bi-pencil-square"></i> Edit Profile
                                                    </a>
                                                    <% if (typeof user !== 'undefined' && user && user.role === 'Admin') { %>
                                                        <button onclick="openPromoteModal()" class="btn btn-outline"
                                                            style="border-color: #10b981; color: #047857; font-weight: 600;">
                                                            <i class="bi bi-arrow-up-right-circle"></i> Promote Student
                                                        </button>
                                                        <button onclick="resetPassword('<%= student.id %>')" class="btn btn-outline"
                                                            style="border-color: var(--school-secondary); color: var(--school-secondary);">
                                                            <i class="bi bi-shield-lock"></i> Reset Password
                                                        </button>
                                                        <button onclick="deleteStudent('<%= student.id %>')" class="btn btn-danger"
                                                            style="background: #ef4444; color: white;">
                                                            <i class="bi bi-trash"></i> Delete
                                                        </button>
                                                    <% } %>
                                                </div>
                                </div>

                                <script>
                                     async function resetPassword(id) {
                                         if (!confirm('Are you sure you want to reset this student\'s password to default?')) return;

                                         try {
                                             const response = await fetch(`/students/reset-password/${id}`, { method: 'POST' });
                                             const result = await response.json();

                                             if (result.success) {
                                                 alert(result.message);
                                             } else {
                                                 alert('Error: ' + result.message);
                                             }
                                         } catch (err) {
                                             console.error(err);
                                             alert('Network error occurred.');
                                         }
                                     }

                                     async function deleteStudent(id) {
                                         if (!confirm('Are you sure you want to PERMANENTLY delete this student?')) return;

                                         try {
                                             const response = await fetch(`/students/delete/${id}`, { method: 'POST' });
                                             const result = await response.json();

                                             if (result.success) {
                                                 alert(result.message);
                                                 window.location.href = '/students';
                                             } else {
                                                 alert('Error: ' + result.message);
                                             }
                                         } catch (err) {
                                             console.error(err);
                                             alert('Network error occurred.');
                                         }
                                     }
                                 </script>
                                <div class="grid-2" style="margin-top: 30px;">
                                    <div class="card">
                                        <h3>Personal &amp; Academic</h3>
                                        <div class="detail-grid" style="margin-top: 20px;">
                                            <div class="detail-item">
                                                <strong>Gender</strong>
                                                <span>
                                                    <%= student.gender %>
                                                </span>
                                            </div>
                                            <div class="detail-item">
                                                <strong>Date of Birth</strong>
                                                <span>
                                                    <% 
                                                        let formattedDob = 'Not Set';
                                                        if (student.dob && String(student.dob).trim() !== '' && String(student.dob) !== 'null') {
                                                            const str = String(student.dob).trim();
                                                            const match = str.match(/^(\d{4})[-/](\d{1,2})[-/](\d{1,2})/);
                                                            if (match) {
                                                                formattedDob = `${match[3].padStart(2, '0')}/${match[2].padStart(2, '0')}/${match[1]}`;
                                                            } else {
                                                                const d = new Date(student.dob);
                                                                if (!isNaN(d.getTime())) {
                                                                    const day = String(d.getUTCDate()).padStart(2, '0');
                                                                    const month = String(d.getUTCMonth() + 1).padStart(2, '0');
                                                                    const year = d.getUTCFullYear();
                                                                    formattedDob = `${day}/${month}/${year}`;
                                                                }
                                                            }
                                                        }
                                                    %>
                                                    <%= formattedDob %>
                                                </span>
                                            </div>
                                            <div class="detail-item">
                                                <strong>Class</strong>
                                                <span>
                                                    <%= student.class_name %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card">
                                        <h3>Student Contact</h3>
                                        <div class="detail-grid" style="margin-top: 20px;">
                                            <div class="detail-item">
                                                <strong>Phone Number</strong>
                                                <span>
                                                    <%= student.phone || 'Not Provided' %>
                                                </span>
                                            </div>
                                            <div class="detail-item">
                                                <strong>Email Address</strong>
                                                <span>
                                                    <%= student.email || 'Not Provided' %>
                                                </span>
                                            </div>
                                            <div class="detail-item" style="grid-column: span 2;">
                                                <strong>Residential Address</strong>
                                                <span>
                                                    <%= student.address || 'Not Provided' %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="grid-2" style="margin-top: 30px;">
                                    <div class="card">
                                        <h3>Parent / Guardian Contact</h3>
                                        <div class="detail-grid" style="margin-top: 20px;">
                                            <div class="detail-item">
                                                <strong>Primary Phone</strong>
                                                <span>
                                                    <%= student.parent_phone || 'Not Provided' %>
                                                </span>
                                            </div>
                                            <div class="detail-item">
                                                <strong>Alternate Phone</strong>
                                                <span>
                                                    <%= student.parent_phone_alt || 'Not Provided' %>
                                                </span>
                                            </div>
                                            <div class="detail-item">
                                                <strong>Email Address</strong>
                                                <span>
                                                    <%= student.parent_email || 'Not Provided' %>
                                                </span>
                                            </div>
                                            <div class="detail-item">
                                                <strong>Home Address</strong>
                                                <span>
                                                    <%= student.parent_address || 'Not Provided' %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                <div class="grid-2" style="margin-top: 30px;">
                                    <div class="card">
                                        <div
                                            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                                            <h3 style="margin: 0;">Financial Summary</h3>
                                            <a href="/fees/student/<%= student.id %>"
                                                class="btn btn-sm btn-outline">View History</a>
                                        </div>
                                        <div class="detail-grid">
                                            <div class="detail-item">
                                                <strong>Total Fees</strong>
                                                <span style="font-weight: bold;">₦<%= fees.total_owed.toLocaleString()
                                                        %></span>
                                            </div>
                                            <div class="detail-item">
                                                <strong>Total Paid</strong>
                                                <span style="color: #15803d; font-weight: bold;">₦<%=
                                                        fees.total_paid.toLocaleString() %></span>
                                            </div>
                                            <div class="detail-item">
                                                <% const balance=fees.total_owed - fees.total_paid; %>
                                                    <strong>Outstanding</strong>
                                                    <span
                                                        style="color: <%= balance > 0 ? '#b91c1c' : '#15803d' %>; font-weight: bold;">
                                                        ₦<%= balance.toLocaleString() %>
                                                    </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card">
                                        <div
                                            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                                            <h3 style="margin: 0;">Health & Wellness</h3>
                                            <button class="btn btn-sm btn-outline" onclick="openHealthModal()">Update
                                                Record</button>
                                        </div>
                                        <div class="detail-grid">
                                            <div class="detail-item">
                                                <strong>Blood Group</strong>
                                                <span>
                                                    <%= health.blood_group || 'Not Specified' %>
                                                </span>
                                            </div>
                                            <div class="detail-item">
                                                <strong>Genotype</strong>
                                                <span>
                                                    <%= health.genotype || 'Not Specified' %>
                                                </span>
                                            </div>
                                            <div class="detail-item">
                                                <strong>Allergies</strong>
                                                <span class="text-muted">
                                                    <%= health.allergies || 'None Recorded' %>
                                                </span>
                                            </div>
                                            <div class="detail-item">
                                                <strong>Conditions</strong>
                                                <span class="text-muted">
                                                    <%= health.medical_conditions || 'None Recorded' %>
                                                </span>
                                            </div>
                                        </div>
                                        <div style="margin-top: 15px; padding-top: 15px; border-top: 1px dashed #eee;">
                                            <p style="font-size: 0.8rem; margin: 0;"><strong>Emergency:</strong>
                                                <%= health.emergency_contact_name || 'N/A' %> (<%=
                                                        health.emergency_contact_phone || 'N/A' %>)
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="grid-2" style="margin-top: 30px;">
                                    <div class="card" style="grid-column: 1 / -1;">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                                            <h3 style="margin: 0;">Academic Records</h3>
                                        </div>
                                        
                                        <% if (typeof academicTerms !== 'undefined' && academicTerms.length > 0) { %>
                                            <div style="display: flex; flex-direction: column; gap: 15px;">
                                                <% 
                                                const sessions = [...new Set(academicTerms.map(t => t.session))];
                                                sessions.forEach(sess => { 
                                                %>
                                                <div style="border: 1px solid #eee; padding: 15px; border-radius: 8px; background: #fafafa;">
                                                    <h4 style="margin: 0 0 10px 0; color: var(--text-dark);"><%= sess %> Session</h4>
                                                    <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                                                        <% academicTerms.filter(t => t.session === sess).forEach(term => { %>
                                                            <a href="/results/report/<%= student.id %>?term=<%= term.term %>&session=<%= encodeURIComponent(sess) %>" class="btn btn-sm btn-outline" target="_blank">
                                                                <i class="bi bi-file-earmark-text"></i> <%= term.term %>
                                                            </a>
                                                        <% }) %>
                                                        <a href="/results/cumulative/<%= student.id %>?session=<%= encodeURIComponent(sess) %>" class="btn btn-sm" style="background: var(--primary); color: white;" target="_blank">
                                                            <i class="bi bi-file-earmark-bar-graph"></i> Cumulative Report
                                                        </a>
                                                    </div>
                                                </div>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <div class="text-muted" style="padding: 20px; background: #f9fafb; border-radius: 8px; text-align: center;">
                                                <i class="bi bi-folder-x" style="font-size: 2rem; color: #cbd5e1; display: block; margin-bottom: 10px;"></i>
                                                No academic results published for this student yet.
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Health Modal -->
                                <div id="healthModal" class="modal"
                                    style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
                                    <div class="card" style="width: 500px; max-height: 90vh; overflow-y: auto;">
                                        <h3>Update Health Record</h3>
                                        <form action="/students/health" method="POST" style="margin-top: 20px;">
                                            <input type="hidden" name="student_id" value="<%= student.id %>">
                                            <div class="grid-2">
                                                <div class="form-group">
                                                    <label>Blood Group</label>
                                                    <select name="blood_group" class="form-control">
                                                        <option value="">-- Select --</option>
                                                        <% ['A+', 'A-' , 'B+' , 'B-' , 'AB+' , 'AB-' , 'O+' , 'O-'
                                                            ].forEach(bg=> { %>
                                                            <option value="<%= bg %>" <%=health.blood_group===bg
                                                                ? 'selected' : '' %>>
                                                                <%= bg %>
                                                            </option>
                                                            <% }) %>
                                                    </select>
                                                </div>
                                                <div class="form-group">
                                                    <label>Genotype</label>
                                                    <select name="genotype" class="form-control">
                                                        <option value="">-- Select --</option>
                                                        <% ['AA', 'AS' , 'AC' , 'SS' , 'SC' ].forEach(gt=> { %>
                                                            <option value="<%= gt %>" <%=health.genotype===gt
                                                                ? 'selected' : '' %>><%= gt %>
                                                            </option>
                                                            <% }) %>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label>Allergies</label>
                                                <textarea name="allergies" class="form-control"
                                                    rows="2"><%= health.allergies %></textarea>
                                            </div>
                                            <div class="form-group">
                                                <label>Medical Conditions</label>
                                                <textarea name="medical_conditions" class="form-control"
                                                    rows="2"><%= health.medical_conditions %></textarea>
                                            </div>
                                            <hr style="margin: 20px 0;">
                                            <div class="grid-2">
                                                <div class="form-group">
                                                    <label>Emergency Name</label>
                                                    <input type="text" name="emergency_contact_name"
                                                        class="form-control"
                                                        value="<%= health.emergency_contact_name %>">
                                                </div>
                                                <div class="form-group">
                                                    <label>Emergency Phone</label>
                                                    <input type="text" name="emergency_contact_phone"
                                                        class="form-control"
                                                        value="<%= health.emergency_contact_phone %>">
                                                </div>
                                            </div>
                                            <div style="display: flex; gap: 10px; margin-top: 30px;">
                                                <button type="submit" class="btn btn-primary" style="flex: 1;">Save
                                                    Changes</button>
                                                <button type="button" class="btn btn-outline" style="flex: 1;"
                                                    onclick="closeHealthModal()">Cancel</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                                <!-- Promotion Modal -->
                                <% if (typeof user !== 'undefined' && user && user.role === 'Admin') { %>
                                <div id="promoteModal" class="modal"
                                    style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
                                    <div class="card" style="width: 580px; max-width: 95vw; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">
                                            <h3 style="margin: 0; display: flex; align-items: center; gap: 8px;">
                                                <i class="bi bi-arrow-up-right-circle" style="color: #10b981;"></i> Promote Student
                                            </h3>
                                            <button type="button" onclick="closePromoteModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #64748b;">&times;</button>
                                        </div>

                                        <div id="promoteAlertBox" style="display: none; margin-bottom: 15px; padding: 12px; border-radius: 8px; font-size: 0.9rem;"></div>

                                        <p style="margin-top: 0; color: #64748b; font-size: 0.9rem;">
                                            Promote <strong><%= student.first_name %> <%= student.last_name %></strong> to the next class while maintaining section affinity. Dual-class assignments in other sections will remain unaffected.
                                        </p>

                                        <form id="promoteForm" onsubmit="handlePromoteSubmit(event)" style="margin-top: 15px;">
                                            <div class="form-group" style="margin-bottom: 15px;">
                                                <label style="font-weight: 600; display: block; margin-bottom: 6px;">Current Section & Class to Promote</label>
                                                <select id="promoteSourceClass" class="form-control" onchange="onSourceClassChange()" required>
                                                    <option value="">-- Select Current Class --</option>
                                                    <% if (typeof studentEnrollments !== 'undefined' && studentEnrollments.length > 0) { %>
                                                        <% studentEnrollments.forEach(enr => { %>
                                                            <option value="<%= enr.class_id %>" 
                                                                data-section-id="<%= enr.section_id %>"
                                                                data-section-name="<%= enr.section_name %>"
                                                                data-session="<%= enr.session %>">
                                                                [<%= enr.section_name %>] <%= enr.class_name %> (<%= enr.session %>)
                                                            </option>
                                                        <% }) %>
                                                    <% } %>
                                                </select>
                                            </div>

                                            <div class="grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
                                                <div class="form-group">
                                                    <label style="font-weight: 600; display: block; margin-bottom: 6px;">Source Session</label>
                                                    <select id="promoteSourceSession" class="form-control" onchange="onSourceSessionChange()" required>
                                                        <% if (typeof available_sessions !== 'undefined') { %>
                                                            <% available_sessions.forEach(sess => { %>
                                                                <option value="<%= sess %>"><%= sess %></option>
                                                            <% }) %>
                                                        <% } %>
                                                    </select>
                                                </div>
                                                <div class="form-group">
                                                    <label style="font-weight: 600; display: block; margin-bottom: 6px;">Destination Session</label>
                                                    <select id="promoteTargetSession" class="form-control" required>
                                                        <% if (typeof available_sessions !== 'undefined') { %>
                                                            <% available_sessions.forEach(sess => { %>
                                                                <option value="<%= sess %>"><%= sess %></option>
                                                            <% }) %>
                                                        <% } %>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="form-group" style="margin-bottom: 20px;">
                                                <label style="font-weight: 600; display: block; margin-bottom: 6px;">Target Destination Class</label>
                                                <select id="promoteTargetClass" class="form-control" required>
                                                    <option value="">-- Select Source Class First --</option>
                                                </select>
                                                <small id="sectionNotice" style="display: block; margin-top: 5px; color: #059669; font-size: 0.82rem;">
                                                    <i class="bi bi-shield-check"></i> Section affinity active: Only classes in the same section will be offered.
                                                </small>
                                            </div>

                                            <div style="display: flex; gap: 10px; margin-top: 25px;">
                                                <button type="submit" id="promoteSubmitBtn" class="btn btn-primary" style="flex: 1; background: #10b981; border-color: #10b981;">
                                                    <i class="bi bi-check-lg"></i> Confirm Promotion
                                                </button>
                                                <button type="button" class="btn btn-outline" style="flex: 1;" onclick="closePromoteModal()">Cancel</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                                <!-- Embedded class data for Section Affinity filtering -->
                                <script>
                                    const allClassesList = <%- JSON.stringify(typeof classes !== 'undefined' ? classes : []) %>;

                                    function openPromoteModal() {
                                        const modal = document.getElementById('promoteModal');
                                        modal.style.display = 'flex';
                                        const alertBox = document.getElementById('promoteAlertBox');
                                        alertBox.style.display = 'none';

                                        const srcSelect = document.getElementById('promoteSourceClass');
                                        if (srcSelect && srcSelect.options.length > 1) {
                                            srcSelect.selectedIndex = 1;
                                            onSourceClassChange();
                                        }
                                    }

                                    function closePromoteModal() {
                                        document.getElementById('promoteModal').style.display = 'none';
                                    }

                                    function onSourceClassChange() {
                                        const srcSelect = document.getElementById('promoteSourceClass');
                                        const selectedOpt = srcSelect.options[srcSelect.selectedIndex];
                                        const targetSelect = document.getElementById('promoteTargetClass');

                                        if (!selectedOpt || !selectedOpt.value) {
                                            targetSelect.innerHTML = '<option value="">-- Select Source Class First --</option>';
                                            return;
                                        }

                                        const sectionId = parseInt(selectedOpt.getAttribute('data-section-id'));
                                        const sessionVal = selectedOpt.getAttribute('data-session');

                                        if (sessionVal) {
                                            const srcSessSelect = document.getElementById('promoteSourceSession');
                                            for (let i = 0; i < srcSessSelect.options.length; i++) {
                                                if (srcSessSelect.options[i].value === sessionVal) {
                                                    srcSessSelect.selectedIndex = i;
                                                    break;
                                                }
                                            }
                                            onSourceSessionChange();
                                        }

                                        // Filter classes by section_id strictly
                                        targetSelect.innerHTML = '<option value="">-- Select Destination Class --</option>';
                                        const filtered = allClassesList.filter(c => c.section_id === sectionId);

                                        filtered.forEach(cls => {
                                            const opt = document.createElement('option');
                                            opt.value = cls.id;
                                            opt.textContent = cls.name + (cls.id == selectedOpt.value ? ' (Repeat / Same)' : '');
                                            targetSelect.appendChild(opt);
                                        });

                                        // Add graduation option
                                        const gradOpt = document.createElement('option');
                                        gradOpt.value = 'graduate';
                                        gradOpt.textContent = '🎓 Graduate Student (Complete School)';
                                        gradOpt.style.fontWeight = 'bold';
                                        gradOpt.style.color = '#7c3aed';
                                        targetSelect.appendChild(gradOpt);
                                    }

                                    function onSourceSessionChange() {
                                        const srcSess = document.getElementById('promoteSourceSession').value;
                                        const targetSessSelect = document.getElementById('promoteTargetSession');
                                        const parts = srcSess.split('/');
                                        if (parts.length === 2) {
                                            const nextSess = `${parseInt(parts[0]) + 1}/${parseInt(parts[1]) + 1}`;
                                            let found = false;
                                            for (let i = 0; i < targetSessSelect.options.length; i++) {
                                                if (targetSessSelect.options[i].value === nextSess) {
                                                    targetSessSelect.selectedIndex = i;
                                                    found = true;
                                                    break;
                                                }
                                            }
                                            if (!found) {
                                                const opt = document.createElement('option');
                                                opt.value = nextSess;
                                                opt.textContent = nextSess;
                                                targetSessSelect.insertBefore(opt, targetSessSelect.firstChild);
                                                targetSessSelect.selectedIndex = 0;
                                            }
                                        }
                                    }

                                    async function handlePromoteSubmit(e) {
                                        e.preventDefault();
                                        const btn = document.getElementById('promoteSubmitBtn');
                                        const alertBox = document.getElementById('promoteAlertBox');
                                        alertBox.style.display = 'none';

                                        const source_class_id = document.getElementById('promoteSourceClass').value;
                                        const target_class_id = document.getElementById('promoteTargetClass').value;
                                        const source_session = document.getElementById('promoteSourceSession').value;
                                        const target_session = document.getElementById('promoteTargetSession').value;

                                        if (!source_class_id || !target_class_id) {
                                            alertBox.style.display = 'block';
                                            alertBox.style.background = '#fee2e2';
                                            alertBox.style.color = '#b91c1c';
                                            alertBox.textContent = 'Please choose both current class and target destination class.';
                                            return;
                                        }

                                        if (!confirm(`Are you sure you want to promote this student from ${source_session} to ${target_session}?`)) {
                                            return;
                                        }

                                        btn.disabled = true;
                                        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Processing...';

                                        try {
                                            const res = await fetch('/students/promote/<%= student.id %>', {
                                                method: 'POST',
                                                headers: { 'Content-Type': 'application/json' },
                                                body: JSON.stringify({
                                                    source_class_id,
                                                    target_class_id,
                                                    source_session,
                                                    target_session
                                                })
                                            });

                                            const result = await res.json();
                                            if (result.success) {
                                                alertBox.style.display = 'block';
                                                alertBox.style.background = '#dcfce7';
                                                alertBox.style.color = '#15803d';
                                                alertBox.innerHTML = '<i class="bi bi-check-circle-fill"></i> ' + result.message;
                                                setTimeout(() => {
                                                    window.location.reload();
                                                }, 1200);
                                            } else {
                                                alertBox.style.display = 'block';
                                                alertBox.style.background = '#fee2e2';
                                                alertBox.style.color = '#b91c1c';
                                                alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> ' + (result.message || 'Promotion failed.');
                                                btn.disabled = false;
                                                btn.innerHTML = '<i class="bi bi-check-lg"></i> Confirm Promotion';
                                            }
                                        } catch (err) {
                                            console.error(err);
                                            alertBox.style.display = 'block';
                                            alertBox.style.background = '#fee2e2';
                                            alertBox.style.color = '#b91c1c';
                                            alertBox.textContent = 'Network or server error during promotion.';
                                            btn.disabled = false;
                                            btn.innerHTML = '<i class="bi bi-check-lg"></i> Confirm Promotion';
                                        }
                                    }
                                </script>
                                <% } %>

                                <script>
                                    function openHealthModal() { document.getElementById('healthModal').style.display = 'flex'; }
                                    function closeHealthModal() { document.getElementById('healthModal').style.display = 'none'; }

                                    async function resetStudentPassword(studentId) {
                                        if (!confirm('Reset this student\'s password to their admission number?')) return;
                                        try {
                                            const res = await fetch('/students/reset-password/' + studentId, { method: 'POST' });
                                            const data = await res.json();
                                            if (data.success) {
                                                alert(data.message);
                                            } else {
                                                alert('Error: ' + data.message);
                                            }
                                        } catch (err) {
                                            console.error(err);
                                            alert('Failed to reset password.');
                                        }
                                    }
                                </script>
    </div>

    </main>
    </div>
</body>

</html>